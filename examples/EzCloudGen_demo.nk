 l3_swirl_size 400
 addUserKnob {7 l3_turbulence l turbulence t "A finer, second swirl (a third the size) that makes the edges roll and churn; animate 'evolve' to boil it."}
 addUserKnob {7 l3_crumble l crumble t "Bites chunks out of the thin edges, for torn, ragged cloud and fog."}
 addUserKnob {7 l3_crumble_size l "crumble size" t "Size of the chunks crumble bites out, in metres." R 5 1000}
 l3_crumble_size 120
