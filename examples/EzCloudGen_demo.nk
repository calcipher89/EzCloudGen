  EzCloudGen_quality {{parent.quality}}
  EzCloudGen_samples {{parent.samples}}
  EzCloudGen_seed {{"parent.seed + parent.l2_seed"}}
  EzCloudGen_evolve {{"parent.evolve_speed * parent.time_s"}}
  EzCloudGen_offset {{"-parent.l2_wind_speed * parent.time_s * sin(radians(parent.l2_wind_deg))"} {"parent.l2_wind_speed * parent.time_s * cos(radians(parent.l2_wind_deg))"}}
