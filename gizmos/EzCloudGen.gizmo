  recompileCount 2
  KernelDescription "3 \"EzCloudGenStack\" iterate pixelWise e0e1799bfef0118ab22ce82517a89ce5c6d941ccf202c659b03e25a973f820a8 7 \"c1\" Read Point \"c2\" Read Point \"c3\" Read Point \"z1\" Read Point \"z2\" Read Point \"z3\" Read Point \"dst\" Write Point 0 0 0"
  kernelSource "// EzCloudGenStack: puts up to three cloud layers over each other nearest first, per pixel.\n//\n// c1..c3 are premultiplied images of the layers (colour, sun share, or Planar Z times alpha).\n// z1..z3 are the layers' depth passes (rgb = Planar Z, a = opacity), only used to order them:\n// a layer with no opacity at a pixel counts as furthest. The result is c_near over c_mid over\n// c_far, so placed volumes and decks sort themselves out wherever they are. Where two layers\n// are at about the same depth the order fades from one to the other (see process).\n\nkernel EzCloudGenStack : ImageComputationKernel<ePixelWise>\n\{\n  Image<eRead, eAccessPoint, eEdgeClamped> c1;\n  Image<eRead, eAccessPoint, eEdgeClamped> c2;\n  Image<eRead, eAccessPoint, eEdgeClamped> c3;\n  Image<eRead, eAccessPoint, eEdgeClamped> z1;\n  Image<eRead, eAccessPoint, eEdgeClamped> z2;\n  Image<eRead, eAccessPoint, eEdgeClamped> z3;\n  Image<eWrite> dst;\n\n  float key(float4 z)\n  \{\n    return z.w > 1e-6f ? z.x : 1e30f;\n  \}\n\n  // 1 when the near layer is clearly in front of the far one, 0.5 when they are level.\n  float closer(float kn, float kf)\n  \{\n    if (kf > 1e29f)\n      return 1.0f;\n    return 0.5f + 0.5f * clamp((kf - kn) / (0.06f * kf + 1.0f), 0.0f, 1.0f);\n  \}\n\n  float4 over(float4 a, float4 b)\n  \{\n    return a + b * (1.0f - a.w);\n  \}\n\n  void process()\n  \{\n    float4 a = c1();\n    float4 b = c2();\n    float4 c = c3();\n    float ka = key(z1());\n    float kb = key(z2());\n    float kc = key(z3());\n    // Sort three by key, nearest first.\n    if (kb < ka) \{\n      float4 t = a;\n      a = b;\n      b = t;\n      float k = ka;\n      ka = kb;\n      kb = k;\n    \}\n    if (kc < kb) \{\n      float4 t = b;\n      b = c;\n      c = t;\n      float k = kb;\n      kb = kc;\n      kc = k;\n    \}\n    if (kb < ka) \{\n      float4 t = a;\n      a = b;\n      b = t;\n      float k = ka;\n      ka = kb;\n      kb = k;\n    \}\n    // Two layers at about the same depth are in each other, not one in front: a hard order\n    // would flip from pixel to pixel along the line where they cross (dotted seams, bright\n    // rims drawn over the cloud behind). So the order fades over 6% of the depth: at equal\n    // depth the result is the mean of both orders.\n    float wbc = closer(kb, kc);\n    float4 bc = over(b, c) * wbc + over(c, b) * (1.0f - wbc);\n    float wab = closer(ka, kb);\n    dst() = over(a, bc) * wab + over(b, over(a, c)) * (1.0f - wab);\n  \}\n\};\n"
  rebuild ""
  rebuild_finalise ""
  name Sun_Stack
  xpos 360
  ypos 1386
 }
