  EzCloudGen_top_round {{parent.l3_top_round}}
  EzCloudGen_detail_size {{parent.l3_detail_size}}
  EzCloudGen_erosion {{parent.l3_erosion}}
  EzCloudGen_sigma {{parent.l3_sigma}}
  EzCloudGen_cells {{parent.l3_cells}}
  EzCloudGen_cell_km {{parent.l3_cell_km}}
  EzCloudGen_warp {{parent.l3_warp}}
  EzCloudGen_forward {{parent.l3_forward}}
  EzCloudGen_ambient {{parent.l3_ambient}}
  EzCloudGen_octaves {{parent.l3_octaves}}
  EzCloudGen_billow {{parent.l3_billow}}
  EzCloudGen_streaks {{parent.l3_streaks}}
  EzCloudGen_vary {{parent.l3_vary}}
  EzCloudGen_density {{parent.l3_density}}
  rebuild_finalise ""
  name L3_Color
  xpos 0
  ypos 468
  disable {{!parent.l3_enable}}
