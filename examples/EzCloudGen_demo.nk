 addUserKnob {7 l3_lumps l lumps t "Big rounded lobes that break the shape into towers and bulges (volumes and decks). Cumulus keep a flat, ragged base under them." R 0 1.5}
 addUserKnob {7 l3_lump_size l "lump size" t "Size of the lumps, in metres." R 20 5000}
 l3_lump_size 600
 addUserKnob {7 l3_small_lumps l "small lumps" t "A second set of lobes, a bit under half the size, riding on the lumps: cauliflower heads."}
 addUserKnob {7 l3_skirt l skirt t "Smooth, firm billows on top and a wide, soft skirt of wisps around the base: it calms the erosion higher up, and widens the edge and feeds the wisps low down." R 0 2}
 addUserKnob {7 l3_fade_top l "fade top" t "Eats the cloud away towards the top of its box, this far in (0..1 of the box): the erosion tears the margin up. Fog that sits low and thins out above." +HIDDEN}
 addUserKnob {7 l3_fade_bottom l "fade bottom" t "The same towards the bottom of the box." +HIDDEN}
 addUserKnob {7 l3_fade_left l "fade left" t "The same towards the box's left side (local -X)." +HIDDEN}
 addUserKnob {7 l3_fade_right l "fade right" t "The same towards the box's right side (local +X)." +HIDDEN}
 addUserKnob {7 l3_fade_front l "fade front" t "The same towards the box's front (local +Z)." +HIDDEN}
 addUserKnob {7 l3_fade_back l "fade back" t "The same towards the box's back (local -Z)." +HIDDEN}
 addUserKnob {26 l3_erosion_divider l erosion}
 addUserKnob {7 l3_erosion l billows t "How much the billows (cauliflower bumps, or soft wisps with 'billow' at 0) break up the surface."}
 l3_erosion 0.6
