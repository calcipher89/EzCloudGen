d not (selflit and 2 == 1):\n        ret = lnode.sample('green', 2.5, 0.5)\n    elif selflit:\n        import math\n        sk = a\['sun_in_use']\n        sx, sy, sz = sk.getValueAt(nuke.frame(), 0), sk.getValueAt(nuke.frame(), 1), sk.getValueAt(nuke.frame(), 2)\n        el = math.degrees(math.asin(max(min(sy / (math.sqrt(sx * sx + sy * sy + sz * sz) or 1.0), 1.0), -1.0)))\n        am = 1.0 / (math.sin(math.radians(max(el, 0.0))) + 0.50572 * (max(el, 0.0) + 6.07995) ** -1.6364)\n        hk = a\['camera_height'].value() / 1000.0\n        tr = a\['rayleigh_coefficients'].getValueAt(nuke.frame(), 1) * a\['sky_amount'].value() * a\['rayleigh_scale_height'].value() * math.exp(-hk / a\['rayleigh_scale_height'].value())\n        tm = a\['mie_coefficient'].value() / 0.9 * a\['haze_amount'].value() * a\['haze_height'].value() * math.exp(-hk / max(a\['haze_height'].value(), 1e-3))\n        ck = a\['sun_color_in_use'] if a.knob('sun_color_in_use') else a\['sun_color']\n        tint = ck.getValueAt(nuke.frame(), 1) if ck.arraySize() > 1 and not ck.singleValue() else ck.getValueAt(nuke.frame(), 0)\n        ret = tint * a\['manual_sun_brightness'].value() * a\['sun_strength'].value() * math.exp(-(tr + tm) * am) if el > -1 else 0.0\n\}]"} {"\[python -execlocal \{a = nuke.thisNode().input(2)\nwhile a is not None and not a.knob('haze_density'):\n    a = a.input(0) if a.inputs() else None\nret = 0\nif a is not None:\n    selflit = a.knob('self_lit') is not None and a\['self_lit'].value()\n    lnode = nuke.toNode(a.fullName() + ('.SelfLight' if selflit and 2 == 2 else '.Light'))\n    if lnode is not None and not (selflit and 2 == 1):\n        ret = lnode.sample('blue', 2.5, 0.5)\n    elif selflit:\n        import math\n        sk = a\['sun_in_use']\n        sx, sy, sz = sk.getValueAt(nuke.frame(), 0), sk.getValueAt(nuke.frame(), 1), sk.getValueAt(nuke.frame(), 2)\n        el = math.degrees(math.asin(max(min(sy / (math.sqrt(sx * sx + sy * sy + sz * sz) or 1.0), 1.0), -1.0)))\n        am = 1.0 / (math.sin(math.radians(max(el, 0.0))) + 0.50572 * (max(el, 0.0) + 6.07995) ** -1.6364)\n        hk = a\['camera_height'].value() / 1000.0\n        tr = a\['rayleigh_coefficients'].getValueAt(nuke.frame(), 2) * a\['sky_amount'].value() * a\['rayleigh_scale_height'].value() * math.exp(-hk / a\['rayleigh_scale_height'].value())\n        tm = a\['mie_coefficient'].value() / 0.9 * a\['haze_amount'].value() * a\['haze_height'].value() * math.exp(-hk / max(a\['haze_height'].value(), 1e-3))\n        ck = a\['sun_color_in_use'] if a.knob('sun_color_in_use') else a\['sun_color']\n        tint = ck.getValueAt(nuke.frame(), 2) if ck.arraySize() > 1 and not ck.singleValue() else ck.getValueAt(nuke.frame(), 0)\n        ret = tint * a\['manual_sun_brightness'].value() * a\['sun_strength'].value() * math.exp(-(tr + tm) * am) if el > -1 else 0.0\n\}]"}}
 addUserKnob {3 axis_found +INVISIBLE}
 axis_found {{"\[python -execlocal \{x = nuke.thisNode().input(3)\nwhile x is not None and not x.knob('world_matrix'):\n    x = x.input(0) if x.inputs() else None\nret = 1 if x is not None else 0\}]"}}
 addUserKnob {13 axis_position +INVISIBLE}
 axis_position {{"\[python -execlocal \{x = nuke.thisNode().input(3)\nwhile x is not None and not x.knob('world_matrix'):\n    x = x.input(0) if x.inputs() else None\nret = x\['world_matrix'].getValueAt(nuke.frame(), 3) if x is not None else 0\}]"} {"\[python -execlocal \{x = nuke.thisNode().input(3)\nwhile x is not None and not x.knob('world_matrix'):\n    x = x.input(0) if x.inputs() else None\nret = x\['world_matrix'].getValueAt(nuke.frame(), 7) if x is not None else 0\}]"} {"\[python -execlocal \{x = nuke.thisNode().input(3)\nwhile x is not None and not x.knob('world_matrix'):\n    x = x.input(0) if x.inputs() else None\nret = x\['world_matrix'].getValueAt(nuke.frame(), 11) if x is not None else 0\}]"}}
 addUserKnob {3 bg_found +INVISIBLE}
 bg_found {{"\[python -execlocal \{ret = 1 if nuke.thisNode().input(0) is not None else 0\}]"}}
 addUserKnob {3 sun_source +INVISIBLE}
 sun_source {{"sun_from==1 ? (axis_found ? 1 : 0) : sun_from==2 ? (atm_found ? 2 : 0) : sun_from==3 ? 0 : (axis_found ? 1 : atm_found ? 2 : 0)"}}
 addUserKnob {3 light_source +INVISIBLE}
 light_source {{"light_from==0 && atm_found && (atm_sun_color.r + atm_sun_color.g + atm_sun_color.b) > 0 ? 1 : 0"}}
 addUserKnob {7 sun_rotation_in_use +INVISIBLE}
 sun_rotation_in_use {{"sun_source==2 ? atm_rotation : 0"}}
 addUserKnob {18 sun_color_in_use +INVISIBLE}
 sun_color_in_use {{"(light_source ? atm_sun_color.r : sun_color.r) * sun_intensity"} {"(light_source ? atm_sun_color.g : sun_color.g) * sun_intensity"} {"(light_source ? atm_sun_color.b : sun_color.b) * sun_intensity"}}
 addUserKnob {18 sky_color_in_use +INVISIBLE}
 sky_color_in_use {{"(light_source ? atm_sky_color.r : sky_color.r) * sky_intensity"} {"(light_source ? atm_sky_color.g : sky_color.g) * sky_intensity"} {"(light_source ? atm_sky_color.b : sky_color.b) * sky_intensity"}}
 addUserKnob {18 haze_color_in_use +INVISIBLE}
 haze_color_in_use {{"light_source ? atm_sky_color.r * haze_color.r : haze_color.r * 0.43 * (0.5 + 0.5 * sky_color.r / max(sky_color.r, sky_color.g, sky_color.b, 1e-4))"} {"light_source ? atm_sky_color.g * haze_color.g : haze_color.g * 0.43 * (0.5 + 0.5 * sky_color.g / max(sky_color.r, sky_color.g, sky_color.b, 1e-4))"} {"light_source ? atm_sky_color.b * haze_color.b : haze_color.b * 0.43 * (0.5 + 0.5 * sky_color.b / max(sky_color.r, sky_color.g, sky_color.b, 1e-4))"}}
 addUserKnob {7 work_scale +INVISIBLE}
 work_scale {{"(resolution==0 ? 1 : resolution==1 ? 0.5 : 0.25) * (preview ? 0.5 : 1)"}}
 addUserKnob {7 time_s +INVISIBLE}
