': 0.0, 'fade_back': 0.0\}, 'Torn Low Cloud': \{'base': 200, 'thickness': 1000, 'coverage': 0.52, 'scale_km': 2.0, 'stretch': 1.0, 'wind_deg': 20, 'edge': 0.25, 'taper': 0.0, 'bottom_round': 0.2, 'top_round': 0.3, 'detail_size': 70, 'erosion': 0.5, 'sigma': 0.04, 'cells': 0.0, 'cell_km': 0.5, 'warp': 1.5, 'forward': 0.7, 'ambient': 0.85, 'sky_occlusion': 1.0, 'shadow_depth': 0.0, 'octaves': 3, 'billow': 0.6, 'streaks': 0.0, 'vary': 0.0, 'volume': 1, 'vol_shape': 0, 'vol_size': (1200, 500, 900), 'lumps': 1.1, 'lump_size': 250, 'small_lumps': 0.0, 'skirt': 0.0, 'place_km': 2, 'wisp_size': 25, 'wisp_amount': 0.7, 'grain_size': 8, 'grain_amount': 0.3, 'swirl': 0.5, 'swirl_size': 150, 'turbulence': 0.5, 'crumble': 1.0, 'crumble_size': 70, 'shear': 0.0, 'fade_top': 0.0, 'fade_bottom': 0.25, 'fade_left': 0.0, 'fade_right': 0.0, 'fade_front': 0.0, 'fade_back': 0.0\}, 'Puff': \{'base': 800, 'thickness': 1000, 'coverage': 0.5, 'scale_km': 2.0, 'stretch': 1.0, 'wind_deg': 20, 'edge': 0.08, 'taper': 0.0, 'bottom_round': 0.08, 'top_round': 0.3, 'detail_size': 60, 'erosion': 0.5, 'sigma': 0.05, 'cells': 0.0, 'cell_km': 0.5, 'warp': 1.5, 'forward': 0.8, 'ambient': 1.0, 'sky_occlusion': 1.0, 'shadow_depth': 0.0, 'octaves': 3, 'billow': 1.0, 'streaks': 0.0, 'vary': 0.0, 'volume': 1, 'vol_shape': 0, 'vol_size': (600, 450, 600), 'lumps': 0.4, 'lump_size': 150, 'small_lumps': 0.3, 'skirt': 0.0, 'place_km': 2, 'wisp_size': 20, 'wisp_amount': 0.4, 'grain_size': 6, 'grain_amount': 0.3, 'swirl': 0.0, 'swirl_size': 400, 'turbulence': 0.0, 'crumble': 0.0, 'crumble_size': 120, 'shear': 0.0, 'fade_top': 0.0, 'fade_bottom': 0.0, 'fade_left': 0.0, 'fade_right': 0.0, 'fade_front': 0.0, 'fade_back': 0.0\}, 'Soft Cumulus': \{'base': 1400, 'thickness': 1000, 'coverage': 0.38, 'scale_km': 2.0, 'stretch': 1.0, 'wind_deg': 20, 'edge': 0.09, 'taper': 0.0, 'bottom_round': 0.04, 'top_round': 0.3, 'detail_size': 160, 'erosion': 0.45, 'sigma': 0.09, 'cells': 0.0, 'cell_km': 0.5, 'warp': 1.2, 'forward': 0.8, 'ambient': 1.4, 'sky_occlusion': 0.4, 'shadow_depth': 0.0, 'octaves': 5, 'billow': 1.0, 'streaks': 0.0, 'vary': 0.0, 'volume': 1, 'vol_shape': 1, 'vol_size': (6400, 3100, 5200), 'lumps': 1.0, 'lump_size': 900, 'small_lumps': 0.2, 'skirt': 1.0, 'place_km': 12, 'wisp_size': 300, 'wisp_amount': 0.6, 'grain_size': 15, 'grain_amount': 0.0, 'swirl': 0.18, 'swirl_size': 500, 'turbulence': 0.0, 'crumble': 0.0, 'crumble_size': 120, 'shear': 0.0, 'fade_top': 0.0, 'fade_bottom': 0.18, 'fade_left': 0.12, 'fade_right': 0.12, 'fade_front': 0.0, 'fade_back': 0.0\}\}\n    box = n.input(4 + int(p\[1]))\n    box = box if box is not None and box.knob('scaling') else None\n    for key, v in t\[k.value()].items():\n        if key == 'vol_size' and box is not None:\n            # A box plugged in: size the box instead.\n            s = n\['scene_scale'].value() or 1.0\n            box\['uniform_scale'].setValue(1)\n            box\['scaling'].setValue(\[v\[0] / s, v\[1] / s, v\[2] / s])\n        elif n.knob(p + key) is not None:\n            n\[p + key].setValue(list(v) if isinstance(v, tuple) else v)\n    # A PyScript button can't be executed from inside knobChanged ('already executing'), so\n    # its code runs here. Every volume type re-places (base and distance come with the type),\n    # unless the position is animated or linked.\n    if n\[p + 'volume'].value() > 0.5 and (box is not None or not n\[p + 'vol_position'].isAnimated()):\n        exec(n\[p + 'place'].value(), \{'nuke': nuke\})\n    layers = \[p]\nelif k.name() == 'depth_channel':\n    # The knob gives short names; a Copy reads 'depth' as cutout.depth, not depth.Z.\n    c = \{'depth': 'depth.Z'\}.get(k.value(), k.value())\n    n.node('DepthEnsure')\['channels'].setValue(c)\n    n.node('DepthSource')\['from0'].setValue(c)\nelif k.name() == 'showPanel':\n    layers = \['l1_', 'l2_', 'l3_']\nfor p in layers:\n    vol = n\[p + 'volume'].value() > 0.5\n    for name in \['thickness', 'scale_km', 'stretch', 'taper', 'top_round', 'cells', 'cell_km', 'warp', 'streaks', 'vary', 'map_amount', 'map_channel']:\n        n\[p + name].setVisible(not vol)\n    for name in \['vol_divider', 'vol_shape', 'vol_position', 'vol_rotate', 'vol_size', 'place', 'place_km', 'make_box', 'release_box', 'fade_top', 'fade_bottom', 'fade_left', 'fade_right', 'fade_front', 'fade_back']:\n        n\[p + name].setVisible(vol)\n"
 tile_color 0x8fb3d9ff
 label "\[expr \{\[value preview] ? \"PREVIEW\" : \"\"\}]"
 selected true
 addUserKnob {20 ezcloudgen l EzCloudGen}
 addUserKnob {4 view t "Comp: the clouds over 'bg' (or alone without it). Clouds: the clouds alone, premultiplied. Sun share: the direct sunlight part of the clouds. Depth: Planar Z of the clouds, scene units. Variations: nine seeds of one layer side by side (see 'variations'). Shadow: the clouds' shadows on the bg (needs its depth), white is shaded." M {Comp Clouds "Sun share" Depth Variations Shadow}}
 addUserKnob {6 preview t "Fast look-dev: half the resolution and the ray march steps, one sample, and only the passes the view needs (no sun share, shadows or motion vectors, so those layers are black). Turn it off for the real thing; the node's label says PREVIEW while it is on." -STARTLINE}
 addUserKnob {6 breakout l "breakout layers" t "Adds the layers cloud (rgba), cloud_sun and cloud_sky (rgb), for re-grading the clouds over the plate, and cloud_shadow (rgb, the shadows on the bg; needs its depth). Takes extra passes per layer." -STARTLINE}
 breakout true
 addUserKnob {6 motion_vectors l "motion vectors" t "Adds forward (u, v) and backward (u, v) motion vectors of the clouds, in pixels, for VectorBlur or a motion blur in comp. They follow the camera, the wind drift and moving 3D boxes. Takes two more (cheap) passes per layer." -STARTLINE}
 addUserKnob {4 resolution t "Render the clouds smaller and scale them back up: much faster, softer." M {Full Half Quarter}}
 resolution Half
 addUserKnob {7 quality t "Ray march step count: higher is smoother and slower." R 0.25 4}
 quality 1
 addUserKnob {7 edge_steps l "edge steps" t "Finer ray steps where a ray meets cloud (this many to a normal step): clean, grain-free surfaces and edges. 1: off (faster, grainy). The preview uses 1." R 1 6}
 edge_steps 3
 addUserKnob {3 samples t "Jittered samples per pixel: anti-aliasing and less grain."}
 samples 1
 addUserKnob {7 max_distance l "max distance" t "Clouds fade out towards this distance (km). The default reaches past the horizon from high up." R 5 500}
 max_distance 400
 addUserKnob {26 scene_divider l scene}
 addUserKnob {7 scene_scale l "units to metres" t "Scene units to metres: 0.1 for decimetres."}
 scene_scale 0.1
 addUserKnob {7 ground_height l "ground height" t "Height of the ground in scene units; the camera's height above it places it under the clouds." R -10000 10000}
 addUserKnob {4 earth t "Flat: the ground is a plane pinned to the world, so a moving camera can climb, dive and fly through the decks and the clouds keep their shape out to the horizon. Curved: the real earth, its top at the scene origin; from high up the far decks sink behind the true horizon." M {Flat Curved}}
 addUserKnob {26 bg_depth_divider l "bg depth"}
 addUserKnob {6 occlude l "hide behind bg" t "Uses the bg's depth so the clouds go behind mountains and buildings, and casts their shadows onto it (cloud_shadow, and the Shadow view). Without a depth channel on the bg, nothing is hidden." -STARTLINE}
 occlude true
 addUserKnob {11 depth_channel l depth t "The bg channel holding its depth."}
 depth_channel depth
 addUserKnob {4 depth_mode l "depth is" t "Planar Z: distance along the camera's view axis (Arnold, Karma, V-Ray Z). 1/Z: Nuke's ScanlineRender. Distance: from the camera to the point." -STARTLINE M {"Planar Z" "1/Z (ScanlineRender)" Distance}}
 addUserKnob {7 sky_depth l "sky beyond" t "Depth beyond this (km) is sky, like a far sky dome, so it hides nothing. A depth of 0 is always sky." R 1 500}
 sky_depth 50
 addUserKnob {7 shadow_amount l "shadow amount" t "How much the shadows darken the bg in the Comp view. The cloud_shadow layer is always the full shadow, for grading the plate yourself."}
 shadow_amount 0.6
 addUserKnob {6 layer_shadows l "layers shadow each other" t "A layer shades the sunlit side of the clouds below it in the other layers (a map of its shadow seen from the sun, one small pass per layer)." -STARTLINE}
 layer_shadows true
 addUserKnob {6 sun_map_out l "sun shadow layer" t "Adds the cloud_sunmap layer (with 'breakout layers'): all the layers' shadow seen from the sun. EzCloudShafts reads it from its clouds input and casts its rays and ground shadows from the real cloud volumes, tall ones and ones outside the frame included." -STARTLINE}
 sun_map_out true
 addUserKnob {7 sun_map_size +INVISIBLE}
 sun_map_size 10000
 addUserKnob {26 sun_divider l sun}
 addUserKnob {4 sun_from l "sun from" t "Auto: the Axis in 'sun' if there is one, else the EzAtmosScatter in 'atmos', else 'sun direction'." M {Auto Axis EzAtmosScatter Manual}}
 addUserKnob {13 sun_direction l "sun direction" t "Direction towards the sun, +Y up."}
 sun_direction {0.3 0.35 -1}
 addUserKnob {13 sun_in_use l "sun in use" t "The sun direction being used (read only)." +DISABLED}
 sun_in_use {{"sun_source==1 ? axis_position.x : sun_source==2 ? atm_sun.x : sun_direction.x"} {"sun_source==1 ? axis_position.y : sun_source==2 ? atm_sun.y : sun_direction.y"} {"sun_source==1 ? axis_position.z : sun_source==2 ? atm_sun.z : sun_direction.z"}}
 addUserKnob {4 light_from l "light from" t "Auto: the sun and sky light the EzAtmosScatter in 'atmos' measures in its HDRI. Manual (or no atmos): 'sun color' and 'sky color'." M {Auto Manual}}
 addUserKnob {18 sun_color l "sun color" t "Sunlight (irradiance) when the light is Manual."}
 sun_color {9 8.5 7.6}
 addUserKnob {18 sky_color l "sky color" t "Sky light (radiance) when the light is Manual."}
 sky_color {0.2 0.32 0.6}
 addUserKnob {18 ground_color l "ground bounce" t "Light bounced up from the ground onto the cloud bases."}
 ground_color {0.08 0.07 0.06}
 addUserKnob {7 sun_intensity l "sun intensity" t "Multiplies the sunlight."}
 sun_intensity 1
 addUserKnob {7 sky_intensity l "sky intensity" t "Multiplies the sky light."}
 sky_intensity 1
 addUserKnob {7 exposure t "Brightens or darkens the clouds, in stops (rgba and the cloud layers; not the bg)." R -4 4}
 addUserKnob {7 highlight_rolloff l "highlight rolloff" t "Rolls the clouds' highlights off towards 1 instead of letting them run past it: sunlit tops seen towards the sun are several times brighter than the bodies and blow out in a plain sRGB view. 0: off (linear, as rendered). 0.5: the top half of the range is compressed. The hue is kept."}
 addUserKnob {7 sun_glow l "sun glow" t "The blaze of thin cloud in front of the sun: adds the narrow forward peak real cloud droplets have, so backlit edges and veils near the sun glow hot while the thick cores stay dark. 0: off. 0.3 to 1 for shots into the sun (use 'highlight rolloff' with it)." R 0 2}
 addUserKnob {7 diffusion l "light diffusion" t "How the sunlight spreads inside the clouds. 0: the older, darker look. 1: as in thick real cloud, where light scattered many times fades slowly with depth: sunlit sides go bright white, billows shade off gradually round their sides and cores stay luminous grey instead of dead. Use 'highlight rolloff' with it."}
 addUserKnob {26 haze_divider l air}
 addUserKnob {7 haze_distance l "haze distance" t "Distance (km) over which far clouds fade into the haze colour. 0: off." R 0 200}
 haze_distance 60
 addUserKnob {7 horizon_haze l "horizon haze" t "Lays the haze over the far ground too (thick at the horizon, thinning towards the camera), so the decks sink into haze there instead of ending on a straight line when the plate has no ground. 0: off (for a plate with its own ground and no depth)."}
 horizon_haze 1
 addUserKnob {18 haze_color l "haze color" t "Colour far clouds fade to. With the light from an atmos it multiplies the atmos's sky colour; with Manual light it's tinted half way towards the sky colour's hue."}
 haze_color {1.4 1.35 1.3}
 addUserKnob {26 gap_divider l "sun gap"}
 addUserKnob {7 gap_amount l "gap toward sun" t "Opens a hole in every layer where the line from the camera to the sun crosses it, so the sun and EzCloudShafts' shafts come through."}
 addUserKnob {7 gap_size l "gap size" t "Radius of the gap, in km."}
 gap_size 2
 addUserKnob {26 time_divider l time}
 addUserKnob {7 evolve_speed l evolve t "How fast the cloud detail boils, in metres per second."}
 evolve_speed 0.5
 addUserKnob {7 seed t "Changes every layer's clouds."}
 addUserKnob {26 variations_divider l variations}
 addUserKnob {4 variations_of l "variations of" t "The layer 'show me variations' shows." M {"Layer 1" "Layer 2" "Layer 3"}}
 addUserKnob {22 show_variations l "show me variations" t "Shows nine seeds of this layer side by side (view: Variations). Pick one with 'use number'." -STARTLINE T "n = nuke.thisNode()\np = 'l%d_' % (int(n\['variations_of'].getValue()) + 1)\nn\[p + 'enable'].setValue(True)\nn\['view'].setValue('Variations')\n"}
 addUserKnob {22 next_variations l "next nine" t "Nine more seeds." -STARTLINE T "n = nuke.thisNode()\np = 'l%d_' % (int(n\['variations_of'].getValue()) + 1)\nn\[p + 'seed'].setValue(n\[p + 'seed'].value() + 9)\nn\['view'].setValue('Variations')\n"}
 addUserKnob {3 variation_pick l "use number" t "1 is the top left, reading along the rows to 9 at the bottom right."}
 variation_pick 1
 addUserKnob {22 use_variation l "use it" t "Sets the layer's seed to that variation and goes back to the Comp view." -STARTLINE T "n = nuke.thisNode()\np = 'l%d_' % (int(n\['variations_of'].getValue()) + 1)\nk = min(max(int(n\['variation_pick'].value()), 1), 9)\nn\[p + 'seed'].setValue(n\[p + 'seed'].value() + k - 1)\nn\['view'].setValue('Comp')\n"}
 addUserKnob {26 map_divider l "coverage map"}
 addUserKnob {26 map_help l "" +STARTLINE T "Plug a picture into 'map' to say where the decks have clouds, as seen\nthrough the camera on 'map frame': white piles up clouds, mid grey keeps\nthe layer's coverage, black clears it. It marks where the clouds stand on the\nlayer (at its middle height), and white heaps them into domes. Paint it with\na Roto over the plate, soft and blurred. It stays put in the world and drifts\nwith the wind."}
 addUserKnob {3 map_frame l "map frame" t "The frame the map is painted on."}
 map_frame 1
 addUserKnob {22 map_frame_here l "use this frame" t "Sets 'map frame' to the current frame." -STARTLINE T "nuke.thisNode()\['map_frame'].setValue(nuke.frame())"}
 addUserKnob {20 l1_tab l "Layer 1"}
 addUserKnob {6 l1_enable l enable t "Draw this layer. Layers sort themselves by depth." -STARTLINE}
 l1_enable true
 addUserKnob {4 l1_type l type t "Sets this layer's shape knobs to the type's values (they can be tuned after)." M {Cumulus "Cumulus Congestus" Stratocumulus Stratus Altocumulus Altostratus Cirrus Cirrocumulus "Hero Cumulus" "Towering Cumulus" "Storm Anvil" "Fog Bank" "Ground Fog" "Wispy Fog" "Torn Low Cloud" Puff "Soft Cumulus"}}
 addUserKnob {7 l1_base l "base height" t "Height of the cloud base above the ground, in metres." R 0 12000}
 l1_base 1400
 addUserKnob {7 l1_thickness l thickness t "Depth of the layer, base to top, in metres." R 50 6000}
 l1_thickness 1300
 addUserKnob {7 l1_coverage l coverage t "How much of the sky the layer covers."}
 l1_coverage 0.43
 addUserKnob {7 l1_scale_km l size t "Size of the cloud shapes across the ground, in km." R 0.1 10}
 l1_scale_km 1.6
 addUserKnob {7 l1_wind_deg l "wind direction" t "Direction the shapes stretch and drift along, in degrees (0 = away from the world -Z axis, 90 = +X)." R -180 180}
 l1_wind_deg 20
 addUserKnob {7 l1_map_amount l "follow map" t "How much this deck follows the coverage map (when 'map' is plugged in)."}
 l1_map_amount 1
 addUserKnob {4 l1_map_channel l "map channel" t "Which channel of the map this deck reads: paint each deck in its own channel to place them separately." -STARTLINE M {luminance red green blue alpha}}
 addUserKnob {26 l1_vol_divider l volume +HIDDEN}
 addUserKnob {4 l1_vol_shape l shape t "The volume's overall shape, before lumps and erosion break it up." +HIDDEN M {Ellipsoid Dome Anvil Box Towers}}
 l1_vol_shape Dome
 addUserKnob {13 l1_vol_position l position t "Centre of the volume's base, in scene units. Not used while a 3D node is plugged into the layer's box input ('make 3D box')." +HIDDEN}
 addUserKnob {13 l1_vol_rotate l rotate t "Turns the volume, in degrees (Y, then X, then Z)." +HIDDEN}
 addUserKnob {13 l1_vol_size l size t "Width, height and depth of the volume, in metres." +HIDDEN}
 l1_vol_size {3000 1800 3000}
 addUserKnob {22 l1_place l "place in front of camera" t "Puts the volume 'distance' ahead of the camera, on the ground at 'base height'." -STARTLINE +HIDDEN T "n = nuke.thisNode()\nm = n\['cam_world_matrix']\ns = n\['scene_scale'].value() or 1.0\nfx, fz = -m.getValue(2), -m.getValue(10)\nl = (fx * fx + fz * fz) ** 0.5\nif l < 1e-6:\n    fx, fz, l = 0.0, -1.0, 1.0\nd = n\['l1_place_km'].value() * 1000.0 / s\npos = \[m.getValue(3) + fx / l * d, n\['ground_height'].value() + n\['l1_base'].value() / s, m.getValue(11) + fz / l * d]\nbox = n.input(5)\nif box is not None and box.knob('translate') and box.knob('scaling'):\n    # A box plugged in: move the box (its centre is half its height above the base).\n    h = box\['scaling'].value(1) * box\['uniform_scale'].value()\n    box\['translate'].setValue(\[pos\[0], pos\[1] + h / 2.0, pos\[2]])\nelse:\n    n\['l1_vol_position'].setValue(pos)\n"}
 addUserKnob {7 l1_place_km l distance t "How far ahead 'place in front of camera' puts it, km." -STARTLINE +HIDDEN}
 l1_place_km 10
 addUserKnob {22 l1_make_box l "make 3D box" t "Makes a Cube beside this node, placed and sized like the volume, and plugs it into this layer's box input (box1): move, rotate and scale the Cube in the 3D viewer (view it with your camera) and the cloud follows. Any 3D node works in that input (a Cube, an Axis, a TransformGeo, parented or tracked), and the volume fills its box." -STARTLINE +HIDDEN T "n = nuke.thisNode()\np = 'l1_'\nidx = 5\ns = n\['scene_scale'].value() or 1.0\nif n.input(idx) is None:\n    path = n.fullName().split('.')\n    ctx = nuke.toNode('.'.join(path\[:-1])) if len(path) > 1 else nuke.root()\n    ctx.begin()\n    c = nuke.nodes.Cube(name=n.name() + '_L1_Box')\n    ctx.end()\n    c.setXYpos(n.xpos() - 150, n.ypos() - 60 * 0)\n    pos = n\[p + 'vol_position'].value()\n    size = n\[p + 'vol_size'].value()\n    # The kernel turns the volume Y, then X, then Z.\n    c\['rot_order'].setValue('YXZ')\n    c\['translate'].setValue(\[pos\[0], pos\[1] + size\[1] / s / 2.0, pos\[2]])\n    c\['rotate'].setValue(n\[p + 'vol_rotate'].value())\n    c\['scaling'].setValue(\[size\[0] / s, size\[1] / s, size\[2] / s])\n    c\['display'].setValue('wireframe')\n    c\['render_mode'].setValue('off')\n    c\['label'].setValue('cloud volume: ' + n.name() + ' layer 1')\n    c\['tile_color'].setValue(0x8fb3d9ff)\n    n.setInput(idx, c)\n"}
 addUserKnob {22 l1_release_box l "release box" t "Unplugs the box; the volume stays where it is." -STARTLINE +HIDDEN T "n = nuke.thisNode()\np = 'l1_'\nimport math\nif n\[p + 'box_found'].value() > 0.5:\n    s = n\['scene_scale'].value() or 1.0\n    c = n\[p + 'box_center'].value()\n    size = n\[p + 'box_size'].value()\n    ax = n\[p + 'box_axis_x'].value()\n    ay = n\[p + 'box_axis_y'].value()\n    az = n\[p + 'box_axis_z'].value()\n    # The kernel's R = Rz Rx Ry: axis_y = (-sin z cos x, cos z cos x, sin x), and so on.\n    rx = math.degrees(math.asin(max(-1.0, min(1.0, ay\[2]))))\n    rz = math.degrees(math.atan2(-ay\[0], ay\[1]))\n    ry = math.degrees(math.atan2(-ax\[2], az\[2]))\n    n\[p + 'vol_rotate'].setValue(\[rx, ry, rz])\n    n\[p + 'vol_size'].setValue(list(size))\n    n\[p + 'vol_position'].setValue(\[c\[0], c\[1] - size\[1] / s / 2.0, c\[2]])\nn.setInput(5, None)\n"}
 addUserKnob {3 l1_box_found +INVISIBLE}
 l1_box_found {{"\[python -execlocal \{ret = 0\nif nuke.thisNode().input(5) is not None:\n    g = \{'nuke': nuke\}\n    exec(nuke.thisNode()\['box_lib'].getText(), g)\n    ret = g\['box_value'](nuke.thisNode(), 5, 0, 'found')\}]"}}
