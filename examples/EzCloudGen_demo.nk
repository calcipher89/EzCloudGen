  EzCloudGen_evolve {{"parent.evolve_speed * parent.time_s"}}
  EzCloudGen_offset {{"-parent.l3_wind_speed * parent.time_s * sin(radians(parent.l3_wind_deg))"} {"parent.l3_wind_speed * parent.time_s * cos(radians(parent.l3_wind_deg))"}}
  EzCloudGen_gap_amount {{parent.gap_amount}}
  EzCloudGen_gap_size {{"parent.gap_size * 1000"}}
  EzCloudGen_base {{parent.l3_base}}
  EzCloudGen_thickness {{parent.l3_thickness}}
  EzCloudGen_coverage {{parent.l3_coverage}}
  EzCloudGen_scale_km {{parent.l3_scale_km}}
  EzCloudGen_stretch {{parent.l3_stretch}}
  EzCloudGen_wind_deg {{parent.l3_wind_deg}}
  EzCloudGen_edge {{parent.l3_edge}}
  EzCloudGen_taper {{parent.l3_taper}}
  EzCloudGen_bottom_round {{parent.l3_bottom_round}}
