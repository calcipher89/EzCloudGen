  EzCloudGen_other_vol_center {{"parent.l3_box_found ? parent.l3_box_center_next.x : parent.l3_vol_position.x(frame + (1))"} {"parent.l3_box_found ? parent.l3_box_center_next.y : parent.l3_vol_position.y(frame + (1)) + parent.l3_vol_size.y / 2 / max(parent.scene_scale, 1e-6)"} {"parent.l3_box_found ? parent.l3_box_center_next.z : parent.l3_vol_position.z(frame + (1))"}}
  EzCloudGen_vol_axes {{parent.l3_box_found}}
  EzCloudGen_vol_axis_x {{parent.l3_box_axis_x.x} {parent.l3_box_axis_x.y} {parent.l3_box_axis_x.z}}
  EzCloudGen_vol_axis_y {{parent.l3_box_axis_y.x} {parent.l3_box_axis_y.y} {parent.l3_box_axis_y.z}}
  EzCloudGen_vol_axis_z {{parent.l3_box_axis_z.x} {parent.l3_box_axis_z.y} {parent.l3_box_axis_z.z}}
  EzCloudGen_depth_mode {{parent.depth_mode}}
  EzCloudGen_sky_depth {{"parent.sky_depth * 1000 / max(parent.scene_scale, 1e-6)"}}
  rebuild_finalise ""
  name L3_SunMap
  xpos 360
  ypos 618
  disable {{"(!parent.l3_enable || (parent.view==4 && parent.variations_of!=2)) || !(parent.layer_shadows || (parent.sun_map_out && parent.breakout))"}}
 }
