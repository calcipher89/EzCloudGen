  EzCloudGen_other_row1 {{parent.cam_next_matrix.4} {parent.cam_next_matrix.5} {parent.cam_next_matrix.6}}
  EzCloudGen_other_row2 {{parent.cam_next_matrix.8} {parent.cam_next_matrix.9} {parent.cam_next_matrix.10}}
  EzCloudGen_other_position {{parent.cam_next_matrix.3} {parent.cam_next_matrix.7} {parent.cam_next_matrix.11}}
  EzCloudGen_other_focal {{parent.cam_next_focal}}
  EzCloudGen_other_haperture {{parent.cam_next_haperture}}
  EzCloudGen_other_offset {{"-parent.l1_wind_speed * (parent.time_s + (1) / max(root.fps, 1)) * sin(radians(parent.l1_wind_deg))"} {"parent.l1_wind_speed * (parent.time_s + (1) / max(root.fps, 1)) * cos(radians(parent.l1_wind_deg))"} {"-parent.l2_wind_speed * (parent.time_s + (1) / max(root.fps, 1)) * sin(radians(parent.l2_wind_deg))"} {"parent.l2_wind_speed * (parent.time_s + (1) / max(root.fps, 1)) * cos(radians(parent.l2_wind_deg))"} {"-parent.l3_wind_speed * (parent.time_s + (1) / max(root.fps, 1)) * sin(radians(parent.l3_wind_deg))"} {"parent.l3_wind_speed * (parent.time_s + (1) / max(root.fps, 1)) * cos(radians(parent.l3_wind_deg))"}}
  EzCloudGen_other_vol_center {
      {{"parent.l1_box_found ? parent.l1_box_center_next.x : parent.l1_vol_position.x(frame + (1))"} {"parent.l1_box_found ? parent.l1_box_center_next.y : parent.l1_vol_position.y(frame + (1)) + parent.l1_vol_size.y / 2 / max(parent.scene_scale, 1e-6)"} {"parent.l1_box_found ? parent.l1_box_center_next.z : parent.l1_vol_position.z(frame + (1))"}}
      {{"parent.l2_box_found ? parent.l2_box_center_next.x : parent.l2_vol_position.x(frame + (1))"} {"parent.l2_box_found ? parent.l2_box_center_next.y : parent.l2_vol_position.y(frame + (1)) + parent.l2_vol_size.y / 2 / max(parent.scene_scale, 1e-6)"} {"parent.l2_box_found ? parent.l2_box_center_next.z : parent.l2_vol_position.z(frame + (1))"}}
      {{"parent.l3_box_found ? parent.l3_box_center_next.x : parent.l3_vol_position.x(frame + (1))"} {"parent.l3_box_found ? parent.l3_box_center_next.y : parent.l3_vol_position.y(frame + (1)) + parent.l3_vol_size.y / 2 / max(parent.scene_scale, 1e-6)"} {"parent.l3_box_found ? parent.l3_box_center_next.z : parent.l3_vol_position.z(frame + (1))"}}
    }
  EzCloudGen_vol_axes {{parent.l1_box_found} {parent.l2_box_found} {parent.l3_box_found}}
  EzCloudGen_vol_axis_x {
      {{parent.l1_box_axis_x.x} {parent.l1_box_axis_x.y} {parent.l1_box_axis_x.z}}
      {{parent.l2_box_axis_x.x} {parent.l2_box_axis_x.y} {parent.l2_box_axis_x.z}}
      {{parent.l3_box_axis_x.x} {parent.l3_box_axis_x.y} {parent.l3_box_axis_x.z}}
    }
  EzCloudGen_vol_axis_y {
      {{parent.l1_box_axis_y.x} {parent.l1_box_axis_y.y} {parent.l1_box_axis_y.z}}
      {{parent.l2_box_axis_y.x} {parent.l2_box_axis_y.y} {parent.l2_box_axis_y.z}}
      {{parent.l3_box_axis_y.x} {parent.l3_box_axis_y.y} {parent.l3_box_axis_y.z}}
    }
  EzCloudGen_vol_axis_z {
      {{parent.l1_box_axis_z.x} {parent.l1_box_axis_z.y} {parent.l1_box_axis_z.z}}
      {{parent.l2_box_axis_z.x} {parent.l2_box_axis_z.y} {parent.l2_box_axis_z.z}}
      {{parent.l3_box_axis_z.x} {parent.l3_box_axis_z.y} {parent.l3_box_axis_z.z}}
    }
  EzCloudGen_depth_mode {{parent.depth_mode}}
  EzCloudGen_sky_depth {{"parent.sky_depth * 1000 / max(parent.scene_scale, 1e-6)"}}
  EzCloudGen_layer_on {{"!(!parent.l1_enable || (parent.view==4 && parent.variations_of!=0))"} {"!(!parent.l2_enable || (parent.view==4 && parent.variations_of!=1))"} {"!(!parent.l3_enable || (parent.view==4 && parent.variations_of!=2))"}}
  EzCloudGen_layer_seed {{"parent.seed + parent.l1_seed"} {"parent.seed + parent.l2_seed"} {"parent.seed + parent.l3_seed"}}
  EzCloudGen_only_layer 1
  rebuild_finalise ""
  name L2_SunMap
  xpos 360
  ypos 618
  disable {{"!(!(!parent.l2_enable || (parent.view==4 && parent.variations_of!=1))) || !(parent.layer_shadows || (parent.sun_map_out && parent.breakout))"}}
