set Nc78f2000 [stack 0]
 Expression {
  temp_name0 gain
  temp_expr0 "pow(2, parent.exposure)"
  temp_name1 m
  temp_expr1 "max(r, g, b) / max(a, 1e-6) * gain"
  temp_name2 k
  temp_expr2 "1 - clamp(parent.highlight_rolloff, 0, 0.999)"
  channel0 rgb
  expr0 "parent.highlight_rolloff <= 0 || m <= k ? gain : gain * (k + (1 - k) * ((m - k) / (1 - k)) / (1 + (m - k) / (1 - k))) / m"
  channel1 none
  channel2 none
  channel3 none
  name ToneScale
  xpos 180
  ypos 1554
 }
