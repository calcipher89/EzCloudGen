 l2_detail_size 220
 addUserKnob {7 l2_wisp_amount l wisps t "Fine wisps that eat into the thin edges."}
 l2_wisp_amount 0.08
 addUserKnob {7 l2_wisp_size l "wisp size" t "Size of the wisps, in metres." R 2 500}
 l2_wisp_size 80
 addUserKnob {7 l2_grain_amount l grain t "The finest breakup of the edges."}
 l2_grain_amount 0.04
 addUserKnob {7 l2_grain_size l "grain size" t "Size of the grain, in metres." R 1 100}
 l2_grain_size 20
 addUserKnob {7 l2_swirl l swirl t "Curls the detail around, for swirly wisps."}
