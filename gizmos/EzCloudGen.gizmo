  EzCloudGen_vol_axis_x {{parent.l1_box_axis_x.x} {parent.l1_box_axis_x.y} {parent.l1_box_axis_x.z}}
  EzCloudGen_vol_axis_y {{parent.l1_box_axis_y.x} {parent.l1_box_axis_y.y} {parent.l1_box_axis_y.z}}
  EzCloudGen_vol_axis_z {{parent.l1_box_axis_z.x} {parent.l1_box_axis_z.y} {parent.l1_box_axis_z.z}}
  EzCloudGen_depth_mode {{parent.depth_mode}}
  EzCloudGen_sky_depth {{"parent.sky_depth * 1000 / max(parent.scene_scale, 1e-6)"}}
  rebuild_finalise ""
  name L1_SunMap
  xpos 540
  ypos 618
  disable {{"(!parent.l1_enable || (parent.view==4 && parent.variations_of!=0)) || !(parent.layer_shadows || (parent.sun_map_out && parent.breakout))"}}
 }
