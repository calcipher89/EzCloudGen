 addUserKnob {7 l2_lumps l lumps t "Big rounded lobes that break the shape into towers and bulges (volumes and decks). Cumulus keep a flat, ragged base under them." R 0 1.5}
 l2_lumps 0.8
 addUserKnob {7 l2_lump_size l "lump size" t "Size of the lumps, in metres." R 20 5000}
 l2_lump_size 900
 addUserKnob {7 l2_small_lumps l "small lumps" t "A second set of lobes, a bit under half the size, riding on the lumps: cauliflower heads."}
 l2_small_lumps 0.35
 addUserKnob {7 l2_skirt l skirt t "Smooth, firm billows on top and a wide, soft skirt of wisps around the base: it calms the erosion higher up, and widens the edge and feeds the wisps low down." R 0 2}
 addUserKnob {7 l2_fade_top l "fade top" t "Eats the cloud away towards the top of its box, this far in (0..1 of the box): the erosion tears the margin up. Fog that sits low and thins out above."}
 addUserKnob {7 l2_fade_bottom l "fade bottom" t "The same towards the bottom of the box."}
 addUserKnob {7 l2_fade_left l "fade left" t "The same towards the box's left side (local -X)."}
 addUserKnob {7 l2_fade_right l "fade right" t "The same towards the box's right side (local +X)."}
 addUserKnob {7 l2_fade_front l "fade front" t "The same towards the box's front (local +Z)."}
 addUserKnob {7 l2_fade_back l "fade back" t "The same towards the box's back (local -Z)."}
 addUserKnob {26 l2_erosion_divider l erosion}
 addUserKnob {7 l2_erosion l billows t "How much the billows (cauliflower bumps, or soft wisps with 'billow' at 0) break up the surface."}
 l2_erosion 0.45
