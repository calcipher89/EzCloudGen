#! Nuke15.1 -nx
version 15.1 v3
Root {
 inputs 0
 name "[file dirname [value root.name]]/EzCloudGen_demo.nk"
 frame 1001
 first_frame 1001
 last_frame 1100
 lock_range true
 fps 24
 format "1920 1080 0 0 1920 1080 1 HD_1080"
}
add_layer {cloud cloud.red cloud.green cloud.blue cloud.alpha}
add_layer {cloud_sun cloud_sun.red cloud_sun.green cloud_sun.blue}
add_layer {cloud_sky cloud_sky.red cloud_sky.green cloud_sky.blue}
add_layer {cloud_shadow cloud_shadow.red cloud_shadow.green cloud_shadow.blue}
StickyNote {
 inputs 0
 name ReadMe
 label "EzCloudGen demo: synthetic, no files read. The scene is in decimetres (units to metres 0.1).\nThe shot camera is 300 m up and pans 12 degrees over 1001-1100; the clouds drift with the wind.\nViewer inputs: 1-4 sky decks. 5 HeroVolume: layer 2 fills the wireframe Cube in its box2 input (move it in 3D).\n6 StormFront. 7 Mountains: a ridge plate with depth.Z, so the clouds go behind it and shadow it (view Shadow),\nwith motion vectors on; 8 is its VectorBlur. 9 PaintedSky: a coverage map says where the clouds go.\n10 CanyonFog: overcast canyon (its own camera, CanyonCam): ground fog, torn low cloud, a close wisp.\n11 HighCam: GoldenHour from 1130 m up (its own camera, HighCamera): the decks reach the horizon.\n12 SoftCloud: one Soft Cumulus, on a long lens (its own camera, SoftCam) over a hazy sky.\n13 FlyThrough: its own camera (FlyCam) climbs to 3 km and dives back through a Stratocumulus deck, 1001-1024.\nEach EzCloudGen: Layer tabs have the type menu,\nview shows Comp / Clouds / Sun share / Depth / Variations / Shadow, resolution Half (Full for finals).\nOutputs: rgba, depth.Z (Planar Z, scene units, for EzCloudShafts), cloud, cloud_sun, cloud_sky, cloud_shadow,\nforward/backward (with motion vectors on)."
 note_font_size 18
 xpos 0
 ypos -420
}
Camera2 {
 inputs 0
 translate {0 3000 0}
 rotate {18 {curve x1001 0 x1100 12} 0}
 focal 24
 haperture 36
 vaperture 20.25
 name ShotCamera
 label "300 m up, pitched 18 deg"
 xpos 0
 ypos -200
}
set Ncam [stack 0]
Constant {
 inputs 0
 channels rgba
 color {0.1 0.2 0.48 1}
 name SkyBackdrop
 label "stand-in sky (your plate or HDRI goes here)"
 xpos 200
 ypos -200
}
set Nsky [stack 0]
Expression {
 temp_name0 elev
 temp_expr0 {18 + degrees(atan((y / height - 0.5) * 20.25 / 24))}
 temp_name1 az
 temp_expr1 {ShotCamera.rotate.y - degrees(atan((x / width - 0.5) * 36 / 24))}
 temp_name2 top
 temp_expr2 {2.2 + 1.3 * sin(radians(az * 9)) + 0.5 * sin(radians(az * 23 + 40))}
 channel0 {rgba.red -rgba.green -rgba.blue none}
 expr0 {elev < top ? 0.05 : r}
 channel1 {-rgba.red rgba.green -rgba.blue none}
 expr1 {elev < top ? 0.065 : g}
 channel2 {-rgba.red -rgba.green rgba.blue none}
 expr2 {elev < top ? 0.06 : b}
 channel3 depth
 expr3 {elev < top ? 80000 : 0}
 name MountainRidge
 label "stand-in plate with depth.Z (a ridge 8 km away)"
 xpos 2600
 ypos -200
}
set Nridge [stack 0]
Camera2 {
 inputs 0
 translate {0 4500 0}
 rotate {-12 {curve x1001 0 x1100 8} 0}
 focal 24
 haperture 36
 vaperture 20.25
 name CanyonCam
 label "450 m up, looking 12 deg down"
 xpos 3000
 ypos -300
}
set Ncanyoncam [stack 0]
Constant {
 inputs 0
 channels rgba
 color {0.3 0.32 0.36 1}
 name OvercastSky
 label "stand-in overcast sky"
 xpos 3200
 ypos -300
}
Expression {
 temp_name0 elev
 temp_expr0 {-12 + degrees(atan((y / height - 0.5) * 20.25 / 24))}
 temp_name1 az
 temp_expr1 {CanyonCam.rotate.y - degrees(atan((x / width - 0.5) * 36 / 24))}
 temp_name2 wall
 temp_expr2 {min(abs(az) - 11 - 0.7 * (elev + 12) - 2.5 * noise(elev / 2.5, az / 4, 1) - 1.2 * noise(elev * 1.3, az, 2), 9 + 2 * sin(radians(az * 11)) + noise(az / 2, 0, 3) - elev)}
 temp_name3 ridge
 temp_expr3 {elev < 1.2 + 0.8 * sin(radians(az * 9))}
 channel0 {rgba.red rgba.green rgba.blue none}
 expr0 {lerp(elev < -4.3 ? 0.04 + 0.012 * noise(az / 2, elev * 2, 3) : ridge ? 0.16 : r, 0.025 + 0.02 * noise(az / 5, elev * 0.7, 0) + 0.015 * noise(az * 2.5, elev / 5, 7) * noise(az / 2, elev, 9), clamp(wall / 0.2 + 0.5, 0, 1))}
 channel3 depth
 expr3 {wall > 0 ? 9000 + 300 * abs(az) : elev < -4.3 ? 4500 / tan(radians(-elev)) * cos(radians(12)) + 4500 * sin(radians(12)) : ridge ? 60000 : 0}
 name CanyonPlate
 label "stand-in canyon plate with depth.Z"
 xpos 3200
 ypos -200
}
set Ncanyon [stack 0]
Camera2 {
 inputs 0
 translate {0 11300 0}
 rotate {18 {curve x1001 0 x1100 12} 0}
 focal 24
 haperture 36
 vaperture 20.25
 name HighCamera
 label "1130 m up, pitched 18 deg"
 xpos 4000
 ypos -300
}
set Nhighcam [stack 0]
push $Nsky
Expression {
 temp_name0 elev
 temp_expr0 {HighCamera.rotate.x + degrees(atan((y / height - 0.5) * 20.25 / 24)) + (HighCam.earth ? degrees(acos(6371000 / (6371000 + max(HighCamera.translate.y * 0.1, 0)))) : 0)}
 temp_name1 gnd
 temp_expr1 {clamp(-elev / 0.25 + 0.5, 0, 1)}
 temp_name2 far
 temp_expr2 {clamp(-elev / 2.5, 0, 1)}
 channel0 {rgba.red -rgba.green -rgba.blue none}
 expr0 {lerp(r, lerp(0.62, 0.07, far), gnd)}
 channel1 {-rgba.red rgba.green -rgba.blue none}
 expr1 {lerp(g, lerp(0.42, 0.055, far), gnd)}
 channel2 {-rgba.red -rgba.green rgba.blue none}
 expr2 {lerp(b, lerp(0.3, 0.045, far), gnd)}
 name HighPlate
 label "stand-in plate: sky, hazy ground below the horizon"
 xpos 4200
 ypos -200
}
set Nhighsky [stack 0]
Camera2 {
 inputs 0
 translate {0 24000 0}
 rotate {2 0 0}
 focal 60
 haperture 36
 vaperture 20.25
 name SoftCam
 label "long lens on the cloud"
 xpos 4800
 ypos -300
}
set Nsoftcam [stack 0]
push $Nsky
Expression {
 temp_name0 elev
 temp_expr0 {2 + degrees(atan((y / height - 0.5) * 20.25 / 60))}
 temp_name1 hz
 temp_expr1 {pow(clamp(1 - (elev + 3) / 10, 0, 1), 1.5)}
 channel0 {rgba.red -rgba.green -rgba.blue none}
 expr0 {lerp(r, 0.78, hz)}
 channel1 {-rgba.red rgba.green -rgba.blue none}
 expr1 {lerp(g, 0.8, hz)}
 channel2 {-rgba.red -rgba.green rgba.blue none}
 expr2 {lerp(b, 0.82, hz)}
 name SoftPlate
 label "stand-in plate: sky paling into haze"
 xpos 5000
 ypos -200
}
set Nsoftsky [stack 0]
Camera2 {
 inputs 0
 translate {0 {curve x1001 3000 x1012 30000 x1024 3000} {curve x1001 0 x1024 -40000}}
 rotate {{curve x1001 6 x1012 -8 x1024 6} 0 0}
 focal 24
 haperture 36
 vaperture 20.25
 name FlyCam
 label "climbs 300 m to 3 km and dives back, 1001-1024"
 xpos 5600
 ypos -300
}
set Nflycam [stack 0]
BackdropNode {
 inputs 0
 name Backdrop_FairWeather
 label "Fair weather: cumulus + cirrus, sun high to the right"
 note_font_size 20
 tile_color 0x3a5a4aff
 xpos 140
 ypos -40
 bdwidth 360
 bdheight 220
}
push 0
push 0
push $Ncam
push $Nsky
Group {
 inputs 4
 name FairWeather
 knobChanged "k = nuke.thisKnob()\nn = nuke.thisNode()\nlayers = \[]\nif k.name() in ('l1_type', 'l2_type', 'l3_type'):\n    p = k.name()\[:3]\n    t = \{'Cumulus': \{'base': 1400, 'thickness': 1300, 'coverage': 0.43, 'scale_km': 1.6, 'stretch': 1.0, 'wind_deg': 20, 'edge': 0.06, 'taper': 0.6, 'bottom_round': 0.1, 'top_round': 0.25, 'detail_size': 180, 'erosion': 0.45, 'sigma': 0.08, 'cells': 0.0, 'cell_km': 0.5, 'warp': 1.2, 'forward': 0.8, 'ambient': 1.25, 'sky_occlusion': 0.7, 'shadow_depth': 0.0, 'octaves': 4.5, 'billow': 1.0, 'streaks': 0.0, 'vary': 0.08, 'volume': 0, 'vol_shape': 1, 'vol_size': (3000, 1800, 3000), 'lumps': 0.6, 'lump_size': 520, 'small_lumps': 0.3, 'skirt': 0.6, 'place_km': 10, 'wisp_size': 60, 'wisp_amount': 0.0, 'grain_size': 15, 'grain_amount': 0.0, 'swirl': 0.0, 'swirl_size': 400, 'turbulence': 0.0, 'crumble': 0.0, 'crumble_size': 120, 'shear': 0.0, 'fade_top': 0.0, 'fade_bottom': 0.0, 'fade_left': 0.0, 'fade_right': 0.0, 'fade_front': 0.0, 'fade_back': 0.0\}, 'Cumulus Congestus': \{'base': 1400, 'thickness': 4200, 'coverage': 0.42, 'scale_km': 2.2, 'stretch': 1.0, 'wind_deg': 20, 'edge': 0.05, 'taper': 1.4, 'bottom_round': 0.1, 'top_round': 0.12, 'detail_size': 420, 'erosion': 0.4, 'sigma': 0.07, 'cells': 0.0, 'cell_km': 0.5, 'warp': 1.0, 'forward': 0.8, 'ambient': 1.0, 'sky_occlusion': 1.0, 'shadow_depth': 0.0, 'octaves': 4, 'billow': 1.0, 'streaks': 0.0, 'vary': 0.0, 'volume': 0, 'vol_shape': 1, 'vol_size': (3000, 1800, 3000), 'lumps': 0.55, 'lump_size': 1400, 'small_lumps': 0.55, 'skirt': 0.0, 'place_km': 10, 'wisp_size': 60, 'wisp_amount': 0.0, 'grain_size': 15, 'grain_amount': 0.0, 'swirl': 0.0, 'swirl_size': 400, 'turbulence': 0.0, 'crumble': 0.0, 'crumble_size': 120, 'shear': 0.0, 'fade_top': 0.0, 'fade_bottom': 0.0, 'fade_left': 0.0, 'fade_right': 0.0, 'fade_front': 0.0, 'fade_back': 0.0\}, 'Stratocumulus': \{'base': 1300, 'thickness': 600, 'coverage': 0.66, 'scale_km': 1.1, 'stretch': 1.4, 'wind_deg': 20, 'edge': 0.16, 'taper': 0.35, 'bottom_round': 0.15, 'top_round': 0.35, 'detail_size': 120, 'erosion': 0.45, 'sigma': 0.035, 'cells': 0.0, 'cell_km': 0.5, 'warp': 1.8, 'forward': 0.8, 'ambient': 1.0, 'sky_occlusion': 0.7, 'shadow_depth': 0.0, 'octaves': 3, 'billow': 0.8, 'streaks': 0.0, 'vary': 0.3, 'volume': 0, 'vol_shape': 1, 'vol_size': (3000, 1800, 3000), 'lumps': 0.0, 'lump_size': 600, 'small_lumps': 0.0, 'skirt': 0.0, 'place_km': 10, 'wisp_size': 60, 'wisp_amount': 0.0, 'grain_size': 15, 'grain_amount': 0.0, 'swirl': 0.0, 'swirl_size': 400, 'turbulence': 0.0, 'crumble': 0.0, 'crumble_size': 120, 'shear': 0.0, 'fade_top': 0.0, 'fade_bottom': 0.0, 'fade_left': 0.0, 'fade_right': 0.0, 'fade_front': 0.0, 'fade_back': 0.0\}, 'Stratus': \{'base': 500, 'thickness': 450, 'coverage': 0.97, 'scale_km': 4.0, 'stretch': 1.5, 'wind_deg': 20, 'edge': 0.35, 'taper': 0.0, 'bottom_round': 0.35, 'top_round': 0.3, 'detail_size': 220, 'erosion': 0.25, 'sigma': 0.02, 'cells': 0.0, 'cell_km': 0.5, 'warp': 1.0, 'forward': 0.8, 'ambient': 1.0, 'sky_occlusion': 0.5, 'shadow_depth': 0.0, 'octaves': 2, 'billow': 0.2, 'streaks': 0.0, 'vary': 0.3, 'volume': 0, 'vol_shape': 1, 'vol_size': (3000, 1800, 3000), 'lumps': 0.0, 'lump_size': 600, 'small_lumps': 0.0, 'skirt': 0.0, 'place_km': 10, 'wisp_size': 60, 'wisp_amount': 0.0, 'grain_size': 15, 'grain_amount': 0.0, 'swirl': 0.0, 'swirl_size': 400, 'turbulence': 0.0, 'crumble': 0.0, 'crumble_size': 120, 'shear': 0.0, 'fade_top': 0.0, 'fade_bottom': 0.0, 'fade_left': 0.0, 'fade_right': 0.0, 'fade_front': 0.0, 'fade_back': 0.0\}, 'Altocumulus': \{'base': 4200, 'thickness': 350, 'coverage': 0.62, 'scale_km': 2.5, 'stretch': 2.0, 'wind_deg': 20, 'edge': 0.14, 'taper': 0.3, 'bottom_round': 0.25, 'top_round': 0.35, 'detail_size': 60, 'erosion': 0.5, 'sigma': 0.03, 'cells': 0.85, 'cell_km': 0.35, 'warp': 1.6, 'forward': 0.8, 'ambient': 1.0, 'sky_occlusion': 1.0, 'shadow_depth': 0.0, 'octaves': 2.5, 'billow': 0.9, 'streaks': 0.0, 'vary': 0.25, 'volume': 0, 'vol_shape': 1, 'vol_size': (3000, 1800, 3000), 'lumps': 0.0, 'lump_size': 600, 'small_lumps': 0.0, 'skirt': 0.0, 'place_km': 10, 'wisp_size': 60, 'wisp_amount': 0.0, 'grain_size': 15, 'grain_amount': 0.0, 'swirl': 0.0, 'swirl_size': 400, 'turbulence': 0.0, 'crumble': 0.0, 'crumble_size': 120, 'shear': 0.0, 'fade_top': 0.0, 'fade_bottom': 0.0, 'fade_left': 0.0, 'fade_right': 0.0, 'fade_front': 0.0, 'fade_back': 0.0\}, 'Altostratus': \{'base': 3000, 'thickness': 1500, 'coverage': 1.0, 'scale_km': 6.0, 'stretch': 1.5, 'wind_deg': 20, 'edge': 0.4, 'taper': 0.0, 'bottom_round': 0.3, 'top_round': 0.3, 'detail_size': 300, 'erosion': 0.2, 'sigma': 0.006, 'cells': 0.0, 'cell_km': 0.5, 'warp': 1.0, 'forward': 0.85, 'ambient': 1.0, 'sky_occlusion': 0.4, 'shadow_depth': 0.0, 'octaves': 2, 'billow': 0.3, 'streaks': 0.0, 'vary': 0.2, 'volume': 0, 'vol_shape': 1, 'vol_size': (3000, 1800, 3000), 'lumps': 0.0, 'lump_size': 600, 'small_lumps': 0.0, 'skirt': 0.0, 'place_km': 10, 'wisp_size': 60, 'wisp_amount': 0.0, 'grain_size': 15, 'grain_amount': 0.0, 'swirl': 0.0, 'swirl_size': 400, 'turbulence': 0.0, 'crumble': 0.0, 'crumble_size': 120, 'shear': 0.0, 'fade_top': 0.0, 'fade_bottom': 0.0, 'fade_left': 0.0, 'fade_right': 0.0, 'fade_front': 0.0, 'fade_back': 0.0\}, 'Cirrus': \{'base': 9000, 'thickness': 500, 'coverage': 0.5, 'scale_km': 5.0, 'stretch': 7.0, 'wind_deg': 35, 'edge': 0.25, 'taper': 0.0, 'bottom_round': 0.4, 'top_round': 0.4, 'detail_size': 150, 'erosion': 0.6, 'sigma': 0.0012, 'cells': 0.0, 'cell_km': 0.5, 'warp': 2.5, 'forward': 0.85, 'ambient': 1.2, 'sky_occlusion': 1.0, 'shadow_depth': 0.0, 'octaves': 2, 'billow': 0.0, 'streaks': 1.0, 'vary': 0.0, 'volume': 0, 'vol_shape': 1, 'vol_size': (3000, 1800, 3000), 'lumps': 0.0, 'lump_size': 600, 'small_lumps': 0.0, 'skirt': 0.0, 'place_km': 10, 'wisp_size': 60, 'wisp_amount': 0.0, 'grain_size': 15, 'grain_amount': 0.0, 'swirl': 0.0, 'swirl_size': 400, 'turbulence': 0.0, 'crumble': 0.0, 'crumble_size': 120, 'shear': 0.0, 'fade_top': 0.0, 'fade_bottom': 0.0, 'fade_left': 0.0, 'fade_right': 0.0, 'fade_front': 0.0, 'fade_back': 0.0\}, 'Cirrocumulus': \{'base': 7500, 'thickness': 250, 'coverage': 0.55, 'scale_km': 3.0, 'stretch': 2.5, 'wind_deg': -30, 'edge': 0.15, 'taper': 0.0, 'bottom_round': 0.35, 'top_round': 0.35, 'detail_size': 40, 'erosion': 0.45, 'sigma': 0.008, 'cells': 1.0, 'cell_km': 0.22, 'warp': 2.0, 'forward': 0.85, 'ambient': 1.0, 'sky_occlusion': 1.0, 'shadow_depth': 0.0, 'octaves': 2, 'billow': 0.7, 'streaks': 0.0, 'vary': 0.0, 'volume': 0, 'vol_shape': 1, 'vol_size': (3000, 1800, 3000), 'lumps': 0.0, 'lump_size': 600, 'small_lumps': 0.0, 'skirt': 0.0, 'place_km': 10, 'wisp_size': 60, 'wisp_amount': 0.0, 'grain_size': 15, 'grain_amount': 0.0, 'swirl': 0.0, 'swirl_size': 400, 'turbulence': 0.0, 'crumble': 0.0, 'crumble_size': 120, 'shear': 0.0, 'fade_top': 0.0, 'fade_bottom': 0.0, 'fade_left': 0.0, 'fade_right': 0.0, 'fade_front': 0.0, 'fade_back': 0.0\}, 'Hero Cumulus': \{'base': 1400, 'thickness': 1000, 'coverage': 0.5, 'scale_km': 2.0, 'stretch': 1.0, 'wind_deg': 20, 'edge': 0.06, 'taper': 0.0, 'bottom_round': 0.04, 'top_round': 0.3, 'detail_size': 220, 'erosion': 0.45, 'sigma': 0.06, 'cells': 0.0, 'cell_km': 0.5, 'warp': 1.2, 'forward': 0.8, 'ambient': 1.0, 'sky_occlusion': 1.0, 'shadow_depth': 0.0, 'octaves': 3, 'billow': 1.0, 'streaks': 0.0, 'vary': 0.0, 'volume': 1, 'vol_shape': 1, 'vol_size': (5000, 2600, 4000), 'lumps': 0.8, 'lump_size': 900, 'small_lumps': 0.35, 'skirt': 0.0, 'place_km': 12, 'wisp_size': 80, 'wisp_amount': 0.08, 'grain_size': 20, 'grain_amount': 0.04, 'swirl': 0.0, 'swirl_size': 400, 'turbulence': 0.0, 'crumble': 0.0, 'crumble_size': 120, 'shear': 0.0, 'fade_top': 0.0, 'fade_bottom': 0.0, 'fade_left': 0.0, 'fade_right': 0.0, 'fade_front': 0.0, 'fade_back': 0.0\}, 'Towering Cumulus': \{'base': 1500, 'thickness': 1000, 'coverage': 0.55, 'scale_km': 2.0, 'stretch': 1.0, 'wind_deg': 20, 'edge': 0.06, 'taper': 0.0, 'bottom_round': 0.04, 'top_round': 0.3, 'detail_size': 2