 l3_detail_size 150
 addUserKnob {7 l3_wisp_amount l wisps t "Fine wisps that eat into the thin edges."}
 addUserKnob {7 l3_wisp_size l "wisp size" t "Size of the wisps, in metres." R 2 500}
 l3_wisp_size 60
 addUserKnob {7 l3_grain_amount l grain t "The finest breakup of the edges."}
 addUserKnob {7 l3_grain_size l "grain size" t "Size of the grain, in metres." R 1 100}
 l3_grain_size 15
 addUserKnob {7 l3_swirl l swirl t "Curls the detail around, for swirly wisps."}
 addUserKnob {7 l3_swirl_size l "swirl size" t "Size of the swirls, in metres." R 20 3000}
 l3_swirl_size 400
 addUserKnob {7 l3_turbulence l turbulence t "A finer, second swirl (a third the size) that makes the edges roll and churn; animate 'evolve' to boil it."}
 addUserKnob {7 l3_crumble l crumble t "Bites chunks out of the thin edges, for torn, ragged cloud and fog."}
 addUserKnob {7 l3_crumble_size l "crumble size" t "Size of the chunks crumble bites out, in metres." R 5 1000}
 l3_crumble_size 120
 addUserKnob {7 l3_shear l "wind shear" t "Leans the tops downwind (along 'wind direction')." R -1 1}
 addUserKnob {26 l3_more_divider l "" +STARTLINE}
 addUserKnob {7 l3_density l density t "Multiplies the cloud density."}
 l3_density 1
 addUserKnob {7 l3_wind_speed l "wind speed" t "Drift along the wind direction, m/s."}
 l3_wind_speed 5
 addUserKnob {7 l3_seed l seed t "Changes this layer's clouds."}
 l3_seed 22
 addUserKnob {20 l3_shape l "more shape" n 2}
 addUserKnob {7 l3_stretch l stretch t "Elongation along the wind (1 = round)." R 1 10}
 l3_stretch 7
 addUserKnob {7 l3_edge l "edge softness" t "Softness of the cloud edges." R 0.01 0.5}
 l3_edge 0.25
 addUserKnob {7 l3_taper l domes t "How much the clouds narrow going up: cumulus domes and towers." R 0 2}
 addUserKnob {7 l3_bottom_round l "base rounding" t "Rounding at the base, as a share of the thickness (small = flat base)."}
 l3_bottom_round 0.4
 addUserKnob {7 l3_top_round l "top rounding" t "Rounding at the top, as a share of the thickness."}
 l3_top_round 0.4
 addUserKnob {7 l3_sigma l "thickness of cloud" t "Extinction per metre: high is dense and hard edged, low is thin and veil-like." R 0.0005 0.1}
 l3_sigma 0.0012
 addUserKnob {7 l3_cells l cells t "Cellular rows (altocumulus, cirrocumulus)."}
 addUserKnob {7 l3_cell_km l "cell size" t "Size of the cells, in km." R 0.05 2}
 l3_cell_km 0.5
 addUserKnob {7 l3_warp l warp t "How much the shapes swirl." R 0 4}
 l3_warp 2.5
 addUserKnob {7 l3_forward l "forward scatter" t "How much light the clouds throw forward: the silver lining when backlit." R 0 0.95}
 l3_forward 0.85
 addUserKnob {7 l3_ambient l "sky light" t "How much sky light the layer takes." R 0 3}
 l3_ambient 1.2
 addUserKnob {7 l3_sky_occlusion l "sky occlusion" t "How much the cloud above darkens the sky light below it: deeper undersides and folds. Lower it for tall storms and thick overcast, which go flat grey under their own mass." R 0 2}
