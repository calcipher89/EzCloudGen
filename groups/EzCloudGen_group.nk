set cut_paste_input [stack 0]
version 15.1 v3
push $cut_paste_input
Group {
 name EzCloudGen
 knobChanged "k = nuke.thisKnob()\nn = nuke.thisNode()\nlayers = \[]\nif k.name() in ('l1_type', 'l2_type', 'l3_type'):\n    p = k.name()\[:3]\n    t = \{'Cumulus': \{'base': 1400, 'thickness': 1300, 'coverage': 0.42, 'scale_km': 1.6, 'stretch': 1.0, 'wind_deg': 20, 'edge': 0.06, 'taper': 0.85, 'bottom_round': 0.04, 'top_round': 0.15, 'detail_size': 220, 'erosion': 0.45, 'sigma': 0.06, 'cells': 0.0, 'cell_km': 0.5, 'warp': 1.2, 'forward': 0.8, 'ambient': 1.0, 'octaves': 3.5, 'billow': 1.0, 'streaks': 0.0, 'vary': 0.0, 'volume': 0, 'vol_shape': 1, 'vol_size': (3000, 1800, 3000), 'lumps': 0.5, 'lump_size': 600, 'place_km': 10, 'wisp_size': 60, 'wisp_amount': 0.0, 'grain_size': 15, 'grain_amount': 0.0, 'swirl': 0.0, 'swirl_size': 400, 'shear': 0.0\}, 'Cumulus Congestus': \{'base': 1400, 'thickness': 4200, 'coverage': 0.42, 'scale_km': 2.2, 'stretch': 1.0, 'wind_deg': 20, 'edge': 0.05, 'taper': 1.4, 'bottom_round': 0.02, 'top_round': 0.12, 'detail_size': 420, 'erosion': 0.4, 'sigma': 0.07, 'cells': 0.0, 'cell_km': 0.5, 'warp': 1.0, 'forward': 0.8, 'ambient': 1.0, 'octaves': 4, 'billow': 1.0, 'streaks': 0.0, 'vary': 0.0, 'volume': 0, 'vol_shape': 1, 'vol_size': (3000, 1800, 3000), 'lumps': 0.5, 'lump_size': 600, 'place_km': 10, 'wisp_size': 60, 'wisp_amount': 0.0, 'grain_size': 15, 'grain_amount': 0.0, 'swirl': 0.0, 'swirl_size': 400, 'shear': 0.0\}, 'Stratocumulus': \{'base': 1300, 'thickness': 600, 'coverage': 0.66, 'scale_km': 1.1, 'stretch': 1.4, 'wind_deg': 20, 'edge': 0.16, 'taper': 0.35, 'bottom_round': 0.15, 'top_round': 0.35, 'detail_size': 120, 'erosion': 0.45, 'sigma': 0.035, 'cells': 0.0, 'cell_km': 0.5, 'warp': 1.8, 'forward': 0.8, 'ambient': 1.0, 'octaves': 3, 'billow': 0.8, 'streaks': 0.0, 'vary': 0.15, 'volume': 0, 'vol_shape': 1, 'vol_size': (3000, 1800, 3000), 'lumps': 0.5, 'lump_size': 600, 'place_km': 10, 'wisp_size': 60, 'wisp_amount': 0.0, 'grain_size': 15, 'grain_amount': 0.0, 'swirl': 0.0, 'swirl_size': 400, 'shear': 0.0\}, 'Stratus': \{'base': 500, 'thickness': 450, 'coverage': 0.97, 'scale_km': 4.0, 'stretch': 1.5, 'wind_deg': 20, 'edge': 0.35, 'taper': 0.0, 'bottom_round': 0.35, 'top_round': 0.3, 'detail_size': 220, 'erosion': 0.25, 'sigma': 0.02, 'cells': 0.0, 'cell_km': 0.5, 'warp': 1.0, 'forward': 0.8, 'ambient': 1.0, 'octaves': 2, 'billow': 0.2, 'streaks': 0.0, 'vary': 0.3, 'volume': 0, 'vol_shape': 1, 'vol_size': (3000, 1800, 3000), 'lumps': 0.5, 'lump_size': 600, 'place_km': 10, 'wisp_size': 60, 'wisp_amount': 0.0, 'grain_size': 15, 'grain_amount': 0.0, 'swirl': 0.0, 'swirl_size': 400, 'shear': 0.0\}, 'Altocumulus': \{'base': 4200, 'thickness': 350, 'coverage': 0.62, 'scale_km': 2.5, 'stretch': 2.0, 'wind_deg': 20, 'edge': 0.14, 'taper': 0.3, 'bottom_round': 0.25, 'top_round': 0.35, 'detail_size': 60, 'erosion': 0.5, 'sigma': 0.03, 'cells': 0.85, 'cell_km': 0.35, 'warp': 1.6, 'forward': 0.8, 'ambient': 1.0, 'octaves': 2.5, 'billow': 0.9, 'streaks': 0.0, 'vary': 0.0, 'volume': 0, 'vol_shape': 1, 'vol_size': (3000, 1800, 3000), 'lumps': 0.5, 'lump_size': 600, 'place_km': 10, 'wisp_size': 60, 'wisp_amount': 0.0, 'grain_size': 15, 'grain_amount': 0.0, 'swirl': 0.0, 'swirl_size': 400, 'shear': 0.0\}, 'Altostratus': \{'base': 3000, 'thickness': 1500, 'coverage': 1.0, 'scale_km': 6.0, 'stretch': 1.5, 'wind_deg': 20, 'edge': 0.4, 'taper': 0.0, 'bottom_round': 0.3, 'top_round': 0.3, 'detail_size': 300, 'erosion': 0.2, 'sigma': 0.006, 'cells': 0.0, 'cell_km': 0.5, 'warp': 1.0, 'forward': 0.85, 'ambient': 1.0, 'octaves': 2, 'billow': 0.3, 'streaks': 0.0, 'vary': 0.2, 'volume': 0, 'vol_shape': 1, 'vol_size': (3000, 1800, 3000), 'lumps': 0.5, 'lump_size': 600, 'place_km': 10, 'wisp_size': 60, 'wisp_amount': 0.0, 'grain_size': 15, 'grain_amount': 0.0, 'swirl': 0.0, 'swirl_size': 400, 'shear': 0.0\}, 'Cirrus': \{'base': 9000, 'thickness': 500, 'coverage': 0.5, 'scale_km': 5.0, 'stretch': 7.0, 'wind_deg': 35, 'edge': 0.25, 'taper': 0.0, 'bottom_round': 0.4, 'top_round': 0.4, 'detail_size': 150, 'erosion': 0.6, 'sigma': 0.0012, 'cells': 0.0, 'cell_km': 0.5, 'warp': 2.5, 'forward': 0.85, 'ambient': 1.2, 'octaves': 2, 'billow': 0.0, 'streaks': 1.0, 'vary': 0.0, 'volume': 0, 'vol_shape': 1, 'vol_size': (3000, 1800, 3000), 'lumps': 0.5, 'lump_size': 600, 'place_km': 10, 'wisp_size': 60, 'wisp_amount': 0.0, 'grain_size': 15, 'grain_amount': 0.0, 'swirl': 0.0, 'swirl_size': 400, 'shear': 0.0\}, 'Cirrocumulus': \{'base': 7500, 'thickness': 250, 'coverage': 0.55, 'scale_km': 3.0, 'stretch': 2.5, 'wind_deg': -30, 'edge': 0.15, 'taper': 0.0, 'bottom_round': 0.35, 'top_round': 0.35, 'detail_size': 40, 'erosion': 0.45, 'sigma': 0.008, 'cells': 1.0, 'cell_km': 0.22, 'warp': 2.0, 'forward': 0.85, 'ambient': 1.0, 'octaves': 2, 'billow': 0.7, 'streaks': 0.0, 'vary': 0.0, 'volume': 0, 'vol_shape': 1, 'vol_size': (3000, 1800, 3000), 'lumps': 0.5, 'lump_size': 600, 'place_km': 10, 'wisp_size': 60, 'wisp_amount': 0.0, 'grain_size': 15, 'grain_amount': 0.0, 'swirl': 0.0, 'swirl_size': 400, 'shear': 0.0\}, 'Hero Cumulus': \{'base': 1400, 'thickness': 1000, 'coverage': 0.5, 'scale_km': 2.0, 'stretch': 1.0, 'wind_deg': 20, 'edge': 0.06, 'taper': 0.0, 'bottom_round': 0.04, 'top_round': 0.3, 'detail_size': 220, 'erosion': 0.45, 'sigma': 0.06, 'cells': 0.0, 'cell_km': 0.5, 'warp': 1.2, 'forward': 0.8, 'ambient': 1.0, 'octaves': 3.5, 'billow': 1.0, 'streaks': 0.0, 'vary': 0.0, 'volume': 1, 'vol_shape': 1, 'vol_size': (5000, 2600, 4000), 'lumps': 0.8, 'lump_size': 900, 'place_km': 12, 'wisp_size': 80, 'wisp_amount': 0.3, 'grain_size': 20, 'grain_amount': 0.2, 'swirl': 0.0, 'swirl_size': 400, 'shear': 0.0\}, 'Storm Anvil': \{'base': 1200, 'thickness': 1000, 'coverage': 0.5, 'scale_km': 2.0, 'stretch': 1.0, 'wind_deg': 20, 'edge': 0.05, 'taper': 0.0, 'bottom_round': 0.02, 'top_round': 0.3, 'detail_size': 450, 'erosion': 0.4, 'sigma': 0.07, 'cells': 0.0, 'cell_km': 0.5, 'warp': 1.5, 'forward': 0.8, 'ambient': 1.0, 'octaves': 4, 'billow': 1.0, 'streaks': 0.0, 'vary': 0.0, 'volume': 1, 'vol_shape': 2, 'vol_size': (9000, 11000, 9000), 'lumps': 0.6, 'lump_size': 1500, 'place_km': 40, 'wisp_size': 200, 'wisp_amount': 0.4, 'grain_size': 15, 'grain_amount': 0.0, 'swirl': 0.0, 'swirl_size': 400, 'shear': 0.3\}, 'Fog Bank': \{'base': 0, 'thickness': 1000, 'coverage': 0.5, 'scale_km': 2.0, 'stretch': 1.0, 'wind_deg': 20, 'edge': 0.3, 'taper': 0.0, 'bottom_round': 0.4, 'top_round': 0.3, 'detail_size': 120, 'erosion': 0.3, 'sigma': 0.01, 'cells': 0.0, 'cell_km': 0.5, 'warp': 1.5, 'forward': 0.7, 'ambient': 1.2, 'octaves': 2, 'billow': 0.2, 'streaks': 0.0, 'vary': 0.0, 'volume': 1, 'vol_shape': 3, 'vol_size': (8000, 600, 8000), 'lumps': 0.6, 'lump_size': 600, 'place_km': 6, 'wisp_size': 40, 'wisp_amount': 0.6, 'grain_size': 15, 'grain_amount': 0.0, 'swirl': 0.4, 'swirl_size': 200, 'shear': 0.0\}, 'Puff': \{'base': 800, 'thickness': 1000, 'coverage': 0.5, 'scale_km': 2.0, 'stretch': 1.0, 'wind_deg': 20, 'edge': 0.08, 'taper': 0.0, 'bottom_round': 0.08, 'top_round': 0.3, 'detail_size': 60, 'erosion': 0.5, 'sigma': 0.05, 'cells': 0.0, 'cell_km': 0.5, 'warp': 1.5, 'forward': 0.8, 'ambient': 1.0, 'octaves': 3, 'billow': 1.0, 'streaks': 0.0, 'vary': 0.0, 'volume': 1, 'vol_shape': 0, 'vol_size': (600, 450, 600), 'lumps': 0.4, 'lump_size': 150, 'place_km': 2, 'wisp_size': 20, 'wisp_amount': 0.4, 'grain_size': 6, 'grain_amount': 0.3, 'swirl': 0.0, 'swirl_size': 400, 'shear': 0.0\}\}\n    for key, v in t\[k.value()].items():\n        if n.knob(p + key) is not None:\n            n\[p + key].setValue(list(v) if isinstance(v, tuple) else v)\n    # A PyScript button can't be executed from inside knobChanged ('already executing'), so\n    # its code runs here. Every volume type re-places (base and distance come with the type),\n    # unless the position is animated or linked.\n    if n\[p + 'volume'].value() > 0.5 and not n\[p + 'vol_position'].isAnimated():\n        exec(n\[p + 'place'].value(), \{'nuke': nuke\})\n    layers = \[p]\nelif k.name() == 'showPanel':\n    layers = \['l1_', 'l2_', 'l3_']\nfor p in layers:\n    vol = n\[p + 'volume'].value() > 0.5\n    for name in \['thickness', 'scale_km', 'stretch', 'taper', 'top_round', 'cells', 'cell_km', 'warp', 'streaks', 'vary']:\n        n\[p + name].setVisible(not vol)\n    for name in \['vol_divider', 'vol_shape', 'vol_position', 'vol_rotate', 'vol_size', 'place', 'place_km', 'lumps', 'lump_size']:\n        n\[p + name].setVisible(vol)\n"
 tile_color 0x8fb3d9ff
 selected true
 addUserKnob {20 ezcloudgen l EzCloudGen}
 addUserKnob {4 view t "Comp: the clouds over 'bg' (or alone without it). Clouds: the clouds alone, premultiplied. Sun share: the direct sunlight part of the clouds. Depth: Planar Z of the clouds, scene units." M {Comp Clouds "Sun share" Depth}}
 addUserKnob {6 breakout l "breakout layers" t "Adds the layers cloud (rgba), cloud_sun and cloud_sky (rgb), for re-grading the clouds over the plate. Takes a second pass per layer." -STARTLINE}
 breakout true
 addUserKnob {4 resolution t "Render the clouds smaller and scale them back up: much faster, softer." M {Full Half Quarter}}
 resolution Half
 addUserKnob {7 quality t "Ray march step count: higher is smoother and slower." R 0.25 4}
 quality 1
 addUserKnob {3 samples t "Jittered samples per pixel: anti-aliasing and less grain."}
 samples 1
 addUserKnob {7 max_distance l "max distance" t "Clouds further than this (km) are not drawn." R 5 200}
 max_distance 80
 addUserKnob {26 scene_divider l scene}
 addUserKnob {7 scene_scale l "units to metres" t "Scene units to metres: 0.1 for decimetres."}
 scene_scale 0.1
 addUserKnob {7 ground_height l "ground height" t "Height of the ground in scene units; the camera's height above it places it under the clouds." R -10000 10000}
 addUserKnob {26 sun_divider l sun}
 addUserKnob {4 sun_from l "sun from" t "Auto: the Axis in 'sun' if there is one, else the EzAtmosScatter in 'atmos', else 'sun direction'." M {Auto Axis EzAtmosScatter Manual}}
 addUserKnob {13 sun_direction l "sun direction" t "Direction towards the sun, +Y up."}
 sun_direction {0.3 0.35 -1}
 addUserKnob {13 sun_in_use l "sun in use" t "The sun direction being used (read only)." +DISABLED}
 sun_in_use {{"sun_source==1 ? axis_position.x : sun_source==2 ? atm_sun.x : sun_direction.x"} {"sun_source==1 ? axis_position.y : sun_source==2 ? atm_sun.y : sun_direction.y"} {"sun_source==1 ? axis_position.z : sun_source==2 ? atm_sun.z : sun_direction.z"}}
 addUserKnob {4 light_from l "light from" t "Auto: the sun and sky light the EzAtmosScatter in 'atmos' measures in its HDRI. Manual (or no atmos): 'sun color' and 'sky color'." M {Auto Manual}}
 addUserKnob {18 sun_color l "sun color" t "Sunlight (irradiance) when the light is Manual."}
 sun_color {12 11.3 10}
 addUserKnob {18 sky_color l "sky color" t "Sky light (radiance) when the light is Manual."}
 sky_color {0.12 0.25 0.58}
 addUserKnob {18 ground_color l "ground bounce" t "Light bounced up from the ground onto the cloud bases."}
 ground_color {0.08 0.07 0.06}
 addUserKnob {7 sun_intensity l "sun intensity" t "Multiplies the sunlight."}
 sun_intensity 1
 addUserKnob {7 sky_intensity l "sky intensity" t "Multiplies the sky light."}
 sky_intensity 1
 addUserKnob {26 haze_divider l air}
 addUserKnob {7 haze_distance l "haze distance" t "Distance (km) over which far clouds fade into the haze colour. 0: off." R 0 200}
 haze_distance 60
 addUserKnob {18 haze_color l "haze color" t "Colour far clouds fade to. With the light from an atmos it multiplies the atmos's sky colour."}
 haze_color {1.4 1.35 1.3}
 addUserKnob {26 gap_divider l "sun gap"}
 addUserKnob {7 gap_amount l "gap toward sun" t "Opens a hole in every layer where the line from the camera to the sun crosses it, so the sun and EzCloudShafts' shafts come through."}
 addUserKnob {7 gap_size l "gap size" t "Radius of the gap, in km."}
 gap_size 2
 addUserKnob {26 time_divider l time}
 addUserKnob {7 evolve_speed l evolve t "How fast the cloud detail boils, in metres per second."}
 evolve_speed 0.5
 addUserKnob {7 seed t "Changes every layer's clouds."}
 addUserKnob {20 l1_tab l "Layer 1"}
 addUserKnob {6 l1_enable l enable t "Draw this layer. Layers sort themselves by depth." -STARTLINE}
 l1_enable true
 addUserKnob {4 l1_type l type t "Sets this layer's shape knobs to the type's values (they can be tuned after)." M {Cumulus "Cumulus Congestus" Stratocumulus Stratus Altocumulus Altostratus Cirrus Cirrocumulus "Hero Cumulus" "Storm Anvil" "Fog Bank" Puff}}
 addUserKnob {7 l1_base l "base height" t "Height of the cloud base above the ground, in metres." R 0 12000}
 l1_base 1400
 addUserKnob {7 l1_thickness l thickness t "Depth of the layer, base to top, in metres." R 50 6000}
 l1_thickness 1300
 addUserKnob {7 l1_coverage l coverage t "How much of the sky the layer covers."}
 l1_coverage 0.42
 addUserKnob {7 l1_scale_km l size t "Size of the cloud shapes across the ground, in km." R 0.1 10}
 l1_scale_km 1.6
 addUserKnob {7 l1_wind_deg l "wind direction" t "Direction the shapes stretch and drift along, in degrees (0 = away from the world -Z axis, 90 = +X)." R -180 180}
 l1_wind_deg 20
 addUserKnob {26 l1_vol_divider l volume +HIDDEN}
 addUserKnob {4 l1_vol_shape l shape t "The volume's overall shape, before lumps and erosion break it up." +HIDDEN M {Ellipsoid Dome Anvil Box}}
 l1_vol_shape Dome
 addUserKnob {13 l1_vol_position l position t "Centre of the volume's base, in scene units (drag it in the 3D viewer, or link it to an Axis)." +HIDDEN}
 addUserKnob {13 l1_vol_rotate l rotate t "Turns the volume, in degrees (Y, then X, then Z)." +HIDDEN}
 addUserKnob {13 l1_vol_size l size t "Width, height and depth of the volume, in metres." +HIDDEN}
 l1_vol_size {3000 1800 3000}
 addUserKnob {22 l1_place l "place in front of camera" t "Puts the volume 'distance' ahead of the camera, on the ground at 'base height'." -STARTLINE +HIDDEN T "n = nuke.thisNode()\nm = n\['cam_world_matrix']\ns = n\['scene_scale'].value() or 1.0\nfx, fz = -m.getValue(2), -m.getValue(10)\nl = (fx * fx + fz * fz) ** 0.5\nif l < 1e-6:\n    fx, fz, l = 0.0, -1.0, 1.0\nd = n\['l1_place_km'].value() * 1000.0 / s\nn\['l1_vol_position'].setValue(\[m.getValue(3) + fx / l * d, n\['ground_height'].value() + n\['l1_base'].value() / s, m.getValue(11) + fz / l * d])\n"}
 addUserKnob {7 l1_place_km l distance t "How far ahead 'place in front of camera' puts it, km." -STARTLINE +HIDDEN}
 l1_place_km 10
 addUserKnob {7 l1_lumps l lumps t "Big noise that breaks the shape into towers and bulges." +HIDDEN R 0 1.5}
 l1_lumps 0.5
 addUserKnob {7 l1_lump_size l "lump size" t "Size of the lumps, in metres." +HIDDEN R 20 5000}
 l1_lump_size 600
 addUserKnob {26 l1_erosion_divider l erosion}
 addUserKnob {7 l1_erosion l billows t "How much the billows (cauliflower bumps, or soft wisps with 'billow' at 0) break up the surface."}
 l1_erosion 0.45
 addUserKnob {7 l1_detail_size l "billow size" t "Size of the billows, in metres." R 10 1000}
 l1_detail_size 220
 addUserKnob {7 l1_wisp_amount l wisps t "Fine wisps that eat into the thin edges."}
 addUserKnob {7 l1_wisp_size l "wisp size" t "Size of the wisps, in metres." R 2 500}
 l1_wisp_size 60
 addUserKnob {7 l1_grain_amount l grain t "The finest breakup of the edges."}
 addUserKnob {7 l1_grain_size l "grain size" t "Size of the grain, in metres." R 1 100}
 l1_grain_size 15
 addUserKnob {7 l1_swirl l swirl t "Curls the detail around, for swirly wisps."}
 addUserKnob {7 l1_swirl_size l "swirl size" t "Size of the swirls, in metres." R 20 3000}
 l1_swirl_size 400
 addUserKnob {7 l1_shear l "wind shear" t "Leans the tops downwind (along 'wind direction')." R -1 1}
 addUserKnob {26 l1_more_divider l "" +STARTLINE}
 addUserKnob {7 l1_density l density t "Multiplies the cloud density."}
 l1_density 1
 addUserKnob {7 l1_wind_speed l "wind speed" t "Drift along the wind direction, m/s."}
 l1_wind_speed 5
 addUserKnob {7 l1_seed l seed t "Changes this layer's clouds."}
 addUserKnob {20 l1_shape l "more shape" n 2}
 addUserKnob {7 l1_stretch l stretch t "Elongation along the wind (1 = round)." R 1 10}
 l1_stretch 1
 addUserKnob {7 l1_edge l "edge softness" t "Softness of the cloud edges." R 0.01 0.5}
 l1_edge 0.06
 addUserKnob {7 l1_taper l domes t "How much the clouds narrow going up: cumulus domes and towers." R 0 2}
 l1_taper 0.85
 addUserKnob {7 l1_bottom_round l "base rounding" t "Rounding at the base, as a share of the thickness (small = flat base)."}
 l1_bottom_round 0.04
 addUserKnob {7 l1_top_round l "top rounding" t "Rounding at the top, as a share of the thickness."}
 l1_top_round 0.15
 addUserKnob {7 l1_sigma l "thickness of cloud" t "Extinction per metre: high is dense and hard edged, low is thin and veil-like." R 0.0005 0.1}
 l1_sigma 0.06
 addUserKnob {7 l1_cells l cells t "Cellular rows (altocumulus, cirrocumulus)."}
 addUserKnob {7 l1_cell_km l "cell size" t "Size of the cells, in km." R 0.05 2}
 l1_cell_km 0.5
 addUserKnob {7 l1_warp l warp t "How much the shapes swirl." R 0 4}
 l1_warp 1.2
 addUserKnob {7 l1_forward l "forward scatter" t "How much light the clouds throw forward: the silver lining when backlit." R 0 0.95}
 l1_forward 0.8
 addUserKnob {7 l1_ambient l "sky light" t "How much sky light the layer takes." R 0 3}
 l1_ambient 1
 addUserKnob {7 l1_octaves l "detail octaves" t "Detail levels (more is finer and slower)." R 0 5}
 l1_octaves 3.5
 addUserKnob {7 l1_billow l billows t "1: billowy cauliflower detail. 0: soft wisps."}
 l1_billow 1
 addUserKnob {7 l1_streaks l streaks t "1: fibrous streaks (cirrus)."}
 addUserKnob {7 l1_vary l "height variation" t "How much the base and top move up and down across the deck." R 0 0.5}
 addUserKnob {20 l1_shape_end l "" -STARTLINE n -1}
 addUserKnob {3 l1_volume +INVISIBLE}
 addUserKnob {20 l2_tab l "Layer 2"}
 addUserKnob {6 l2_enable l enable t "Draw this layer. Layers sort themselves by depth." -STARTLINE}
 addUserKnob {4 l2_type l type t "Sets this layer's shape knobs to the type's values (they can be tuned after)." M {Cumulus "Cumulus Congestus" Stratocumulus Stratus Altocumulus Altostratus Cirrus Cirrocumulus "Hero Cumulus" "Storm Anvil" "Fog Bank" Puff}}
 l2_type "Hero Cumulus"
 addUserKnob {7 l2_base l "base height" t "Height of the cloud base above the ground, in metres." R 0 12000}
 l2_base 1400
 addUserKnob {7 l2_thickness l thickness t "Depth of the layer, base to top, in metres." +HIDDEN R 50 6000}
 l2_thickness 1000
 addUserKnob {7 l2_coverage l coverage t "How much of the sky the layer covers."}
 l2_coverage 0.5
 addUserKnob {7 l2_scale_km l size t "Size of the cloud shapes across the ground, in km." +HIDDEN R 0.1 10}
 l2_scale_km 2
 addUserKnob {7 l2_wind_deg l "wind direction" t "Direction the shapes stretch and drift along, in degrees (0 = away from the world -Z axis, 90 = +X)." R -180 180}
 l2_wind_deg 20
 addUserKnob {26 l2_vol_divider l volume}
 addUserKnob {4 l2_vol_shape l shape t "The volume's overall shape, before lumps and erosion break it up." M {Ellipsoid Dome Anvil Box}}
 l2_vol_shape Dome
 addUserKnob {13 l2_vol_position l position t "Centre of the volume's base, in scene units (drag it in the 3D viewer, or link it to an Axis)."}
 l2_vol_position {0 14000 -120000}
 addUserKnob {13 l2_vol_rotate l rotate t "Turns the volume, in degrees (Y, then X, then Z)."}
 addUserKnob {13 l2_vol_size l size t "Width, height and depth of the volume, in metres."}
 l2_vol_size {5000 2600 4000}
 addUserKnob {22 l2_place l "place in front of camera" t "Puts the volume 'distance' ahead of the camera, on the ground at 'base height'." -STARTLINE T "n = nuke.thisNode()\nm = n\['cam_world_matrix']\ns = n\['scene_scale'].value() or 1.0\nfx, fz = -m.getValue(2), -m.getValue(10)\nl = (fx * fx + fz * fz) ** 0.5\nif l < 1e-6:\n    fx, fz, l = 0.0, -1.0, 1.0\nd = n\['l2_place_km'].value() * 1000.0 / s\nn\['l2_vol_position'].setValue(\[m.getValue(3) + fx / l * d, n\['ground_height'].value() + n\['l2_base'].value() / s, m.getValue(11) + fz / l * d])\n"}
 addUserKnob {7 l2_place_km l distance t "How far ahead 'place in front of camera' puts it, km." -STARTLINE}
 l2_place_km 12
