  KernelDescription "3 \"EzCloudGen\" iterate pixelWise 07b70ac4d4dd0c003215fc3b2d69cca89080750ebe83e523d8807ec007e0a1bd 2 \"src\" Read Point \"dst\" Write Point 62 \"output\" Int 1 AAAAAA== \"cam_row0\" Float 3 AACAPwAAAAAAAAAAAAAAAA== \"cam_row1\" Float 3 AAAAAAAAgD8AAAAAAAAAAA== \"cam_row2\" Float 3 AAAAAAAAAAAAAIA/AAAAAA== \"cam_position\" Float 3 AAAAAACAO0UAAAAAAAAAAA== \"focal\" Float 1 AADAQQ== \"haperture\" Float 1 AAAQQg== \"frame_size\" Float 2 AADwRAAAh0Q= \"scene_scale\" Float 1 zczMPQ== \"ground_height\" Float 1 AAAAAA== \"sun_direction\" Float 3 AAAAAAAAAD8AAIC/AAAAAA== \"sun_rotation\" Float 1 AAAAAA== \"sun_color\" Float 3 AACAPzMzcz+amVk/AAAAAA== \"sky_color\" Float 3 mpmZPmZm5j7NzEw/AAAAAA== \"ground_color\" Float 3 j8L1Pa5H4T3sUbg9AAAAAA== \"haze_color\" Float 3 mpkZP3sULj/NzEw/AAAAAA== \"haze_distance\" Float 1 AGBqRw== \"max_distance\" Float 1 AECcRw== \"quality\" Float 1 AACAPw== \"samples\" Int 1 AQAAAA== \"seed\" Float 1 AAAAAA== \"evolve\" Float 1 AAAAAA== \"offset\" Float 2 AAAAAAAAAAA= \"gap_amount\" Float 1 AAAAAA== \"gap_size\" Float 1 AAD6RA== \"base\" Float 1 AACvRA== \"thickness\" Float 1 AICiRA== \"coverage\" Float 1 PQrXPg== \"scale_km\" Float 1 zczMPw== \"stretch\" Float 1 AACAPw== \"wind_deg\" Float 1 AACgQQ== \"edge\" Float 1 j8J1PQ== \"taper\" Float 1 mplZPw== \"bottom_round\" Float 1 CtcjPQ== \"top_round\" Float 1 mpkZPg== \"detail_size\" Float 1 AABcQw== \"erosion\" Float 1 ZmbmPg== \"sigma\" Float 1 j8J1PQ== \"cells\" Float 1 AAAAAA== \"cell_km\" Float 1 AAAAPw== \"warp\" Float 1 mpmZPw== \"forward\" Float 1 zcxMPw== \"ambient\" Float 1 AACAPw== \"octaves\" Float 1 AABgQA== \"billow\" Float 1 AACAPw== \"streaks\" Float 1 AAAAAA== \"vary\" Float 1 AAAAAA== \"density\" Float 1 AACAPw== \"volume\" Int 1 AAAAAA== \"vol_shape\" Int 1 AQAAAA== \"vol_center\" Float 3 AAAAAABAnEYAYGrHAAAAAA== \"vol_rotate\" Float 3 AAAAAAAAAAAAAAAAAAAAAA== \"vol_size\" Float 3 AIA7RQAA4UQAgDtFAAAAAA== \"lumps\" Float 1 AAAAPw== \"lump_size\" Float 1 AAAWRA== \"wisp_size\" Float 1 AABwQg== \"wisp_amount\" Float 1 AAAAAA== \"grain_size\" Float 1 AABwQQ== \"grain_amount\" Float 1 AAAAAA== \"swirl\" Float 1 AAAAAA== \"swirl_size\" Float 1 AADIQw== \"shear\" Float 1 AAAAAA== 62 \"output\" 1 1 Default \"camRow0\" 3 1 Default \"camRow1\" 3 1 Default \"camRow2\" 3 1 Default \"camPosition\" 3 1 Default \"focal\" 1 1 Default \"haperture\" 1 1 Default \"frameSize\" 2 1 Default \"sceneScale\" 1 1 Default \"groundHeight\" 1 1 Default \"sunDirection\" 3 1 Default \"sunRotation\" 1 1 Default \"sunColor\" 3 1 Default \"skyColor\" 3 1 Default \"groundColor\" 3 1 Default \"hazeColor\" 3 1 Default \"hazeDistance\" 1 1 Default \"maxDistance\" 1 1 Default \"quality\" 1 1 Default \"samples\" 1 1 Default \"seed\" 1 1 Default \"evolve\" 1 1 Default \"offset\" 2 1 Default \"gapAmount\" 1 1 Default \"gapSize\" 1 1 Default \"base\" 1 1 Default \"thickness\" 1 1 Default \"coverage\" 1 1 Default \"scaleKm\" 1 1 Default \"stretch\" 1 1 Default \"windDeg\" 1 1 Default \"edge\" 1 1 Default \"taper\" 1 1 Default \"bottomRound\" 1 1 Default \"topRound\" 1 1 Default \"detailSize\" 1 1 Default \"erosion\" 1 1 Default \"sigma\" 1 1 Default \"cells\" 1 1 Default \"cellKm\" 1 1 Default \"warp\" 1 1 Default \"forward\" 1 1 Default \"ambient\" 1 1 Default \"octaves\" 1 1 Default \"billow\" 1 1 Default \"streaks\" 1 1 Default \"vary\" 1 1 Default \"density\" 1 1 Default \"volume\" 1 1 Default \"volShape\" 1 1 Default \"volCenter\" 3 1 Default \"volRotate\" 3 1 Default \"volSize\" 3 1 Default \"lumps\" 1 1 Default \"lumpSize\" 1 1 Default \"wispSize\" 1 1 Default \"wispAmount\" 1 1 Default \"grainSize\" 1 1 Default \"grainAmount\" 1 1 Default \"swirl\" 1 1 Default \"swirlSize\" 1 1 Default \"shear\" 1 1 Default 13 \"R\" Float 1 1 AAAAAA== \"pi\" Float 1 1 AAAAAA== \"sun\" Float 3 1 AAAAAAAAAAAAAAAAAAAAAA== \"camAlt\" Float 1 1 AAAAAA== \"ca\" Float 1 1 AAAAAA== \"sa\" Float 1 1 AAAAAA== \"gapX\" Float 1 1 AAAAAA== \"gapZ\" Float 1 1 AAAAAA== \"vc\" Float 3 1 AAAAAAAAAAAAAAAAAAAAAA== \"vr0\" Float 3 1 AAAAAAAAAAAAAAAAAAAAAA== \"vr1\" Float 3 1 AAAAAAAAAAAAAAAAAAAAAA== \"vr2\" Float 3 1 AAAAAAAAAAAAAAAAAAAAAA== \"vh\" Float 3 1 AAAAAAAAAAAAAAAAAAAAAA=="
  kernelSource "// EzCloudGen: one procedural, volumetric cloud layer, ray marched through the shot camera.\n// Ported from the prototype in reference/clouds.py.\n//\n// Metres inside, +Y up. The earth is curved: the layer is a shell from `base` to\n// `base + thickness` above the ground, so a deck converges on the horizon. The camera sits at\n// camPosition (scene units, times sceneScale for metres) with its height above the ground at\n// (camPosition.y - groundHeight) * sceneScale.\n//\n// Shape: a 2D weather field (warped fbm, ridged streaks, Worley cells) thresholded by coverage\n// and shrunk with height by a profile (flat base, rounded top, domes with `taper`). Then the\n// surface is displaced by 3D detail noise (inverted Worley billows or value-noise wisps). Detail\n// octaves drop with distance, so far clouds don't sparkle.\n//\n// Light: a short march towards the sun, four multiple-scattering octaves with a dual\n// Henyey-Greenstein phase (silver linings when backlit), a powder term (dark edges), sky light\n// from above and ground bounce from below, energy-conserving integration, and aerial\n// perspective towards hazeColor over hazeDistance.\n//\n// volume 1: instead of a deck, the layer is one placed cloud volume: a shape (ellipsoid,\n// dome, anvil or box) centred on volCenter (scene units), turned by volRotate (degrees, Y then\n// X then Z) and sized volSize (metres, full size). Lumps (big noise) break the shape up first.\n//\n// Erosion stack, for decks and volumes: billows (detailSize/erosion, inverted Worley or value\n// noise by `billow`), wisps (fine value noise eating the thin edges), grain (finest noise).\n// swirl warps the detail's coordinates (curling wisps); shear leans the tops along the wind.\n//\n// output 0: rgb = cloud colour (premultiplied), a = opacity.\n// output 1: rgb = the direct sun share of output 0's rgb (premultiplied), a = opacity.\n// output 2: rgb = Planar Z of the clouds in scene units (opacity-weighted), a = opacity.\n//           No lighting, so it is cheap.\n//\n// `src` only sets the format: pixel (x, y) maps to the camera frame by frameSize.\n\nkernel EzCloudGen : ImageComputationKernel<ePixelWise>\n\{\n  Image<eRead, eAccessPoint, eEdgeClamped> src;\n  Image<eWrite> dst;\n\nparam:\n  int output;\n  float3 camRow0;\n  float3 camRow1;\n  float3 camRow2;\n  float3 camPosition;\n  float focal;\n  float haperture;\n  float2 frameSize;\n  float sceneScale;\n  float groundHeight;\n  float3 sunDirection;\n  float sunRotation;\n  float3 sunColor;\n  float3 skyColor;\n  float3 groundColor;\n  float3 hazeColor;\n  float hazeDistance;\n  float maxDistance;\n  float quality;\n  int samples;\n  float seed;\n  float evolve;\n  float2 offset;\n  float gapAmount;\n  float gapSize;\n  // The cloud type.\n  float base;\n  float thickness;\n  float coverage;\n  float scaleKm;\n  float stretch;\n  float windDeg;\n  float edge;\n  float taper;\n  float bottomRound;\n  float topRound;\n  float detailSize;\n  float erosion;\n  float sigma;\n  float cells;\n  float cellKm;\n  float warp;\n  float forward;\n  float ambient;\n  float octaves;\n  float billow;\n  float streaks;\n  float vary;\n  float density;\n  // Placed volume.\n  int volume;\n  int volShape;\n  float3 volCenter;\n  float3 volRotate;\n  float3 volSize;\n  float lumps;\n  float lumpSize;\n  // Erosion stack.\n  float wispSize;\n  float wispAmount;\n  float grainSize;\n  float grainAmount;\n  float swirl;\n  float swirlSize;\n  float shear;\n\nlocal:\n  float R;\n  float pi;\n  float3 sun;\n  float camAlt;\n  float ca;\n  float sa;\n  float gapX;\n  float gapZ;\n  float3 vc;\n  float3 vr0;\n  float3 vr1;\n  float3 vr2;\n  float3 vh;\n\n  void define()\n  \{\n    defineParam(output, \"output\", 0);\n    defineParam(camRow0, \"cam_row0\", float3(1.0f, 0.0f, 0.0f));\n    defineParam(camRow1, \"cam_row1\", float3(0.0f, 1.0f, 0.0f));\n    defineParam(camRow2, \"cam_row2\", float3(0.0f, 0.0f, 1.0f));\n    defineParam(camPosition, \"cam_position\", float3(0.0f, 3000.0f, 0.0f));\n    defineParam(focal, \"focal\", 24.0f);\n    defineParam(haperture, \"haperture\", 36.0f);\n    defineParam(frameSize, \"frame_size\", float2(1920.0f, 1080.0f));\n    defineParam(sceneScale, \"scene_scale\", 0.1f);\n    defineParam(groundHeight, \"ground_height\", 0.0f);\n    defineParam(sunDirection, \"sun_direction\", float3(0.0f, 0.5f, -1.0f));\n    defineParam(sunRotation, \"sun_rotation\", 0.0f);\n    defineParam(sunColor, \"sun_color\", float3(1.0f, 0.95f, 0.85f));\n    defineParam(skyColor, \"sky_color\", float3(0.3f, 0.45f, 0.8f));\n    defineParam(groundColor, \"ground_color\", float3(0.12f, 0.11f, 0.09f));\n    defineParam(hazeColor, \"haze_color\", float3(0.6f, 0.68f, 0.8f));\n    defineParam(hazeDistance, \"haze_distance\", 60000.0f);\n    defineParam(maxDistance, \"max_distance\", 80000.0f);\n    defineParam(quality, \"quality\", 1.0f);\n    defineParam(samples, \"samples\", 1);\n    defineParam(seed, \"seed\", 0.0f);\n    defineParam(evolve, \"evolve\", 0.0f);\n    defineParam(offset, \"offset\", float2(0.0f, 0.0f));\n    defineParam(gapAmount, \"gap_amount\", 0.0f);\n    defineParam(gapSize, \"gap_size\", 2000.0f);\n    defineParam(base, \"base\", 1400.0f);\n    defineParam(thickness, \"thickness\", 1300.0f);\n    defineParam(coverage, \"coverage\", 0.42f);\n    defineParam(scaleKm, \"scale_km\", 1.6f);\n    defineParam(stretch, \"stretch\", 1.0f);\n    defineParam(windDeg, \"wind_deg\", 20.0f);\n    defineParam(edge, \"edge\", 0.06f);\n    defineParam(taper, \"taper\", 0.85f);\n    defineParam(bottomRound, \"bottom_round\", 0.04f);\n    defineParam(topRound, \"top_round\", 0.15f);\n    defineParam(detailSize, \"detail_size\", 220.0f);\n    defineParam(erosion, \"erosion\", 0.45f);\n    defineParam(sigma, \"sigma\", 0.06f);\n    defineParam(cells, \"cells\", 0.0f);\n    defineParam(cellKm, \"cell_km\", 0.5f);\n    defineParam(warp, \"warp\", 1.2f);\n    defineParam(forward, \"forward\", 0.8f);\n    defineParam(ambient, \"ambient\", 1.0f);\n    defineParam(octaves, \"octaves\", 3.5f);\n    defineParam(billow, \"billow\", 1.0f);\n    defineParam(streaks, \"streaks\", 0.0f);\n    defineParam(vary, \"vary\", 0.0f);\n    defineParam(density, \"density\", 1.0f);\n    defineParam(volume, \"volume\", 0);\n    defineParam(volShape, \"vol_shape\", 1);\n    defineParam(volCenter, \"vol_center\", float3(0.0f, 20000.0f, -60000.0f));\n    defineParam(volRotate, \"vol_rotate\", float3(0.0f, 0.0f, 0.0f));\n    defineParam(volSize, \"vol_size\", float3(3000.0f, 1800.0f, 3000.0f));\n    defineParam(lumps, \"lumps\", 0.5f);\n    defineParam(lumpSize, \"lump_size\", 600.0f);\n    defineParam(wispSize, \"wisp_size\", 60.0f);\n    defineParam(wispAmount, \"wisp_amount\", 0.0f);\n    defineParam(grainSize, \"grain_size\", 15.0f);\n    defineParam(grainAmount, \"grain_amount\", 0.0f);\n    defineParam(swirl, \"swirl\", 0.0f);\n    defineParam(swirlSize, \"swirl_size\", 400.0f);\n    defineParam(shear, \"shear\", 0.0f);\n  \}\n\n  void init()\n  \{\n    R = 6371000.0f;\n    pi = 3.14159265358979f;\n    // The sun direction turned by sunRotation about +Y (an EzAtmosScatter's HDRI rotation).\n    float r = -sunRotation * pi / 180.0f;\n    float3 sd = normalize(sunDirection);\n    sun = float3(sd.x * cos(r) + sd.z * sin(r), sd.y, -sd.x * sin(r) + sd.z * cos(r));\n    camAlt = max((camPosition.y - groundHeight) * sceneScale, 1.0f);\n    float a = windDeg * pi / 180.0f;\n    ca = cos(a);\n    sa = sin(a);\n    // Where the line from the camera to the sun crosses the cloud base: the gap opens there.\n    float up = max(sun.y, 0.02f);\n    float rise = base + 0.5f * thickness - camAlt;\n    gapX = sun.x / up * rise;\n    gapZ = sun.z / up * rise;\n\n    // The volume in the kernel's frame (camera above 0, 0; metres) and its world to local\n    // rotation: R = Rz * Rx * Ry turns local into world, so its transpose turns back.\n    vc = float3((volCenter.x - camPosition.x) * sceneScale, (volCenter.y - groundHeight) * sceneScale,\n                (volCenter.z - camPosition.z) * sceneScale);\n    float ax = volRotate.x * pi / 180.0f;\n    float ay = volRotate.y * pi / 180.0f;\n    float az = volRotate.z * pi / 180.0f;\n    float cx = cos(ax);\n    float sx = sin(ax);\n    float cy = cos(ay);\n    float sy = sin(ay);\n    float cz = cos(az);\n    float sz = sin(az);\n    // Columns of R (local axes in world), as rows of R^T.\n    vr0 = float3(cz * cy - sz * sx * sy, sz * cy + cz * sx * sy, -cx * sy);\n    vr1 = float3(-sz * cx, cz * cx, sx);\n    vr2 = float3(cz * sy + sz * sx * cy, sz * sy - cz * sx * cy, cx * cy);\n    vh = float3(max(volSize.x, 1.0f) * 0.5f, max(volSize.y, 1.0f) * 0.5f, max(volSize.z, 1.0f) * 0.5f);\n  \}\n\n  // World (kernel frame) point or direction into the volume's unit box space.\n  float3 toLocal(float3 v)\n  \{\n    return float3(dot(vr0, v) / vh.x, dot(vr1, v) / vh.y, dot(vr2, v) / vh.z);\n  \}\n\n  // Ray vs the unit box \[-1, 1]^3 in local space; t is the same as along the world ray.\n  bool boxHit(float3 o, float3 d, float &t0, float &t1)\n  \{\n    float3 inv = float3(1.0f / (fabs(d.x) > 1e-9f ? d.x : 1e-9f), 1.0f / (fabs(d.y) > 1e-9f ? d.y : 1e-9f),\n                        1.0f / (fabs(d.z) > 1e-9f ? d.z : 1e-9f));\n    float ax0 = (-1.0f - o.x) * inv.x;\n    float ax1 = (1.0f - o.x) * inv.x;\n    float ay0 = (-1.0f - o.y) * inv.y;\n    float ay1 = (1.0f - o.y) * inv.y;\n    float az0 = (-1.0f - o.z) * inv.z;\n    float az1 = (1.0f - o.z) * inv.z;\n    t0 = max(max(min(ax0, ax1), min(ay0, ay1)), min(az0, az1));\n    t1 = min(min(max(ax0, ax1), max(ay0, ay1)), max(az0, az1));\n    return t1 > max(t0, 0.0f);\n  \}\n\n  // ---- Noise (float only) -----------------------------------------------------------------\n\n  float fr(float v)\n  \{\n    return v - floor(v);\n  \}\n\n  // Dave Hoskins' hash13.\n  float hash3(float x, float y, float z)\n  \{\n    float px = fr(x * 0.1031f);\n    float py = fr(y * 0.1031f);\n    float pz = fr(z * 0.1031f);\n    float d = px * (py + 33.33f) + py * (pz + 33.33f) + pz * (px + 33.33f);\n    px += d;\n    py += d;\n    pz += d;\n    return fr((px + py) * pz);\n  \}\n\n  float fade5(float f)\n  \{\n    return f * f * f * (f * (f * 6.0f - 15.0f) + 10.0f);\n  \}\n\n  float vnoise3(float x, float y, float z)\n  \{\n    float ix = floor(x);\n    float iy = floor(y);\n    float iz = floor(z);\n    float ux = fade5(x - ix);\n    float uy = fade5(y - iy);\n    float uz = fade5(z - iz);\n    float a = hash3(ix, iy, iz);\n    float b = hash3(ix + 1.0f, iy, iz);\n    float c = hash3(ix, iy + 1.0f, iz);\n    float d = hash3(ix + 1.0f, iy + 1.0f, iz);\n    float e = hash3(ix, iy, iz + 1.0f);\n    float f = hash3(ix + 1.0f, iy, iz + 1.0f);\n    float g = hash3(ix, iy + 1.0f, iz + 1.0f);\n    float h = hash3(ix + 1.0f, iy + 1.0f, iz + 1.0f);\n    float k0 = a + (b - a) * ux;\n    float k1 = c + (d - c) * ux;\n    float k2 = e + (f - e) * ux;\n    float k3 = g + (h - g) * ux;\n    float l0 = k0 + (k1 - k0) * uy;\n    float l1 = k2 + (k3 - k2) * uy;\n    return l0 + (l1 - l0) * uz;\n  \}\n\n  float vnoise2(float x, float y)\n  \{\n    return vnoise3(x, y, 17.31f + seed * 1.37f);\n  \}\n\n  float fbm2(float x, float y, float oct)\n  \{\n    float s = 0.0f;\n    float amp = 0.5f;\n    float tot = 0.0f;\n    int n = int(floor(oct));\n    for (int i = 0; i <= n; i++) \{\n      float w = i < n ? 1.0f : oct - float(n);\n      if (w <= 0.0f)\n        break;\n      s += amp * w * vnoise2(x, y);\n      tot += amp * w;\n      amp *= 0.5f;\n      float nx = 1.6f * x + 1.2f * y + 13.7f;\n      y = -1.2f * x + 1.6f * y + 7.3f;\n      x = nx;\n    \}\n    return s / max(tot, 1e-6f);\n  \}\n\n  float ridged2(float x, float y, float oct)\n  \{\n    float s = 0.0f;\n    float amp = 0.5f;\n    float tot = 0.0f;\n    int n = int(floor(oct));\n    for (int i = 0; i <= n; i++) \{\n      float w = i < n ? 1.0f : oct - float(n);\n      if (w <= 0.0f)\n        break;\n      float v = 1.0f - fabs(2.0f * vnoise2(x, y) - 1.0f);\n      s += amp * w * v * v;\n      tot += amp * w;\n      amp *= 0.55f;\n      float nx = 1.7f * x + 1.1f * y + 5.1f;\n      y = -1.1f * x + 1.7f * y + 9.2f;\n      x = nx;\n    \}\n    return s / max(tot, 1e-6f);\n  \}\n\n  float worley2(float x, float y)\n  \{\n    float ix = floor(x);\n    float iy = floor(y);\n    float best = 9.0f;\n    for (int j = -1; j <= 1; j++) \{\n      for (int i = -1; i <= 1; i++) \{\n        float cx = ix + float(i);\n        float cy = iy + float(j);\n        float dx = cx + hash3(cx, cy, 3.7f + seed) - x;\n        float dy = cy + hash3(cx, cy, 11.3f + seed) - y;\n        best = min(best, dx * dx + dy * dy);\n      \}\n    \}\n    return sqrt(best);\n  \}\n\n  float worley3(float x, float y, float z)\n  \{\n    float ix = floor(x);\n    float iy = floor(y);\n    float iz = floor(z);\n    float best = 9.0f;\n    for (int k = -1; k <= 1; k++) \{\n      for (int j = -1; j <= 1; j++) \{\n        for (int i = -1; i <= 1; i++) \{\n          float cx = ix + float(i);\n          float cy = iy + float(j);\n          float cz = iz + float(k);\n          float dx = cx + hash3(cx, cy, cz) - x;\n          float dy = cy + hash3(cy, cz, cx + 7.1f) - y;\n          float dz = cz + hash3(cz, cx, cy + 3.3f) - z;\n          best = min(best, dx * dx + dy * dy + dz * dz);\n        \}\n      \}\n    \}\n    return min(sqrt(best), 1.0f);\n  \}\n\n  // Billowy (inverted Worley, cauliflower) mixed with wispy value noise.\n  float detail3(float x, float y, float z, float oct)\n  \{\n    float s = 0.0f;\n    float amp = 0.5f;\n    float tot = 0.0f;\n    int n = int(floor(oct));\n    for (int i = 0; i <= n; i++) \{\n      float w = i < n ? 1.0f : oct - float(n);\n      if (w <= 0.0f)\n        break;\n      float b = billow > 0.0f ? 1.0f - worley3(x, y, z) : 0.0f;\n      float v = billow < 1.0f ? vnoise3(x * 1.3f, y * 1.3f, z * 1.3f) : 0.0f;\n      s += amp * w * (billow * b + (1.0f - billow) * v);\n      tot += amp * w;\n      amp *= 0.5f;\n      x = x * 2.03f + 1.7f;\n      y = y * 2.03f + 3.1f;\n      z = z * 2.03f + 5.3f;\n    \}\n    return s / max(tot, 1e-6f);\n  \}\n\n  float sstep(float a, float b, float x)\n  \{\n    float t = clamp((x - a) / (b - a), 0.0f, 1.0f);\n    return t * t * (3.0f - 2.0f * t);\n  \}\n\n  float lg2(float v)\n  \{\n    return log(v) * 1.44269504f;\n  \}\n\n  // ---- Shape --------------------------------------------------------------------------------\n\n  // Coverage at local ground position X, Z (m, camera at 0, 0): positive inside a cloud.\n  float weather(float X, float Z, float foot)\n  \{\n    float sc = scaleKm * 1000.0f;\n    float gx = X - gapX;\n    float gz = Z - gapZ;\n    // World position plus drift.\n    X += camPosition.x * sceneScale + offset.x;\n    Z += camPosition.z * sceneScale + offset.y;\n    float u = (X * ca + Z * sa) / sc;\n    float v = (-X * sa + Z * ca) / (sc * stretch);\n    float oct = min(6.0f, max(1.0f, lg2(max(sc / max(foot, 1.0f), 1.0f)) - 0.5f));\n    float wx = fbm2(u * 0.5f + 3.1f, v * 0.5f, 3.0f) - 0.5f;\n    float wz = fbm2(u * 0.5f + 9.7f, v * 0.5f + 5.0f, 3.0f) - 0.5f;\n    float u2 = u + wx * warp;\n    float v2 = v + wz * warp;\n    float f;\n    if (streaks > 0.5f)\n      f = ridged2(u2, v2, oct) * (0.55f + 0.9f * fbm2(u * 0.3f + 40.0f, v * 0.3f, 3.0f));\n    else\n      f = fbm2(u2, v2, oct);\n    float c = f - (0.82f - 0.55f * coverage);\n    if (cells > 0.0f) \{\n      float cs = cellKm * 1000.0f;\n      float cu = (X * ca + Z * sa) / cs;\n      float cv = (-X * sa + Z * ca) / (cs * 0.6f);\n      // The cells fade out when they get smaller than a few pixels.\n      float fd = sstep(1.5f, 5.0f, cs / max(foot, 1.0f));\n      float cell = worley2(cu + wx * 0.8f, cv + wz * 0.8f);\n      c -= cells * fd * (cell - 0.45f) * 0.35f;\n    \}\n    if (gapAmount > 0.0f)\n      c -= gapAmount * 0.5f * exp(-(gx * gx + gz * gz) / (gapSize * gapSize));\n    return c;\n  \}\n\n  // How much the coverage shrinks at height hn (0 base, 1 top).\n  float profile(float hn)\n  \{\n    float k = 0.3f * (1.0f - sstep(0.0f, max(bottomRound, 1e-3f), hn));\n    k += 0.3f * sstep(1.0f - max(topRound, 1e-3f), 1.0f, hn);\n    k += taper * 0.32f * hn * sqrt(hn);\n    return k;\n  \}\n\n  // Height above the curved ground of local point p (camera above 0, 0).\n  float altitude(float3 p)\n  \{\n    float h2 = p.x * p.x + p.z * p.z;\n    float y = p.y;\n    // sqrt((R + y)^2 + h2) - R, without losing the metres in R^2.\n    return (2.0f * R * y + y * y + h2) / (sqrt((R + y) * (R + y) + h2) + R);\n  \}\n\n  // The placed volume's coverage at p (kernel frame), positive inside; hn: 0 bottom, 1 top.\n  float volumeShape(float3 p, float &hn)\n  \{\n    float3 q = toLocal(p - vc);\n    hn = clamp(q.y * 0.5f + 0.5f, 0.0f, 1.0f);\n    if (fabs(q.x) > 1.0f || fabs(q.y) > 1.0f || fabs(q.z) > 1.0f)\n      return -1.0f;\n    float rxz = sqrt(q.x * q.x + q.z * q.z);\n    float dist;\n    if (volShape == 0) \{\n      // Ellipsoid.\n      dist = sqrt(q.x * q.x + q.y * q.y + q.z * q.z);\n    \} else if (volShape == 1) \{\n      // Dome: a flat base, rounding to the top (cumulus).\n      float r = sqrt(max(1.0f - hn * hn, 0.0f));\n      dist = rxz / max(r, 1e-3f);\n      dist = max(dist, 1.0f - hn / max(bottomRound, 0.02f));\n    \} else if (volShape == 2) \{\n      // Anvil: a column that spreads into a flat top.\n      float r = 0.54f - 0.12f * sstep(0.0f, 0.3f, hn) + 0.58f * sstep(0.72f, 0.95f, hn);\n      dist = max(rxz / max(r, 1e-3f), 1.0f - hn / max(bottomRound, 0.02f));\n      dist = max(dist, sstep(0.93f, 1.0f, hn) * 1.2f);\n    \} else \{\n      // Box with soft corners.\n      float3 a = float3(fabs(q.x), fabs(q.y), fabs(q.z));\n      dist = pow(pow(a.x, 6.0f) + pow(a.y, 6.0f) + pow(a.z, 6.0f), 1.0f / 6.0f);\n    \}\n    float c = (1.0f - dist) * 0.3f + (coverage - 0.5f) * 0.3f;\n    if (lumps > 0.0f) \{\n      float wx = p.x + camPosition.x * sceneScale + offset.x;\n      float wz = p.z + camPosition.z * sceneScale + offset.y;\n      float ls = max(lumpSize, 10.0f);\n      c += lumps * (fbm2(wx / ls + 5.3f, wz / ls, 2.0f) * 0.5f + vnoise3(wx / ls, p.y / ls, wz / ls) * 0.5f - 0.5f) * 0.45f;\n    \}\n    return c;\n  \}\n\n  float vfbm3(float x, float y, float z, float oct)\n  \{\n    float s = 0.0f;\n    float amp = 0.5f;\n    float tot = 0.0f;\n    int n = int(floor(oct));\n    for (int i = 0; i <= n; i++) \{\n      float w = i < n ? 1.0f : oct - float(n);\n      if (w <= 0.0f)\n        break;\n      s += amp * w * vnoise3(x, y, z);\n      tot += amp * w;\n      amp *= 0.5f;\n      x = x * 2.07f + 11.3f;\n      y = y * 2.07f + 4.7f;\n      z = z * 2.07f + 8.1f;\n    \}\n    return s / max(tot, 1e-6f);\n  \}\n\n  // How many octaves of noise of this size are worth drawing at this pixel footprint.\n  float lod(float size, float foot, float most)\n  \{\n    return min(most, max(0.0f, lg2(max(size / max(2.5f * foot, 1.0f), 1.0f))));\n  \}\n\n  // Cloud density 0..1. cheap: no detail noise (for the light march).\n  float cloud(float3 p, float foot, bool cheap)\n  \{\n    float hn = 0.0f;\n    float c = 0.0f;\n    float alt = 0.0f;\n    float height = thickness;\n    if (volume == 1) \{\n      c = volumeShape(p, hn);\n      if (c <= -0.15f)\n        return 0.0f;\n      alt = p.y;\n      height = volSize.y;\n    \} else \{\n      alt = altitude(p);\n      float b = base;\n      c = weather(p.x, p.z, foot);\n      if (c <= -0.12f)\n        return 0.0f;\n      if (vary > 0.0f) \{\n        float sv = scaleKm * 2500.0f;\n        float vx = p.x + camPosition.x * sceneScale + offset.x;\n        float vz = p.z + camPosition.z * sceneScale + offset.y;\n        b += (vnoise2(vx / sv + 70.0f, vz / sv) - 0.5f) * vary * thickness;\n      \}\n      hn = (alt - b) / thickness;\n      if (hn <= 0.0f || hn >= 1.0f)\n        return 0.0f;\n      c -= profile(hn);\n    \}\n    float e = max(edge, 1e-3f);\n    if (cheap)\n      return clamp(c / e, 0.0f, 1.0f);\n    float reach = 0.12f * (erosion + wispAmount + grainAmount);\n    if (c < -reach)\n      return 0.0f;\n    // The detail's coordinates: world metres, rising slowly (boil) with evolve.\n    float wx = p.x + camPosition.x * sceneScale + offset.x;\n    float wy = alt - evolve;\n    float wz = p.z + camPosition.z * sceneScale + offset.y;\n    if (shear != 0.0f) \{\n      // Lean the tops downwind.\n      float lean = shear * hn * height;\n      wx -= lean * sa;\n      wz += lean * ca;\n    \}\n    if (swirl > 0.0f && lod(swirlSize, foot, 1.0f) > 0.0f) \{\n      float ss = max(swirlSize, 1.0f);\n      float sw = swirl * ss;\n      float ux = vnoise3(wx / ss + 1.3f, wy / ss, wz / ss) - 0.5f;\n      float uy = vnoise3(wx / ss, wy / ss + 7.1f, wz / ss) - 0.5f;\n      float uz = vnoise3(wx / ss, wy / ss, wz / ss + 3.9f) - 0.5f;\n      wx += ux * sw * 2.0f;\n      wy += uy * sw * 2.0f;\n      wz += uz * sw * 2.0f;\n    \}\n    if (erosion > 0.0f) \{\n      float oct = lod(detailSize, foot, octaves);\n      if (oct > 0.0f)\n        c += erosion * (detail3(wx / detailSize, wy / detailSize, wz / detailSize, oct) - 0.5f) * 0.24f;\n    \}\n    // Wisps and grain eat the thin edges more than the cores.\n    float thin = 1.0f - clamp(c / (3.0f * e), 0.0f, 1.0f);\n    if (wispAmount > 0.0f) \{\n      float ws = max(wispSize, 1.0f);\n      float oct = lod(ws, foot, 2.0f);\n      if (oct > 0.0f)\n        c += wispAmount * (vfbm3(wx / ws, wy / ws * 1.6f, wz / ws, oct) - 0.55f) * 0.2f * (0.4f + 0.6f * thin);\n    \}\n    if (grainAmount > 0.0f) \{\n      float gs = max(grainSize, 1.0f);\n      float oct = lod(gs, foot, 1.0f);\n      if (oct > 0.0f)\n        c += grainAmount * (vnoise3(wx / gs, wy / gs, wz / gs) - 0.55f) * 0.12f * oct * (0.3f + 0.7f * thin);\n    \}\n    return clamp(c / e, 0.0f, 1.0f);\n  \}\n\n  // ---- Rays ---------------------------------------------------------------------------------\n\n  // Ray from local o along d vs the sphere of radius R + h around (0, -R, 0).\n  bool sphere(float3 o, float3 d, float h, float &t0, float &t1)\n  \{\n    float oy = o.y + R;\n    float b = o.x * d.x + oy * d.y + o.z * d.z;\n    // |o - centre|^2 - r^2, without losing the metres in R^2.\n    float c = o.x * o.x + o.z * o.z + (o.y - h) * (2.0f * R + o.y + h);\n    float disc = b * b - c;\n    if (disc < 0.0f)\n      return false;\n    float s = sqrt(disc);\n    float q = b > 0.0f ? -b - s : -b + s;\n    float r0 = q;\n    float r1 = fabs(q) > 1e-6f ? c / q : -b;\n    t0 = min(r0, r1);\n    t1 = max(r0, r1);\n    return true;\n  \}\n\n  float hg(float g, float c)\n  \{\n    float gg = g * g;\n    return (1.0f - gg) / (4.0f * pi * pow(1.0f + gg - 2.0f * g * c, 1.5f));\n  \}\n\n  // Optical depth towards the sun from p, inside the layer.\n  float sunDepth(float3 p, float foot)\n  \{\n    float t0 = 0.0f;\n    float t1 = 0.0f;\n    float far = 0.0f;\n    if (volume == 1) \{\n      if (boxHit(toLocal(p - vc), toLocal(sun), t0, t1))\n        far = max(t1, 0.0f);\n      far = min(far, 12000.0f);\n    \} else \{\n      if (sphere(p, sun, base + thickness * (1.0f + vary), t0, t1))\n        far = max(t1, 0.0f);\n      far = min(far, min(6.0f * thickness / max(sun.y, 0.08f), 12000.0f));\n    \}\n    int steps = max(int(6.0f * quality), 2);\n    float od = 0.0f;\n    float prev = 0.0f;\n    for (int i = 0; i < steps; i++) \{\n      float f = (float(i) + 0.5f) / float(steps);\n      float t = far * f * f;\n      float dt = t - prev;\n      prev = t;\n      od += cloud(p + sun * t, foot + t * 0.02f, i > 1) * dt;\n    \}\n    return od;\n  \}\n\n  void process(int2 pos)\n  \{\n    float3 cam = float3(0.0f, camAlt, 0.0f);\n    float hap = haperture;\n    float vap = haperture * frameSize.y / frameSize.x;\n    float pixAng = hap / focal / frameSize.x;\n    float sig0 = sigma * density;\n    // The layer's shell, with room for `vary`.\n    float hb = base - thickness * vary;\n    float ht = base + thickness * (1.0f + vary);\n\n    float4 acc = float4(0.0f);\n    int ns = max(samples, 1);\n    for (int s = 0; s < ns; s++) \{\n      float jx = ns > 1 ? hash3(pos.x + 0.5f, pos.y + 0.5f, float(s) * 7.0f + seed) : 0.5f;\n      float jy = ns > 1 ? hash3(pos.y + 1.5f, pos.x + 2.5f, float(s) * 3.0f + 5.0f) : 0.5f;\n      float u = (pos.x + jx) / frameSize.x;\n      float v = (pos.y + jy) / frameSize.y;\n      float3 cd = float3((u - 0.5f) * hap / focal, (v - 0.5f) * vap / focal, -1.0f);\n      float3 d = normalize(float3(dot(camRow0, cd), dot(camRow1, cd), dot(camRow2, cd)));\n      // Planar Z per metre along the ray.\n      float zPer = 1.0f / length(cd);\n      float cosT = dot(d, sun);\n\n      // Where the ray is inside the shell: \[a0, a1] (outer) minus (b0, b1) (inner), before\n      // the ground and maxDistance.\n      float tmax = maxDistance;\n      float g0 = 0.0f;\n      float g1 = 0.0f;\n      if (sphere(cam, d, 0.0f, g0, g1) && g0 > 0.0f)\n        tmax = min(tmax, g0);\n      float a0 = 0.0f;\n      float a1 = 0.0f;\n      float b0 = 0.0f;\n      float b1 = 0.0f;\n      float i0s = 0.0f;\n      float i0e = 0.0f;\n      float i1s = 0.0f;\n      float i1e = 0.0f;\n      int n = 0;\n      if (volume == 1) \{\n        if (boxHit(toLocal(cam - vc), toLocal(d), a0, a1) && min(a1, tmax) > max(a0, 0.0f)) \{\n          i0s = max(a0, 0.0f);\n          i0e = min(a1, tmax);\n          n = 1;\n        \}\n      \} else if (sphere(cam, d, ht, a0, a1) && a1 > 0.0f) \{\n        float s0 = max(a0, 0.0f);\n        float s1 = min(a1, tmax);\n        if (!sphere(cam, d, hb, b0, b1)) \{\n          if (s1 > s0) \{\n            i0s = s0;\n            i0e = s1;\n            n = 1;\n          \}\n        \} else \{\n          if (min(b0, s1) > s0) \{\n            i0s = s0;\n            i0e = min(b0, s1);\n            n = 1;\n          \}\n          if (s1 > max(b1, s0)) \{\n            if (n == 0) \{\n              i0s = max(b1, s0);\n              i0e = s1;\n            \} else \{\n              i1s = max(b1, s0);\n              i1e = s1;\n            \}\n            n += 1;\n          \}\n        \}\n      \}\n\n      float T = 1.0f;\n      float3 col = float3(0.0f);\n      float3 sunPart = float3(0.0f);\n      float dep = 0.0f;\n      float layerH = volume == 1 ? min(min(volSize.x, volSize.y), volSize.z) : thickness;\n      float minStep = max(min(layerH / 24.0f, detailSize * 0.35f) / quality, 8.0f);\n      int maxSteps = int(220.0f * quality);\n      for (int k = 0; k < n; k++) \{\n        float t = k == 0 ? i0s : i1s;\n        float tEnd = k == 0 ? i0e : i1e;\n        bool first = true;\n        int steps = 0;\n        while (t < tEnd && T > 0.01f && steps < maxSteps) \{\n          steps++;\n          float foot = max(t * pixAng, 0.5f);\n          float dt = max(minStep, t * 0.012f / quality);\n          if (first) \{\n            // Jitter the first step per pixel, so the steps don't band.\n            dt *= hash3(pos.x * 1.7f, pos.y * 2.3f, float(s + 31 * k) + seed) + 0.02f;\n            first = false;\n          \}\n          dt = min(dt, tEnd - t + 1e-3f);\n          float tm = t + 0.5f * dt;\n          float3 p = cam + d * tm;\n          float dn = cloud(p, foot, false);\n          if (dn > 0.0f) \{\n            float sig = dn * sig0;\n            float ext = exp(-sig * dt);\n            float w = T * (1.0f - ext);\n            dep += w * tm;\n            if (output != 2) \{\n              float od = sunDepth(p, foot) * sig0;\n              // Multiple scattering octaves (Wrenninge).\n              float ms = 0.0f;\n              float oa = 1.0f;\n              float ob = 1.0f;\n              float oc = 1.0f;\n              for (int o = 0; o < 4; o++) \{\n                float ph = 0.75f * hg(forward * oc, cosT) + 0.25f * hg(-0.25f * oc, cosT);\n                ms += ob * exp(-od * oa) * ph;\n                oa *= 0.3f;\n                ob *= 0.6f;\n                oc *= 0.5f;\n              \}\n              // Powder: dark edges facing away from the sun.\n              float powder = 1.0f - 0.6f * exp(-sig * 160.0f);\n              float3 direct = sunColor * (ms * powder);\n              // Sky light from above, ground bounce from below.\n              float hn = 0.0f;\n              if (volume == 1)\n                volumeShape(p, hn);\n              else\n                hn = clamp((altitude(p) - base) / thickness, 0.0f, 1.0f);\n              float th = min(layerH, 1500.0f) * 0.12f;\n              float up = exp(-sig * (1.0f - hn) * th);\n              float dnl = exp(-sig * hn * th) * 0.35f;\n              float3 amb = (skyColor * up + groundColor * dnl) * ambient;\n              float hz = hazeDistance > 0.0f ? exp(-tm / hazeDistance) : 1.0f;\n              col += w * (hz * (direct + amb) + (1.0f - hz) * hazeColor);\n              sunPart += w * hz * direct;\n            \}\n            T *= ext;\n          \}\n          t += dt;\n        \}\n      \}\n      float alpha = 1.0f - T;\n      if (output == 2) \{\n        float z = alpha > 1e-5f ? dep / alpha * zPer / sceneScale : 0.0f;\n        acc += float4(z, z, z, alpha);\n      \} else if (output == 1) \{\n        acc += float4(sunPart.x, sunPart.y, sunPart.z, alpha);\n      \} else \{\n        acc += float4(col.x, col.y, col.z, alpha);\n      \}\n    \}\n    dst() = acc / float(ns);\n  \}\n\};\n"
  rebuild ""
  EzCloudGen_output 1
  EzCloudGen_cam_row0 {{parent.cam_world_matrix.0} {parent.cam_world_matrix.1} {parent.cam_world_matrix.2}}
  EzCloudGen_cam_row1 {{parent.cam_world_matrix.4} {parent.cam_world_matrix.5} {parent.cam_world_matrix.6}}
  EzCloudGen_cam_row2 {{parent.cam_world_matrix.8} {parent.cam_world_matrix.9} {parent.cam_world_matrix.10}}
