 l3_stretch 7
 addUserKnob {7 l3_edge l "edge softness" t "Softness of the cloud edges." R 0.01 0.5}
 l3_edge 0.25
 addUserKnob {7 l3_taper l domes t "How much the clouds narrow going up: cumulus domes and towers." R 0 2}
 addUserKnob {7 l3_bottom_round l "base rounding" t "Rounding at the base, as a share of the thickness (small = flat base)."}
 l3_bottom_round 0.4
