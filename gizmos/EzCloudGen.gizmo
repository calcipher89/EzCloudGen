 atm_sun_color {{"\[python -execlocal \{a = nuke.thisNode().input(2)\nwhile a is not None and not a.knob('haze_density'):\n    a = a.input(0) if a.inputs() else None\nret = 0\nif a is not None:\n    selflit = a.knob('self_lit') is not None and a\['self_lit'].value()\n    lnode = nuke.toNode(a.fullName() + ('.SelfLight' if selflit and 1 == 2 else '.Light'))\n    if lnode is not None and not (selflit and 1 == 1):\n        ret = lnode.sample('red', 1.5, 0.5)\n    elif selflit:\n        import math\n        sk = a\['sun_in_use']\n        sx, sy, sz = sk.getValueAt(nuke.frame(), 0), sk.getValueAt(nuke.frame(), 1), sk.getValueAt(nuke.frame(), 2)\n        el = math.degrees(math.asin(max(min(sy / (math.sqrt(sx * sx + sy * sy + sz * sz) or 1.0), 1.0), -1.0)))\n        am = 1.0 / (math.sin(math.radians(max(el, 0.0))) + 0.50572 * (max(el, 0.0) + 6.07995) ** -1.6364)\n        hk = a\['camera_height'].value() / 1000.0\n        tr = a\['rayleigh_coefficients'].getValueAt(nuke.frame(), 0) * a\['sky_amount'].value() * a\['rayleigh_scale_height'].value() * math.exp(-hk / a\['rayleigh_scale_height'].value())\n        tm = a\['mie_coefficient'].value() / 0.9 * a\['haze_amount'].value() * a\['haze_height'].value() * math.exp(-hk / max(a\['haze_height'].value(), 1e-3))\n        ck = a\['sun_color']\n        tint = ck.getValueAt(nuke.frame(), 0) if ck.arraySize() > 1 and not ck.singleValue() else ck.getValueAt(nuke.frame(), 0)\n        ret = tint * a\['manual_sun_brightness'].value() * a\['sun_strength'].value() * math.exp(-(tr + tm) * am) if el > -1 else 0.0\n\}]"} {"\[python -execlocal \{a = nuke.thisNode().input(2)\nwhile a is not None and not a.knob('haze_density'):\n    a = a.input(0) if a.inputs() else None\nret = 0\nif a is not None:\n    selflit = a.knob('self_lit') is not None and a\['self_lit'].value()\n    lnode = nuke.toNode(a.fullName() + ('.SelfLight' if selflit and 1 == 2 else '.Light'))\n    if lnode is not None and not (selflit and 1 == 1):\n        ret = lnode.sample('green', 1.5, 0.5)\n    elif selflit:\n        import math\n        sk = a\['sun_in_use']\n        sx, sy, sz = sk.getValueAt(nuke.frame(), 0), sk.getValueAt(nuke.frame(), 1), sk.getValueAt(nuke.frame(), 2)\n        el = math.degrees(math.asin(max(min(sy / (math.sqrt(sx * sx + sy * sy + sz * sz) or 1.0), 1.0), -1.0)))\n        am = 1.0 / (math.sin(math.radians(max(el, 0.0))) + 0.50572 * (max(el, 0.0) + 6.07995) ** -1.6364)\n        hk = a\['camera_height'].value() / 1000.0\n        tr = a\['rayleigh_coefficients'].getValueAt(nuke.frame(), 1) * a\['sky_amount'].value() * a\['rayleigh_scale_height'].value() * math.exp(-hk / a\['rayleigh_scale_height'].value())\n        tm = a\['mie_coefficient'].value() / 0.9 * a\['haze_amount'].value() * a\['haze_height'].value() * math.exp(-hk / max(a\['haze_height'].value(), 1e-3))\n        ck = a\['sun_color']\n        tint = ck.getValueAt(nuke.frame(), 1) if ck.arraySize() > 1 and not ck.singleValue() else ck.getValueAt(nuke.frame(), 0)\n        ret = tint * a\['manual_sun_brightness'].value() * a\['sun_strength'].value() * math.exp(-(tr + tm) * am) if el > -1 else 0.0\n\}]"} {"\[python -execlocal \{a = nuke.thisNode().input(2)\nwhile a is not None and not a.knob('haze_density'):\n    a = a.input(0) if a.inputs() else None\nret = 0\nif a is not None:\n    selflit = a.knob('self_lit') is not None and a\['self_lit'].value()\n    lnode = nuke.toNode(a.fullName() + ('.SelfLight' if selflit and 1 == 2 else '.Light'))\n    if lnode is not None and not (selflit and 1 == 1):\n        ret = lnode.sample('blue', 1.5, 0.5)\n    elif selflit:\n        import math\n        sk = a\['sun_in_use']\n        sx, sy, sz = sk.getValueAt(nuke.frame(), 0), sk.getValueAt(nuke.frame(), 1), sk.getValueAt(nuke.frame(), 2)\n        el = math.degrees(math.asin(max(min(sy / (math.sqrt(sx * sx + sy * sy + sz * sz) or 1.0), 1.0), -1.0)))\n        am = 1.0 / (math.sin(math.radians(max(el, 0.0))) + 0.50572 * (max(el, 0.0) + 6.07995) ** -1.6364)\n        hk = a\['camera_height'].value() / 1000.0\n        tr = a\['rayleigh_coefficients'].getValueAt(nuke.frame(), 2) * a\['sky_amount'].value() * a\['rayleigh_scale_height'].value() * math.exp(-hk / a\['rayleigh_scale_height'].value())\n        tm = a\['mie_coefficient'].value() / 0.9 * a\['haze_amount'].value() * a\['haze_height'].value() * math.exp(-hk / max(a\['haze_height'].value(), 1e-3))\n        ck = a\['sun_color']\n        tint = ck.getValueAt(nuke.frame(), 2) if ck.arraySize() > 1 and not ck.singleValue() else ck.getValueAt(nuke.frame(), 0)\n        ret = tint * a\['manual_sun_brightness'].value() * a\['sun_strength'].value() * math.exp(-(tr + tm) * am) if el > -1 else 0.0\n\}]"}}
 addUserKnob {18 atm_sky_color +INVISIBLE}
 atm_sky_color {{"\[python -execlocal \{a = nuke.thisNode().input(2)\nwhile a is not None and not a.knob('haze_density'):\n    a = a.input(0) if a.inputs() else None\nret = 0\nif a is not None:\n    selflit = a.knob('self_lit') is not None and a\['self_lit'].value()\n    lnode = nuke.toNode(a.fullName() + ('.SelfLight' if selflit and 2 == 2 else '.Light'))\n    if lnode is not None and not (selflit and 2 == 1):\n        ret = lnode.sample('red', 2.5, 0.5)\n    elif selflit:\n        import math\n        sk = a\['sun_in_use']\n        sx, sy, sz = sk.getValueAt(nuke.frame(), 0), sk.getValueAt(nuke.frame(), 1), sk.getValueAt(nuke.frame(), 2)\n        el = math.degrees(math.asin(max(min(sy / (math.sqrt(sx * sx + sy * sy + sz * sz) or 1.0), 1.0), -1.0)))\n        am = 1.0 / (math.sin(math.radians(max(el, 0.0))) + 0.50572 * (max(el, 0.0) + 6.07995) ** -1.6364)\n        hk = a\['camera_height'].value() / 1000.0\n        tr = a\['rayleigh_coefficients'].getValueAt(nuke.frame(), 0) * a\['sky_amount'].value() * a\['rayleigh_scale_height'].value() * math.exp(-hk / a\['rayleigh_scale_height'].value())\n        tm = a\['mie_coefficient'].value() / 0.9 * a\['haze_amount'].value() * a\['haze_height'].value() * math.exp(-hk / max(a\['haze_height'].value(), 1e-3))\n        ck = a\['sun_color']\n        tint = ck.getValueAt(nuke.frame(), 0) if ck.arraySize() > 1 and not ck.singleValue() else ck.getValueAt(nuke.frame(), 0)\n        ret = tint * a\['manual_sun_brightness'].value() * a\['sun_strength'].value() * math.exp(-(tr + tm) * am) if el > -1 else 0.0\n\}]"} {"\[python -execlocal \{a = nuke.thisNode().input(2)\nwhile a is not None and not a.knob('haze_density'):\n    a = a.input(0) if a.inputs() else None\nret = 0\nif a is not None:\n    selflit = a.knob('self_lit') is not None and a\['self_lit'].value()\n    lnode = nuke.toNode(a.fullName() + ('.SelfLight' if selflit and 2 == 2 else '.Light'))\n    if lnode is not None and not (selflit and 2 == 1):\n        ret = lnode.sample('g