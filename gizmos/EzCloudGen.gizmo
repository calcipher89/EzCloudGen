 addUserKnob {22 l3_place l "place in front of camera" t "Puts the volume 'distance' ahead of the camera, on the ground at 'base height'." -STARTLINE +HIDDEN T "n = nuke.thisNode()\nm = n\['cam_world_matrix']\ns = n\['scene_scale'].value() or 1.0\nfx, fz = -m.getValue(2), -m.getValue(10)\nl = (fx * fx + fz * fz) ** 0.5\nif l < 1e-6:\n    fx, fz, l = 0.0, -1.0, 1.0\nd = n\['l3_place_km'].value() * 1000.0 / s\npos = \[m.getValue(3) + fx / l * d, n\['ground_height'].value() + n\['l3_base'].value() / s, m.getValue(11) + fz / l * d]\nbox = n.input(7)\nif box is not None and box.knob('translate') and box.knob('scaling'):\n    # A box plugged in: move the box (its centre is half its height above the base).\n    h = box\['scaling'].value(1) * box\['uniform_scale'].value()\n    box\['translate'].setValue(\[pos\[0], pos\[1] + h / 2.0, pos\[2]])\nelse:\n    n\['l3_vol_position'].setValue(pos)\n"}
 addUserKnob {7 l3_place_km l distance t "How far ahead 'place in front of camera' puts it, km." -STARTLINE +HIDDEN}
 l3_place_km 10
 addUserKnob {22 l3_make_box l "make 3D box" t "Makes a Cube beside this node, placed and sized like the volume, and plugs it into this layer's box input (box3): move, rotate and scale the Cube in the 3D viewer (view it with your camera) and the cloud follows. Any 3D node works in that input (a Cube, an Axis, a TransformGeo, parented or tracked), and the volume fills its box." -STARTLINE +HIDDEN T "n = nuke.thisNode()\np = 'l3_'\nidx = 7\ns = n\['scene_scale'].value() or 1.0\nif n.input(idx) is None:\n    path = n.fullName().split('.')\n    ctx = nuke.toNode('.'.join(path\[:-1])) if len(path) > 1 else nuke.root()\n    ctx.begin()\n    c = nuke.nodes.Cube(name=n.name() + '_L3_Box')\n    ctx.end()\n    c.setXYpos(n.xpos() - 150, n.ypos() - 60 * 2)\n    pos = n\[p + 'vol_position'].value()\n    size = n\[p + 'vol_size'].value()\n    # The kernel turns the volume Y, then X, then Z.\n    c\['rot_order'].setValue('YXZ')\n    c\['translate'].setValue(\[pos\[0], pos\[1] + size\[1] / s / 2.0, pos\[2]])\n    c\['rotate'].setValue(n\[p + 'vol_rotate'].value())\n    c\['scaling'].setValue(\[size\[0] / s, size\[1] / s, size\[2] / s])\n    c\['display'].setValue('wireframe')\n    c\['render_mode'].setValue('off')\n    c\['label'].setValue('cloud volume: ' + n.name() + ' layer 3')\n    c\['tile_color'].setValue(0x8fb3d9ff)\n    n.setInput(idx, c)\n"}
 addUserKnob {22 l3_release_box l "release box" t "Unplugs the box; the volume stays where it is." -STARTLINE +HIDDEN T "n = nuke.thisNode()\np = 'l3_'\nimport math\nif n\[p + 'box_found'].value() > 0.5:\n    s = n\['scene_scale'].value() or 1.0\n    c = n\[p + 'box_center'].value()\n    size = n\[p + 'box_size'].value()\n    ax = n\[p + 'box_axis_x'].value()\n    ay = n\[p + 'box_axis_y'].value()\n    az = n\[p + 'box_axis_z'].value()\n    # The kernel's R = Rz Rx Ry: axis_y = (-sin z cos x, cos z cos x, sin x), and so on.\n    rx = math.degrees(math.asin(max(-1.0, min(1.0, ay\[2]))))\n    rz = math.degrees(math.atan2(-ay\[0], ay\[1]))\n    ry = math.degrees(math.atan2(-ax\[2], az\[2]))\n    n\[p + 'vol_rotate'].setValue(\[rx, ry, rz])\n    n\[p + 'vol_size'].setValue(list(size))\n    n\[p + 'vol_position'].setValue(\[c\[0], c\[1] - size\[1] / s / 2.0, c\[2]])\nn.setInput(7, None)\n"}
 addUserKnob {3 l3_box_found +INVISIBLE}
 l3_box_found {{"\[python -execlocal \{ret = 0\nif nuke.thisNode().input(7) is not None:\n    g = \{'nuke': nuke\}\n    exec(nuke.thisNode()\['box_lib'].getText(), g)\n    ret = g\['box_value'](nuke.thisNode(), 7, 0, 'found')\}]"}}
