 addUserKnob {7 l1_lumps l lumps t "Big rounded lobes that break the shape into towers and bulges (volumes and decks). Cumulus keep a flat, ragged base under them." R 0 1.5}
 l1_lumps 0.6
 addUserKnob {7 l1_lump_size l "lump size" t "Size of the lumps, in metres." R 20 5000}
 l1_lump_size 520
 addUserKnob {7 l1_small_lumps l "small lumps" t "A second set of lobes, a bit under half the size, riding on the lumps: cauliflower heads."}
 l1_small_lumps 0.3
 addUserKnob {7 l1_skirt l skirt t "Smooth, firm billows on top and a wide, soft skirt of wisps around the base: it calms the erosion higher up, and widens the edge and feeds the wisps low down." R 0 2}
 l1_skirt 0.6
