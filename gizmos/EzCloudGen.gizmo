lt \"camRow1\" 3 1 Default \"camRow2\" 3 1 Default \"camPosition\" 3 1 Default \"focal\" 1 1 Default \"haperture\" 1 1 Default \"frameSize\" 2 1 Default \"sceneScale\" 1 1 Default \"groundHeight\" 1 1 Default \"sunDirection\" 3 1 Default \"sunRotation\" 1 1 Default \"sunColor\" 3 1 Default \"skyColor\" 3 1 Default \"groundColor\" 3 1 Default \"hazeColor\" 3 1 Default \"hazeDistance\" 1 1 Default \"maxDistance\" 1 1 Default \"horizonHaze\" 1 1 Default \"earthCurvature\" 1 1 Default \"quality\" 1 1 Default \"samples\" 1 1 Default \"edgeSteps\" 1 1 Default \"seed\" 1 1 Default \"evolve\" 1 1 Default \"offset\" 2 1 Default \"gapAmount\" 1 1 Default \"gapSize\" 1 1 Default \"base\" 1 1 Default \"thickness\" 1 1 Default \"coverage\" 1 1 Default \"scaleKm\" 1 1 Default \"stretch\" 1 1 Default \"windDeg\" 1 1 Default \"edge\" 1 1 Default \"taper\" 1 1 Default \"bottomRound\" 1 1 Default \"topRound\" 1 1 Default \"detailSize\" 1 1 Default \"erosion\" 1 1 Default \"sigma\" 1 1 Default \"cells\" 1 1 Default \"cellKm\" 1 1 Default \"warp\" 1 1 Default \"forward\" 1 1 Default \"ambient\" 1 1 Default \"skyOcclusion\" 1 1 Default \"shadowDepth\" 1 1 Default \"sunGlow\" 1 1 Default \"diffusion\" 1 1 Default \"useSunMap\" 1 1 Default \"sunMapSize\" 1 1 Default \"octaves\" 1 1 Default \"billow\" 1 1 Default \"streaks\" 1 1 Default \"vary\" 1 1 Default \"density\" 1 1 Default \"volume\" 1 1 Default \"volShape\" 1 1 Default \"volCenter\" 3 1 Default \"volRotate\" 3 1 Default \"volSize\" 3 1 Default \"lumps\" 1 1 Default \"lumpSize\" 1 1 Default \"lumps2\" 1 1 Default \"skirt\" 1 1 Default \"fadeTop\" 1 1 Default \"fadeBottom\" 1 1 Default \"fadeLeft\" 1 1 Default \"fadeRight\" 1 1 Default \"fadeFront\" 1 1 Default \"fadeBack\" 1 1 Default \"wispSize\" 1 1 Default \"wispAmount\" 1 1 Default \"grainSize\" 1 1 Default \"grainAmount\" 1 1 Default \"swirl\" 1 1 Default \"swirlSize\" 1 1 Default \"turbulence\" 1 1 Default \"crumble\" 1 1 Default \"crumbleSize\" 1 1 Default \"shear\" 1 1 Defa