 atm_found {{"\[python -execlocal \{a = nuke.thisNode().input(2)\nwhile a is not None and not a.knob('haze_density'):\n    a = a.input(0) if a.inputs() else None\nret = 1 if a is not None else 0\}]"}}
 addUserKnob {13 atm_sun +INVISIBLE}
 atm_sun {{"\[python -execlocal \{a = nuke.thisNode().input(2)\nwhile a is not None and not a.knob('haze_density'):\n    a = a.input(0) if a.inputs() else None\nret = (a.knob('sun_in_use') or a.knob('sun_direction')).getValueAt(nuke.frame(), 0) if a is not None else 0\}]"} {"\[python -execlocal \{a = nuke.thisNode().input(2)\nwhile a is not None and not a.knob('haze_density'):\n    a = a.input(0) if a.inputs() else None\nret = (a.knob('sun_in_use') or a.knob('sun_direction')).getValueAt(nuke.frame(), 1) if a is not None else 0\}]"} {"\[python -execlocal \{a = nuke.thisNode().input(2)\nwhile a is not None and not a.knob('haze_density'):\n    a = a.input(0) if a.inputs() else None\nret = (a.knob('sun_in_use') or a.knob('sun_direction')).getValueAt(nuke.frame(), 2) if a is not None else 0\}]"}}
 addUserKnob {7 atm_rotation +INVISIBLE}
 atm_rotation {{"\[python -execlocal \{a = nuke.thisNode().input(2)\nwhile a is not None and not a.knob('haze_density'):\n    a = a.input(0) if a.inputs() else None\nret = a\['hdri_rotation'].getValueAt(nuke.frame()) if a is not None and a.knob('hdri_rotation') else 0\}]"}}
 addUserKnob {18 atm_sun_color +INVISIBLE}
 atm_sun_color {{"\[python -execlocal \{a = nuke.thisNode().input(2)\nwhile a is not None and not a.knob('haze_density'):\n    a = a.input(0) if a.inputs() else None\nl = nuke.toNode(a.fullName() + '.Light') if a is not None else None\nret = l.sample('red', 1.5, 0.5) if l is not None else 0\n\}]"} {"\[python -execlocal \{a = nuke.thisNode().input(2)\nwhile a is not None and not a.knob('haze_density'):\n    a = a.input(0) if a.inputs() else None\nl = nuke.toNode(a.fullName() + '.Light') if a is not None else None\nret = l.sample('green', 1.5, 0.5) if l is not None else 0\n\}]"} {"\[python -execlocal \{a = nuke.thisNode().input(2)\nwhile a is not None and not a.knob('haze_density'):\n    a = a.input(0) if a.inputs() else None\nl = nuke.toNode(a.fullName() + '.Light') if a is not None else None\nret = l.sample('blue', 1.5, 0.5) if l is not None else 0\n\}]"}}
 addUserKnob {18 atm_sky_color +INVISIBLE}
 atm_sky_color {{"\[python -execlocal \{a = nuke.thisNode().input(2)\nwhile a is not None and not a.knob('haze_density'):\n    a = a.input(0) if a.inputs() else None\nl = nuke.toNode(a.fullName() + '.Light') if a is not None else None\nret = l.sample('red', 2.5, 0.5) if l is not None else 0\n\}]"} {"\[python -execlocal \{a = nuke.thisNode().input(2)\nwhile a is not None and not a.knob('haze_density'):\n    a = a.input(0) if a.inputs() else None\nl = nuke.toNode(a.fullName() + '.Light') if a is not None else None\nret = l.sample('green', 2.5, 0.5) if l is not None else 0\n\}]"} {"\[python -execlocal \{a = nuke.thisNode().input(2)\nwhile a is not None and not a.knob('haze_density'):\n    a = a.input(0) if a.inputs() else None\nl = nuke.toNode(a.fullName() + '.Light') if a is not None else None\nret = l.sample('blue', 2.5, 0.5) if l is not None else 0\n\}]"}}
 addUserKnob {3 axis_found +INVISIBLE}
 axis_found {{"\[python -execlocal \{x = nuke.thisNode().input(3)\nwhile x is not None and not x.knob('world_matrix'):\n    x = x.input(0) if x.inputs() else None\nret = 1 if x is not None else 0\}]"}}
 addUserKnob {13 axis_position +INVISIBLE}
 axis_position {{"\[python -execlocal \{x = nuke.thisNode().input(3)\nwhile x is not None and not x.knob('world_matrix'):\n    x = x.input(0) if x.inputs() else None\nret = x\['world_matrix'].getValueAt(nuke.frame(), 3) if x is not None else 0\}]"} {"\[python -execlocal \{x = nuke.thisNode().input(3)\nwhile x is not None and not x.knob('world_matrix'):\n    x = x.input(0) if x.inputs() else None\nret = x\['world_matrix'].getValueAt(nuke.frame(), 7) if x is not None else 0\}]"} {"\[python -execlocal \{x = nuke.thisNode().input(3)\nwhile x is not None and not x.knob('world_matrix'):\n    x = x.input(0) if x.inputs() else None\nret = x\['world_matrix'].getValueAt(nuke.frame(), 11) if x is not None else 0\}]"}}
 addUserKnob {3 bg_found +INVISIBLE}
 bg_found {{"\[python -execlocal \{ret = 1 if nuke.thisNode().input(0) is not None else 0\}]"}}
 addUserKnob {3 sun_source +INVISIBLE}
 sun_source {{"sun_from==1 ? (axis_found ? 1 : 0) : sun_from==2 ? (atm_found ? 2 : 0) : sun_from==3 ? 0 : (axis_found ? 1 : atm_found ? 2 : 0)"}}
 addUserKnob {3 light_source +INVISIBLE}
 light_source {{"light_from==0 && atm_found && (atm_sun_color.r + atm_sun_color.g + atm_sun_color.b) > 0 ? 1 : 0"}}
 addUserKnob {7 sun_rotation_in_use +INVISIBLE}
 sun_rotation_in_use {{"sun_source==2 ? atm_rotation : 0"}}
 addUserKnob {18 sun_color_in_use +INVISIBLE}
 sun_color_in_use {{"(light_source ? atm_sun_color.r : sun_color.r) * sun_intensity"} {"(light_source ? atm_sun_color.g : sun_color.g) * sun_intensity"} {"(light_source ? atm_sun_color.b : sun_color.b) * sun_intensity"}}
 addUserKnob {18 sky_color_in_use +INVISIBLE}
 sky_color_in_use {{"(light_source ? atm_sky_color.r : sky_color.r) * sky_intensity"} {"(light_source ? atm_sky_color.g : sky_color.g) * sky_intensity"} {"(light_source ? atm_sky_color.b : sky_color.b) * sky_intensity"}}
 addUserKnob {18 haze_color_in_use +INVISIBLE}
 haze_color_in_use {{"light_source ? atm_sky_color.r * haze_color.r : haze_color.r * 0.43"} {"light_source ? atm_sky_color.g * haze_color.g : haze_color.g * 0.43"} {"light_source ? atm_sky_color.b * haze_color.b : haze_color.b * 0.43"}}
 addUserKnob {7 work_scale +INVISIBLE}
 work_scale {{"resolution==0 ? 1 : resolution==1 ? 0.5 : 0.25"}}
 addUserKnob {7 time_s +INVISIBLE}
 time_s {{"frame / max(root.fps, 1)"}}
}
