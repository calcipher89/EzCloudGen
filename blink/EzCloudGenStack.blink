// EzCloudGenStack: puts up to three cloud layers over each other nearest first, per pixel.
//
// c1..c3 are premultiplied images of the layers (colour, sun share, or Planar Z times alpha).
// z1..z3 are the layers' depth passes (rgb = Planar Z, a = opacity), only used to order them:
// a layer with no opacity at a pixel counts as furthest. The result is c_near over c_mid over
// c_far, so placed volumes and decks sort themselves out wherever they are. Where two layers
// are at about the same depth the order fades from one to the other (see process).

kernel EzCloudGenStack : ImageComputationKernel<ePixelWise>
{
  Image<eRead, eAccessPoint, eEdgeClamped> c1;
  Image<eRead, eAccessPoint, eEdgeClamped> c2;
  Image<eRead, eAccessPoint, eEdgeClamped> c3;
  Image<eRead, eAccessPoint, eEdgeClamped> z1;
  Image<eRead, eAccessPoint, eEdgeClamped> z2;
  Image<eRead, eAccessPoint, eEdgeClamped> z3;
  Image<eWrite> dst;

  float key(float4 z)
  {
    return z.w > 1e-6f ? z.x : 1e30f;
  }

  // 1 when the near layer is clearly in front of the far one, 0.5 when they are level.
  float closer(float kn, float kf)
  {
    if (kf > 1e29f)
      return 1.0f;
    return 0.5f + 0.5f * clamp((kf - kn) / (0.06f * kf + 1.0f), 0.0f, 1.0f);
  }

  float4 over(float4 a, float4 b)
  {
    return a + b * (1.0f - a.w);
  }

  void process()
  {
    float4 a = c1();
    float4 b = c2();
    float4 c = c3();
    float ka = key(z1());
    float kb = key(z2());
    float kc = key(z3());
    // Sort three by key, nearest first.
    if (kb < ka) {
      float4 t = a;
      a = b;
      b = t;
      float k = ka;
      ka = kb;
      kb = k;
    }
    if (kc < kb) {
      float4 t = b;
      b = c;
      c = t;
      float k = kb;
      kb = kc;
      kc = k;
    }
    if (kb < ka) {
      float4 t = a;
      a = b;
      b = t;
      float k = ka;
      ka = kb;
      kb = k;
    }
    // Two layers at about the same depth are in each other, not one in front: a hard order
    // would flip from pixel to pixel along the line where they cross (dotted seams, bright
    // rims drawn over the cloud behind). So the order fades over 6% of the depth: at equal
    // depth the result is the mean of both orders.
    float wbc = closer(kb, kc);
    float4 bc = over(b, c) * wbc + over(c, b) * (1.0f - wbc);
    float wab = closer(ka, kb);
    dst() = over(a, bc) * wab + over(b, over(a, c)) * (1.0f - wab);
  }
};
