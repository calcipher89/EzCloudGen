#! Nuke15.1 -nx
version 15.1 v3
Root {
 inputs 0
 name "[file dirname [value root.name]]/EzCloudGen_demo.nk"
 frame 1001
 first_frame 1001
 last_frame 1100
 lock_range true
 fps 24
 format "1920 1080 0 0 1920 1080 1 HD_1080"
}
add_layer {cloud cloud.red cloud.green cloud.blue cloud.alpha}
add_layer {cloud_sun cloud_sun.red cloud_sun.green cloud_sun.blue}
add_layer {cloud_sky cloud_sky.red cloud_sky.green cloud_sky.blue}
StickyNote {
 inputs 0
 name ReadMe
 label "EzCloudGen demo: synthetic, no files read. The scene is in decimetres (units to metres 0.1).\nThe shot camera is 300 m up and pans 12 degrees over 1001-1100; the clouds drift with the wind.\nView 1-4 in the Viewer for the four setups. Each EzCloudGen: Layer tabs have the type menu,\nview shows Comp / Clouds / Sun share / Depth, resolution Half (Full for finals).\nOutputs: rgba, depth.Z (Planar Z, scene units, for EzCloudShafts), cloud, cloud_sun, cloud_sky."
 note_font_size 18
 xpos 0
 ypos -420
}
Camera2 {
 inputs 0
 translate {0 3000 0}
 rotate {18 {curve x1001 0 x1100 12} 0}
 focal 24
 haperture 36
 vaperture 20.25
 name ShotCamera
 label "300 m up, pitched 18 deg"
 xpos 0
 ypos -200
}
set Ncam [stack 0]
Constant {
 inputs 0
 channels rgba
 color {0.1 0.2 0.48 1}
 name SkyBackdrop
 label "stand-in sky (your plate or HDRI goes here)"
 xpos 200
 ypos -200
}
set Nsky [stack 0]
BackdropNode {
 inputs 0
 name Backdrop_FairWeather
 label "Fair weather: cumulus + cirrus, sun high to the right"
 note_font_size 20
 tile_color 0x3a5a4aff
 xpos 140
 ypos -40
 bdwidth 360
 bdheight 220
}
push 0
push 0
push $Ncam
push $Nsky
Group {
 inputs 4
 name FairWeather
 knobChanged "k = nuke.thisKnob()\nif k.name() in ('l1_type', 'l2_type', 'l3_type'):\n    n = nuke.thisNode()\n    p = k.name()\[:3]\n    t = \{'Cumulus': \{'base': 1400, 'thickness': 1300, 'coverage': 0.42, 'scale_km': 1.6, 'stretch': 1.0, 'wind_deg': 20, 'edge': 0.06, 'taper': 0.85, 'bottom_round': 0.04, 'top_round': 0.15, 'detail_size': 220, 'erosion': 0.45, 'sigma': 0.06, 'cells': 0.0, 'cell_km': 0.5, 'warp': 1.2, 'forward': 0.8, 'ambient': 1.0, 'octaves': 3.5, 'billow': 1.0, 'streaks': 0.0, 'vary': 0.0\}, 'Cumulus Congestus': \{'base': 1400, 'thickness': 4200, 'coverage': 0.42, 'scale_km': 2.2, 'stretch': 1.0, 'wind_deg': 20, 'edge': 0.05, 'taper': 1.4, 'bottom_round': 0.02, 'top_round': 0.12, 'detail_size': 420, 'erosion': 0.4, 'sigma': 0.07, 'cells': 0.0, 'cell_km': 0.5, 'warp': 1.0, 'forward': 0.8, 'ambient': 1.0, 'octaves': 4, 'billow': 1.0, 'streaks': 0.0, 'vary': 0.0\}, 'Stratocumulus': \{'base': 1300, 'thickness': 600, 'coverage': 0.66, 'scale_km': 1.1, 'stretch': 1.4, 'wind_deg': 20, 'edge': 0.16, 'taper': 0.35, 'bottom_round': 0.15, 'top_round': 0.35, 'detail_size': 120, 'erosion': 0.45, 'sigma': 0.035, 'cells': 0.0, 'cell_km': 0.5, 'warp': 1.8, 'forward': 0.8, 'ambient': 1.0, 'octaves': 3, 'billow': 0.8, 'streaks': 0.0, 'vary': 0.15\}, 'Stratus': \{'base': 500, 'thickness': 450, 'coverage': 0.97, 'scale_km': 4.0, 'stretch': 1.5, 'wind_deg': 20, 'edge': 0.35, 'taper': 0.0, 'bottom_round': 0.35, 'top_round': 0.3, 'detail_size': 220, 'erosion': 0.25, 'sigma': 0.02, 'cells': 0.0, 'cell_km': 0.5, 'warp': 1.0, 'forward': 0.8, 'ambient': 1.0, 'octaves': 2, 'billow': 0.2, 'streaks': 0.0, 'vary': 0.3\}, 'Altocumulus': \{'base': 4200, 'thickness': 350, 'coverage': 0.62, 'scale_km': 2.5, 'stretch': 2.0, 'wind_deg': 20, 'edge': 0.14, 'taper': 0.3, 'bottom_round': 0.25, 'top_round': 0.35, 'detail_size': 60, 'erosion': 0.5, 'sigma': 0.03, 'cells': 0.85, 'cell_km': 0.35, 'warp': 1.6, 'forward': 0.8, 'ambient': 1.0, 'octaves': 2.5, 'billow': 0.9, 'streaks': 0.0, 'vary': 0.0\}, 'Altostratus': \{'base': 3000, 'thickness': 1500, 'coverage': 1.0, 'scale_km': 6.0, 'stretch': 1.5, 'wind_deg': 20, 'edge': 0.4, 'taper': 0.0, 'bottom_round': 0.3, 'top_round': 0.3, 'detail_size': 300, 'erosion': 0.2, 'sigma': 0.006, 'cells': 0.0, 'cell_km': 0.5, 'warp': 1.0, 'forward': 0.85, 'ambient': 1.0, 'octaves': 2, 'billow': 0.3, 'streaks': 0.0, 'vary': 0.2\}, 'Cirrus': \{'base': 9000, 'thickness': 500, 'coverage': 0.5, 'scale_km': 5.0, 'stretch': 7.0, 'wind_deg': 35, 'edge': 0.25, 'taper': 0.0, 'bottom_round': 0.4, 'top_round': 0.4, 'detail_size': 150, 'erosion': 0.6, 'sigma': 0.0012, 'cells': 0.0, 'cell_km': 0.5, 'warp': 2.5, 'forward': 0.85, 'ambient': 1.2, 'octaves': 2, 'billow': 0.0, 'streaks': 1.0, 'vary': 0.0\}, 'Cirrocumulus': \{'base': 7500, 'thickness': 250, 'coverage': 0.55, 'scale_km': 3.0, 'stretch': 2.5, 'wind_deg': -30, 'edge': 0.15, 'taper': 0.0, 'bottom_round': 0.35, 'top_round': 0.35, 'detail_size': 40, 'erosion': 0.45, 'sigma': 0.008, 'cells': 1.0, 'cell_km': 0.22, 'warp': 2.0, 'forward': 0.85, 'ambient': 1.0, 'octaves': 2, 'billow': 0.7, 'streaks': 0.0, 'vary': 0.0\}\}\n    for key, v in t\[k.value()].items():\n        if n.knob(p + key) is not None:\n            n\[p + key].setValue(v)\n"
 tile_color 0x8fb3d9ff
 addUserKnob {20 ezcloudgen l EzCloudGen}
 addUserKnob {4 view t "Comp: the clouds over 'bg' (or alone without it). Clouds: the clouds alone, premultiplied. Sun share: the direct sunlight part of the clouds. Depth: Planar Z of the clouds, scene units." M {Comp Clouds "Sun share" Depth}}
 addUserKnob {6 breakout l "breakout layers" t "Adds the layers cloud (rgba), cloud_sun and cloud_sky (rgb), for re-grading the clouds over the plate. Takes a second pass per layer." -STARTLINE}
 breakout true
 addUserKnob {4 resolution t "Render the clouds smaller and scale them back up: much faster, softer." M {Full Half Quarter}}
 resolution Half
 addUserKnob {7 quality t "Ray march step count: higher is smoother and slower." R 0.25 4}
 quality 1
 addUserKnob {3 samples t "Jittered samples per pixel: anti-aliasing and less grain."}
 samples 1
 addUserKnob {7 max_distance l "max distance" t "Clouds further than this (km) are not drawn." R 5 200}
 max_distance 80
 addUserKnob {26 scene_divider l scene}
 addUserKnob {7 scene_scale l "units to metres" t "Scene units to metres: 0.1 for decimetres."}
 scene_scale 0.1
 addUserKnob {7 ground_height l "ground height" t "Height of the ground in scene units; the camera's height above it places it under the clouds." R -10000 10000}
 addUserKnob {26 sun_divider l sun}
 addUserKnob {4 sun_from l "sun from" t "Auto: the Axis in 'sun' if there is one, else the EzAtmosScatter in 'atmos', else 'sun direction'." M {Auto Axis EzAtmosScatter Manual}}
 addUserKnob {13 sun_direction l "sun direction" t "Direction towards the sun, +Y up."}
 sun_direction {0.3 0.35 -1}
 addUserKnob {13 sun_in_use l "sun in use" t "The sun direction being used (read only)." +DISABLED}
 sun_in_use {{"sun_source==1 ? axis_position.x : sun_source==2 ? atm_sun.x : sun_direction.x"} {"sun_source==1 ? axis_position.y : sun_source==2 ? atm_sun.y : sun_direction.y"} {"sun_source==1 ? axis_position.z : sun_source==2 ? atm_sun.z : sun_direction.z"}}
 addUserKnob {4 light_from l "light from" t "Auto: the sun and sky light the EzAtmosScatter in 'atmos' measures in its HDRI. Manual (or no atmos): 'sun color' and 'sky color'." M {Auto Manual}}
 addUserKnob {18 sun_color l "sun color" t "Sunlight (irradiance) when the light is Manual."}
 sun_color {12 11.3 10}
 addUserKnob {18 sky_color l "sky color" t "Sky light (radiance) when the light is Manual."}
 sky_color {0.12 0.25 0.58}
 addUserKnob {18 ground_color l "ground bounce" t "Light bounced up from the ground onto the cloud bases."}
 ground_color {0.08 0.07 0.06}
 addUserKnob {7 sun_intensity l "sun intensity" t "Multiplies the sunlight."}
 sun_intensity 1
 addUserKnob {7 sky_intensity l "sky intensity" t "Multiplies the sky light."}
 sky_intensity 1
 addUserKnob {26 haze_divider l air}
 addUserKnob {7 haze_distance l "haze distance" t "Distance (km) over which far clouds fade into the haze colour. 0: off." R 0 200}
 haze_distance 60
 addUserKnob {18 haze_color l "haze color" t "Colour far clouds fade to. With the light from an atmos it multiplies the atmos's sky colour."}
 haze_color {1.4 1.35 1.3}
 addUserKnob {26 gap_divider l "sun gap"}
 addUserKnob {7 gap_amount l "gap toward sun" t "Opens a hole in every layer where the line from the camera to the sun crosses it, so the sun and EzCloudShafts' shafts come through."}
 addUserKnob {7 gap_size l "gap size" t "Radius of the gap, in km."}
 gap_size 2
 addUserKnob {26 time_divider l time}
 addUserKnob {7 evolve_speed l evolve t "How fast the cloud detail boils, in metres per second."}
 evolve_speed 0.5
 addUserKnob {7 seed t "Changes every layer's clouds."}
 addUserKnob {20 l1_tab l "Layer 1"}
 addUserKnob {6 l1_enable l enable t "Draw this layer. Keep layer 1 the lowest." -STARTLINE}
 l1_enable true
 addUserKnob {4 l1_type l type t "Sets this layer's shape knobs to the type's values (they can be tuned after)." M {Cumulus "Cumulus Congestus" Stratocumulus Stratus Altocumulus Altostratus Cirrus Cirrocumulus}}
 addUserKnob {7 l1_base l "base height" t "Height of the cloud base above the ground, in metres." R 0 12000}
 l1_base 1400
 addUserKnob {7 l1_thickness l thickness t "Depth of the layer, base to top, in metres." R 50 6000}
 l1_thickness 1300
 addUserKnob {7 l1_coverage l coverage t "How much of the sky the layer covers."}
 l1_coverage 0.42
 addUserKnob {7 l1_scale_km l size t "Size of the cloud shapes across the ground, in km." R 0.1 10}
 l1_scale_km 1.6
 addUserKnob {7 l1_wind_deg l "wind direction" t "Direction the shapes stretch and drift along, in degrees (0 = away from the world -Z axis, 90 = +X)." R -180 180}
 l1_wind_deg 20
 addUserKnob {7 l1_density l density t "Multiplies the cloud density."}
 l1_density 1
 addUserKnob {7 l1_wind_speed l "wind speed" t "Drift along the wind direction, m/s."}
 l1_wind_speed 5
 addUserKnob {7 l1_seed l seed t "Changes this layer's clouds."}
 addUserKnob {20 l1_shape l shape n 2}
 addUserKnob {7 l1_stretch l stretch t "Elongation along the wind (1 = round)." R 1 10}
 l1_stretch 1
 addUserKnob {7 l1_edge l "edge softness" t "Softness of the cloud edges." R 0.01 0.5}
 l1_edge 0.06
 addUserKnob {7 l1_taper l domes t "How much the clouds narrow going up: cumulus domes and towers." R 0 2}
 l1_taper 0.85
 addUserKnob {7 l1_bottom_round l "base rounding" t "Rounding at the base, as a share of the thickness (small = flat base)."}
 l1_bottom_round 0.04
 addUserKnob {7 l1_top_round l "top rounding" t "Rounding at the top, as a share of the thickness."}
 l1_top_round 0.15
 addUserKnob {7 l1_detail_size l "detail size" t "Size of the billows and wisps on the surface, in metres." R 10 1000}
 l1_detail_size 220
 addUserKnob {7 l1_erosion l "detail amount" t "How much the detail breaks up the surface."}
 l1_erosion 0.45
 addUserKnob {7 l1_sigma l "thickness of cloud" t "Extinction per metre: high is dense and hard edged, low is thin and veil-like." R 0.0005 0.1}
 l1_sigma 0.06
 addUserKnob {7 l1_cells l cells t "Cellular rows (altocumulus, cirrocumulus)."}
 addUserKnob {7 l1_cell_km l "cell size" t "Size of the cells, in km." R 0.05 2}
 l1_cell_km 0.5
 addUserKnob {7 l1_warp l warp t "How much the shapes swirl." R 0 4}
 l1_warp 1.2
 addUserKnob {7 l1_forward l "forward scatter" t "How much light the clouds throw forward: the silver lining when backlit." R 0 0.95}
 l1_forward 0.8
 addUserKnob {7 l1_ambient l "sky light" t "How much sky light the layer takes." R 0 3}
 l1_ambient 1
 addUserKnob {7 l1_octaves l "detail octaves" t "Detail levels (more is finer and slower)." R 0 5}
 l1_octaves 3.5
 addUserKnob {7 l1_billow l billows t "1: billowy cauliflower detail. 0: soft wisps."}
 l1_billow 1
 addUserKnob {7 l1_streaks l streaks t "1: fibrous streaks (cirrus)."}
 addUserKnob {7 l1_vary l "height variation" t "How much the base and top move up and down across the deck." R 0 0.5}
 addUserKnob {20 l1_shape_end l "" -STARTLINE n -1}
 addUserKnob {20 l2_tab l "Layer 2"}
 addUserKnob {6 l2_enable l enable t "Draw this layer. Keep layer 1 the lowest." -STARTLINE}
 addUserKnob {4 l2_type l type t "Sets this layer's shape knobs to the type's values (they can be tuned after)." M {Cumulus "Cumulus Congestus" Stratocumulus Stratus Altocumulus Altostratus Cirrus Cirrocumulus}}
 l2_type Altocumulus
 addUserKnob {7 l2_base l "base height" t "Height of the cloud base above the ground, in metres." R 0 12000}
 l2_base 4200
 addUserKnob {7 l2_thickness l thickness t "Depth of the layer, base to top, in metres." R 50 6000}
 l2_thickness 350
 addUserKnob {7 l2_coverage l coverage t "How much of the sky the layer covers."}
 l2_coverage 0.62
 addUserKnob {7 l2_scale_km l size t "Size of the cloud shapes across the ground, in km." R 0.1 10}
 l2_scale_km 2.5
 addUserKnob {7 l2_wind_deg l "wind direction" t "Direction the shapes stretch and drift along, in degrees (0 = away from the world -Z axis, 90 = +X)." R -180 180}
 l2_wind_deg 20
 addUserKnob {7 l2_density l density t "Multiplies the cloud density."}
 l2_density 1
 addUserKnob {7 l2_wind_speed l "wind speed" t "Drift along the wind direction, m/s."}
 l2_wind_speed 5
 addUserKnob {7 l2_seed l seed t "Changes this layer's clouds."}
 l2_seed 11
 addUserKnob {20 l2_shape l shape n 2}
 addUserKnob {7 l2_stretch l stretch t "Elongation along the wind (1 = round)." R 1 10}
 l2_stretch 2
 addUserKnob {7 l2_edge l "edge softness" t "Softness of the cloud edges." R 0.01 0.5}
 l2_edge 0.14
 addUserKnob {7 l2_taper l domes t "How much the clouds narrow going up: cumulus domes and towers." R 0 2}
