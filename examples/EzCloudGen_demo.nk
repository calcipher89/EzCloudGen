 addUserKnob {4 l2_type l type t "Sets this layer's shape knobs to the type's values (they can be tuned after)." M {Cumulus "Cumulus Congestus" Stratocumulus Stratus Altocumulus Altostratus Cirrus Cirrocumulus "Hero Cumulus" "Towering Cumulus" "Shelf Cloud" "Storm Anvil" "Fog Bank" "Ground Fog" "Wispy Fog" "Torn Low Cloud" Puff "Soft Cumulus"}}
 l2_type "Hero Cumulus"
 addUserKnob {7 l2_base l "base height" t "Height of the cloud base above the ground, in metres." R 0 12000}
 l2_base 1400
