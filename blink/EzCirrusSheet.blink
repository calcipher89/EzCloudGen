// EzCirrusSheet: a thin sheet of fibrous high cloud (cirrus) for EzCloudGen.
//
// A cheap pass of its own, beside EzCloudGen.blink and not inside it: no cloud() call, no
// march. Each pixel's view ray meets the sheet once, on the curved shell at 'height', and reads
// a 2D texture there: soft patches (fbm cut by cover) times long fibres (ridged noise stretched
// along 'direction' and gently warped, so the strands hook). Each fibre octave fades by the
// pixel's footprint across the fibre, so strands running into the distance stay sharp while
// those too fine for the pixel fade to their mean instead of speckling. Lit by single
// scattering: the sun (at the sheet's height) times a forward-peaked phase, dimmed by the
// sheet's own thickness along the sun's slant, plus the sky light. Fades into the air like the
// main pass. Output: premultiplied rgba (0 colour, 1 the sun's share of it).
//
// Units: metres, the camera above 0, 0 (scene units turned to metres by scene_scale), like
// EzCloudGen.blink.

kernel EzCirrusSheet : ImageComputationKernel<ePixelWise>
{
  Image<eRead, eAccessPoint, eEdgeClamped> src;
  Image<eRead, eAccessRandom, eEdgeClamped> zin;
  Image<eWrite> dst;

param:
  int output;
  float3 camRow0;
  float3 camRow1;
  float3 camRow2;
  float3 camPosition;
  float focal;
  float haperture;
  float2 frameSize;
  float pixelAspect;
  float sceneScale;
  float groundHeight;
  float earthCurvature;
  float3 sunDirection;
  float sunRotation;
  float3 sunColor;
  float3 skyColor;
  float3 hazeColor;
  float hazeDistance;
  float maxDistance;
  float forward;
  float sunGlow;
  int occlude;
  int depthMode;
  float skyDepth;
  // The sheet.
  float height;
  float cover;
  float edge;
  float scaleKm;
  float fibreSize;
  float fibreLength;
  float fibres;
  float opacity;
  float directionDeg;
  float2 drift;
  float seed;
  float ambient;

local:
  float pi;
  float R;
  float ex;
  float ez;
  float camAlt;
  float3 sun;
  float2 fdir;

  void define()
  {
    defineParam(output, "output", 0);
    defineParam(camRow0, "cam_row0", float3(1.0f, 0.0f, 0.0f));
    defineParam(camRow1, "cam_row1", float3(0.0f, 1.0f, 0.0f));
    defineParam(camRow2, "cam_row2", float3(0.0f, 0.0f, 1.0f));
    defineParam(camPosition, "cam_position", float3(0.0f, 3000.0f, 0.0f));
    defineParam(focal, "focal", 24.0f);
    defineParam(haperture, "haperture", 36.0f);
    defineParam(frameSize, "frame_size", float2(1920.0f, 1080.0f));
    defineParam(pixelAspect, "pixel_aspect", 1.0f);
    defineParam(sceneScale, "scene_scale", 0.1f);
    defineParam(groundHeight, "ground_height", 0.0f);
    defineParam(earthCurvature, "earth_curvature", 1.0f);
    defineParam(sunDirection, "sun_direction", float3(0.0f, 0.5f, -1.0f));
    defineParam(sunRotation, "sun_rotation", 0.0f);
    defineParam(sunColor, "sun_color", float3(1.0f, 0.95f, 0.85f));
    defineParam(skyColor, "sky_color", float3(0.3f, 0.45f, 0.8f));
    defineParam(hazeColor, "haze_color", float3(0.6f, 0.68f, 0.8f));
    defineParam(hazeDistance, "haze_distance", 60000.0f);
    defineParam(maxDistance, "max_distance", 400000.0f);
    defineParam(forward, "forward", 0.6f);
    defineParam(sunGlow, "sun_glow", 0.0f);
    defineParam(occlude, "occlude", 0);
    defineParam(depthMode, "depth_mode", 0);
    defineParam(skyDepth, "sky_depth", 1e7f);
    defineParam(height, "height", 9000.0f);
    defineParam(cover, "cover", 0.5f);
    defineParam(edge, "edge", 0.6f);
    defineParam(scaleKm, "scale_km", 6.0f);
    defineParam(fibreSize, "fibre_size", 150.0f);
    defineParam(fibreLength, "fibre_length", 20.0f);
    defineParam(fibres, "fibres", 0.8f);
    defineParam(opacity, "opacity", 0.3f);
    defineParam(directionDeg, "direction_deg", 35.0f);
    defineParam(drift, "drift", float2(0.0f, 0.0f));
    defineParam(seed, "seed", 0.0f);
    defineParam(ambient, "ambient", 1.0f);
  }

  void init()
  {
    pi = 3.14159265358979f;
    R = 6371000.0f / max(earthCurvature, 1e-3f);
    ex = camPosition.x * sceneScale;
    ez = camPosition.z * sceneScale;
    camAlt = max((camPosition.y - groundHeight) * sceneScale, 1.0f);
    float r = -sunRotation * pi / 180.0f;
    float3 sd = normalize(sunDirection);
    sun = float3(sd.x * cos(r) + sd.z * sin(r), sd.y, -sd.x * sin(r) + sd.z * cos(r));
    float a = directionDeg * pi / 180.0f;
    fdir = float2(sin(a), -cos(a));
  }

  float fr(float v)
  {
    return v - floor(v);
  }

  float hash2(float x, float y)
  {
    return fr(sin(x * 127.1f + y * 311.7f + seed * 74.7f) * 43758.5453f);
  }

  // Value noise, 0..1, smooth.
  float vnoise(float x, float y)
  {
    float ix = floor(x);
    float iy = floor(y);
    float fx = x - ix;
    float fy = y - iy;
    fx = fx * fx * (3.0f - 2.0f * fx);
    fy = fy * fy * (3.0f - 2.0f * fy);
    float a = hash2(ix, iy);
    float b = hash2(ix + 1.0f, iy);
    float c = hash2(ix, iy + 1.0f);
    float d = hash2(ix + 1.0f, iy + 1.0f);
    return a + (b - a) * fx + (c - a) * fy + (a - b - c + d) * fx * fy;
  }

  float sstep(float a, float b, float x)
  {
    float t = clamp((x - a) / max(b - a, 1e-6f), 0.0f, 1.0f);
    return t * t * (3.0f - 2.0f * t);
  }

  float hg(float g, float c)
  {
    float g2 = g * g;
    return (1.0f - g2) / (4.0f * pi * pow(max(1.0f + g2 - 2.0f * g * c, 1e-4f), 1.5f));
  }

  // The sheet's density (0..1) at world position (wx, wz), for a pixel whose footprint is foot
  // metres across the fibres and footP metres overall.
  float density(float wx, float wz, float foot, float footP)
  {
    // Fibres: ridged noise in the fibre's frame (s along, q across), warped so strands hook.
    float s0 = wx * fdir.x + wz * fdir.y;
    float q0 = -wx * fdir.y + wz * fdir.x;
    float s = s0;
    float q = q0;
    float fw = max(fibreSize, 1.0f);
    float fl = fw * max(fibreLength, 1.0f);
    q += 0.5f * fl * (vnoise(s / (4.0f * fl) + 3.1f, q / (16.0f * fw)) - 0.5f);
    float fib = 0.0f;
    float fsum = 0.0f;
    float amp = 1.0f;
    float lw = fw * 4.0f;
    for (int o = 0; o < 4; o++) {
      float v = vnoise(s / (lw * max(fibreLength, 1.0f)) + 5.3f * float(o), q / lw + 1.7f * float(o));
      float ridge = 1.0f - fabs(2.0f * v - 1.0f);
      ridge = ridge * ridge;
      // Too fine for this pixel across the fibre: its mean (1/3) instead.
      float k = 1.0f - sstep(0.35f, 1.2f, foot / lw);
      fib += amp * (k * ridge + (1.0f - k) * 0.3333f);
      fsum += amp;
      amp *= 0.55f;
      lw *= 0.5f;
    }
    fib = sstep(0.25f, 0.75f, fib / fsum);
    // Strands come and go along their length (each octave of breaks fades like the fibres).
    float kb = 1.0f - sstep(0.35f, 1.2f, foot / (fw * 3.0f));
    float brk = kb * sstep(0.3f, 0.75f, vnoise(s / (1.5f * fl) - 2.3f, q / (3.0f * fw) + 4.1f)) + (1.0f - kb) * 0.5f;
    // Patches: where the sheet is. fbm over 'patch size', each octave fading past the pixel.
    float sc = max(scaleKm, 0.05f) * 1000.0f;
    // Patches run with the fibres: 2.5 times longer along them.
    float ps = s0 / 2.5f;
    float n = 0.0f;
    amp = 0.5f;
    float wsum = 0.0f;
    float lost = 0.0f;
    float f = 1.0f / sc;
    for (int o = 0; o < 4; o++) {
      float k = 1.0f - sstep(0.25f, 1.0f, footP * f);
      n += amp * (k * vnoise(ps * f + 17.0f * float(o), q0 * f - 9.0f * float(o)) + (1.0f - k) * 0.5f);
      lost += amp * (1.0f - k);
      wsum += amp;
      amp *= 0.5f;
      f *= 2.03f;
    }
    n /= wsum;
    // cover 0: none, 1: all of the sheet (the fbm sits mostly in 0.3..0.7).
    float thr = 0.75f - 0.46f * clamp(cover, 0.0f, 1.0f);
    // Never sharper than the pixel: far off, where octaves have faded to their mean, the edge
    // widens by what they would have spread, so the pixel keeps the share of sheet it covers
    // (a veil of the mean everywhere would read as full cover).
    float e = max(edge, 0.01f) * 0.12f + 0.35f * lost / wsum;
    // The fibres fray the patch edges.
    float fl01 = clamp(fibres, 0.0f, 1.0f);
    n += 0.12f * fl01 * (fib - 0.5f);
    float patch = cover <= 0.0f ? 0.0f : sstep(thr - e, thr + e, n);
    if (cover >= 1.0f)
      patch = max(patch, 0.85f + 0.15f * n);
    if (patch <= 0.0f)
      return 0.0f;
    return patch * (1.0f - fl01 + fl01 * fib * (0.35f + 0.65f * brk) * 1.6f);
  }

  void process(int2 pos)
  {
    float4 res = float4(0.0f);
    float px = float(pos.x) + 0.5f;
    float py = float(pos.y) + 0.5f;
    float hap = haperture;
    float vap = haperture * frameSize.y / (frameSize.x * pixelAspect);
    float3 cd = float3((px / frameSize.x - 0.5f) * hap / focal, (py / frameSize.y - 0.5f) * vap / focal, -1.0f);
    float3 d = normalize(float3(dot(camRow0, cd), dot(camRow1, cd), dot(camRow2, cd)));
    float zPer = 1.0f / length(cd);
    float h = max(height, 100.0f);
    // The ray meets the shell of radius R + h round the earth's centre (0 - ex, -R, 0 - ez):
    // |o + t d - C|^2 = (R + h)^2 with o the camera. c is written as (alt - h)(2R + alt + h) to
    // keep the metres, and t as -c / (b + sqrt(b^2 - c)) for the same reason.
    float b = ex * d.x + (R + camAlt) * d.y + ez * d.z;
    float c = (camAlt - h) * (2.0f * R + camAlt + h) + ex * ex + ez * ez;
    float disc = b * b - c;
    if (disc <= 0.0f || camAlt >= h) {
      dst() = res;
      return;
    }
    float t = -c / (b + sqrt(disc));
    if (t <= 0.0f || t > maxDistance) {
      dst() = res;
      return;
    }
    // The bg in front of the sheet hides it.
    if (occlude == 1) {
      float z = zin(pos.x, pos.y).x;
      if (depthMode == 1)
        z = z > 0.0f ? 1.0f / z : 0.0f;
      if (z > 0.0f && z < skyDepth) {
        float sceneT = depthMode == 2 ? z * sceneScale : z * sceneScale / zPer;
        if (sceneT < t) {
          dst() = res;
          return;
        }
      }
    }
    float3 p = float3(d.x * t, camAlt + d.y * t, d.z * t);
    float3 up = normalize(float3(p.x + ex, p.y + R, p.z + ez));
    float mu = max(fabs(dot(up, d)), 0.02f);
    float wx = p.x + ex + drift.x;
    float wz = p.z + ez + drift.y;
    // The pixel's footprint on the sheet: foot0 across the view, foot0 / mu along it. Across
    // the fibre it is a mix of the two, by how the fibre lies against the view.
    float foot0 = t * hap / focal / frameSize.x;
    float3 vh = d - up * dot(d, up);
    float vl = length(vh);
    float2 v2 = vl > 1e-6f ? float2(vh.x / vl, vh.z / vl) : float2(1.0f, 0.0f);
    float acrossAlong = fabs(-fdir.y * v2.x + fdir.x * v2.y);
    float acrossSide = sqrt(max(1.0f - acrossAlong * acrossAlong, 0.0f));
    float footAlong = foot0 / mu;
    float footAcross = sqrt(footAlong * acrossAlong * footAlong * acrossAlong + foot0 * acrossSide * foot0 * acrossSide);
    float den = density(wx, wz, footAcross, sqrt(foot0 * footAlong));
    if (den <= 0.0f) {
      dst() = res;
      return;
    }
    // Opacity through the sheet along the view (slanted: longer near the horizon, capped).
    float tau = clamp(opacity, 0.0f, 4.0f) * den * min(1.0f / mu, 5.0f);
    float alpha = 1.0f - exp(-tau);
    // Light: single scattering, the sun dimmed by the sheet along its own slant.
    float cosT = dot(d, sun);
    float sunUp = max(dot(up, sun), 0.0f);
    float ph = 0.8f * hg(clamp(forward, -0.95f, 0.95f), cosT) + 0.2f * hg(-0.2f, cosT) + sunGlow * hg(0.93f, cosT);
    float tauSun = 0.6f * clamp(opacity, 0.0f, 4.0f) * den * min(1.0f / max(sunUp, 0.02f), 4.0f);
    // The sun sets on the sheet a little after it sets on the ground.
    float lit = exp(-tauSun) * sstep(-0.06f, 0.0f, dot(up, sun));
    // The light a thin sheet sends to the camera per unit of its opacity: 4 pi x phase for the
    // sun (1 for an even phase), the sky's light all round.
    float3 sunPart = sunColor * (4.0f * pi * ph * lit * 0.25f);
    float3 col = sunPart + skyColor * max(ambient, 0.0f);
    float hz = hazeDistance > 0.0f ? exp(-t / hazeDistance) : 1.0f;
    float3 outc = (output == 1 ? sunPart * hz : col * hz + hazeColor * (1.0f - hz)) * alpha;
    dst() = float4(outc.x, outc.y, outc.z, alpha);
  }
};
