 addUserKnob {7 l2_bottom_round l "base rounding" t "Rounding at the base, as a share of the thickness (small = flat base)."}
 l2_bottom_round 0.25
 addUserKnob {7 l2_top_round l "top rounding" t "Rounding at the top, as a share of the thickness."}
 l2_top_round 0.35
