  EzCloudGen_offset {{"-parent.l1_wind_speed * parent.time_s * sin(radians(parent.l1_wind_deg))"} {"parent.l1_wind_speed * parent.time_s * cos(radians(parent.l1_wind_deg))"}}
  EzCloudGen_gap_amount {{parent.gap_amount}}
