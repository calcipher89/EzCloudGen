  EzCloudGen_map_drift {{"-parent.l1_wind_speed * (parent.time_s - parent.map_frame / max(root.fps, 1)) * sin(radians(parent.l1_wind_deg))"} {"parent.l1_wind_speed * (parent.time_s - parent.map_frame / max(root.fps, 1)) * cos(radians(parent.l1_wind_deg))"} {"-parent.l2_wind_speed * (parent.time_s - parent.map_frame / max(root.fps, 1)) * sin(radians(parent.l2_wind_deg))"} {"parent.l2_wind_speed * (parent.time_s - parent.map_frame / max(root.fps, 1)) * cos(radians(parent.l2_wind_deg))"} {"-parent.l3_wind_speed * (parent.time_s - parent.map_frame / max(root.fps, 1)) * sin(radians(parent.l3_wind_deg))"} {"parent.l3_wind_speed * (parent.time_s - parent.map_frame / max(root.fps, 1)) * cos(radians(parent.l3_wind_deg))"}}
