 addUserKnob {13 l1_box_center_prev +INVISIBLE}
 l1_box_center_prev {{"l1_box_found ? \[python -execlocal \{ret = 0\nif nuke.thisNode().input(5) is not None:\n    g = \{'nuke': nuke\}\n    exec(nuke.thisNode()\['box_lib'].getText(), g)\n    ret = g\['box_value'](nuke.thisNode(), 5, -1, 'center:0')\}] : 0"} {"l1_box_found ? \[python -execlocal \{ret = 0\nif nuke.thisNode().input(5) is not None:\n    g = \{'nuke': nuke\}\n    exec(nuke.thisNode()\['box_lib'].getText(), g)\n    ret = g\['box_value'](nuke.thisNode(), 5, -1, 'center:1')\}] : 0"} {"l1_box_found ? \[python -execlocal \{ret = 0\nif nuke.thisNode().input(5) is not None:\n    g = \{'nuke': nuke\}\n    exec(nuke.thisNode()\['box_lib'].getText(), g)\n    ret = g\['box_value'](nuke.thisNode(), 5, -1, 'center:2')\}] : 0"}}
