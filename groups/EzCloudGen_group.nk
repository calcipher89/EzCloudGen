  EzCloudGen_density {{parent.l3_density}}
  EzCloudGen_volume {{parent.l3_volume}}
  EzCloudGen_vol_shape {{parent.l3_vol_shape}}
  EzCloudGen_vol_center {{parent.l3_vol_position.x} {"parent.l3_vol_position.y + parent.l3_vol_size.y / 2 / max(parent.scene_scale, 1e-6)"} {parent.l3_vol_position.z}}
  EzCloudGen_vol_rotate {{parent.l3_vol_rotate.x} {parent.l3_vol_rotate.y} {parent.l3_vol_rotate.z}}
  EzCloudGen_vol_size {{parent.l3_vol_size.x} {parent.l3_vol_size.y} {parent.l3_vol_size.z}}
  EzCloudGen_lumps {{parent.l3_lumps}}
  EzCloudGen_lump_size {{parent.l3_lump_size}}
  EzCloudGen_wisp_size {{parent.l3_wisp_size}}
  EzCloudGen_wisp_amount {{parent.l3_wisp_amount}}
  EzCloudGen_grain_size {{parent.l3_grain_size}}
  EzCloudGen_grain_amount {{parent.l3_grain_amount}}
  EzCloudGen_swirl {{parent.l3_swirl}}
  EzCloudGen_swirl_size {{parent.l3_swirl_size}}
