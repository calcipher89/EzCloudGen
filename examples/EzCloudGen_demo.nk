  EzCloudGen_sun_color {{parent.sun_color_in_use.r} {parent.sun_color_in_use.g} {parent.sun_color_in_use.b}}
  EzCloudGen_sky_color {{parent.sky_color_in_use.r} {parent.sky_color_in_use.g} {parent.sky_color_in_use.b}}
