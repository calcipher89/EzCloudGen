 addUserKnob {7 l2_lumps l lumps t "Big rounded lobes that break the shape into towers and bulges (volumes and decks). Cumulus keep a flat, ragged base under them." R 0 1.5}
 l2_lumps 0.8
 addUserKnob {7 l2_lump_size l "lump size" t "Size of the lumps, in metres." R 20 5000}
 l2_lump_size 900
 addUserKnob {7 l2_small_lumps l "small lumps" t "A second set of lobes, a bit under half the size, riding on the lumps: cauliflower heads."}
 l2_small_lumps 0.35
 addUserKnob {7 l2_skirt l skirt t "Smooth, firm billows on top and a wide, soft skirt of wisps around the base: it calms the erosion higher up, and widens the edge and feeds the wisps low down." R 0 2}
 addUserKnob {7 l2_fade_top l "fade top" t "Eats the cloud away towards the top of its box, this far in (0..1 of the box): the erosion tears the margin up. Fog that sits low and thins out above."}
 addUserKnob {7 l2_fade_bottom l "fade bottom" t "The same towards the bottom of the box."}
 addUserKnob {7 l2_fade_left l "fade left" t "The same towards the box's left side (local -X)."}
 addUserKnob {7 l2_fade_right l "fade right" t "The same towards the box's right side (local +X)."}
 addUserKnob {7 l2_fade_front l "fade front" t "The same towards the box's front (local +Z)."}
 addUserKnob {7 l2_fade_back l "fade back" t "The same towards the box's back (local -Z)."}
 addUserKnob {26 l2_erosion_divider l erosion}
 addUserKnob {7 l2_erosion l billows t "How much the billows (cauliflower bumps, or soft wisps with 'billow' at 0) break up the surface."}
 l2_erosion 0.45
 addUserKnob {7 l2_detail_size l "billow size" t "Size of the billows, in metres." R 10 1000}
 l2_detail_size 220
 addUserKnob {7 l2_wisp_amount l wisps t "Fine wisps that eat into the thin edges."}
 l2_wisp_amount 0.08
 addUserKnob {7 l2_wisp_size l "wisp size" t "Size of the wisps, in metres." R 2 500}
 l2_wisp_size 80
 addUserKnob {7 l2_grain_amount l grain t "The finest breakup of the edges."}
 l2_grain_amount 0.04
 addUserKnob {7 l2_grain_size l "grain size" t "Size of the grain, in metres." R 1 100}
 l2_grain_size 20
 addUserKnob {7 l2_swirl l swirl t "Curls the detail around, for swirly wisps."}
 addUserKnob {7 l2_swirl_size l "swirl size" t "Size of the swirls, in metres." R 20 3000}
 l2_swirl_size 400
 addUserKnob {7 l2_turbulence l turbulence t "A finer, second swirl (a third the size) that makes the edges roll and churn; animate 'evolve' to boil it."}
 addUserKnob {7 l2_crumble l crumble t "Bites chunks out of the thin edges, for torn, ragged cloud and fog."}
 addUserKnob {7 l2_crumble_size l "crumble size" t "Size of the chunks crumble bites out, in metres." R 5 1000}
 l2_crumble_size 120
 addUserKnob {7 l2_shear l "wind shear" t "Leans the tops downwind (along 'wind direction')." R -1 1}
 addUserKnob {26 l2_more_divider l "" +STARTLINE}
 addUserKnob {7 l2_density l density t "Multiplies the cloud density."}
 l2_density 1
 addUserKnob {7 l2_wind_speed l "wind speed" t "Drift along the wind direction, m/s."}
 l2_wind_speed 5
 addUserKnob {7 l2_seed l seed t "Changes this layer's clouds."}
 l2_seed 11
 addUserKnob {20 l2_shape l "more shape" n 2}
 addUserKnob {7 l2_stretch l stretch t "Elongation along the wind (1 = round)." +HIDDEN R 1 10}
 l2_stretch 1
 addUserKnob {7 l2_edge l "edge softness" t "Softness of the cloud edges." R 0.01 0.5}
 l2_edge 0.06
 addUserKnob {7 l2_taper l domes t "How much the clouds narrow going up: cumulus domes and towers." +HIDDEN R 0 2}
 addUserKnob {7 l2_bottom_round l "base rounding" t "Rounding at the base, as a share of the thickness (small = flat base)."}
 l2_bottom_round 0.04
 addUserKnob {7 l2_top_round l "top rounding" t "Rounding at the top, as a share of the thickness." +HIDDEN}
 l2_top_round 0.3
 addUserKnob {7 l2_sigma l "thickness of cloud" t "Extinction per metre: high is dense and hard edged, low is thin and veil-like." R 0.0005 0.1}
 l2_sigma 0.06
 addUserKnob {7 l2_cells l cells t "Cellular rows (altocumulus, cirrocumulus)." +HIDDEN}
 addUserKnob {7 l2_cell_km l "cell size" t "Size of the cells, in km." +HIDDEN R 0.05 2}
 l2_cell_km 0.5
 addUserKnob {7 l2_warp l warp t "How much the shapes swirl." +HIDDEN R 0 4}
 l2_warp 1.2
 addUserKnob {7 l2_forward l "forward scatter" t "How much light the clouds throw forward: the silver lining when backlit." R 0 0.95}
 l2_forward 0.8
 addUserKnob {7 l2_ambient l "sky light" t "How much sky light the layer takes." R 0 3}
 l2_ambient 1
 addUserKnob {7 l2_sky_occlusion l "sky occlusion" t "How much the cloud above darkens the sky light below it: deeper undersides and folds. Lower it for tall storms and thick overcast, which go flat grey under their own mass." R 0 2}
 l2_sky_occlusion 1
 addUserKnob {7 l2_shadow_depth l "shadow depth" t "How far light diffuses through the cloud. 0: it glows right through (soft, luminous shadows). 1: folds and cores stay dark (storms)."}
 addUserKnob {7 l2_octaves l "detail octaves" t "Detail levels (more is finer and slower)." R 0 5}
 l2_octaves 3
 addUserKnob {7 l2_billow l billows t "1: billowy cauliflower detail. 0: soft wisps."}
 l2_billow 1
 addUserKnob {7 l2_streaks l streaks t "1: fibrous streaks (cirrus)." +HIDDEN}
 addUserKnob {7 l2_vary l "height variation" t "How much the base and top move up and down across the deck." +HIDDEN R 0 0.5}
 addUserKnob {20 l2_shape_end l "" -STARTLINE n -1}
 addUserKnob {3 l2_volume +INVISIBLE}
 l2_volume 1
 addUserKnob {20 l3_tab l "Layer 3"}
 addUserKnob {6 l3_enable l enable t "Draw this layer. Layers sort themselves by depth." -STARTLINE}
 addUserKnob {4 l3_type l type t "Sets this layer's shape knobs to the type's values (they can be tuned after)." M {Cumulus "Cumulus Congestus" Stratocumulus Stratus Altocumulus Altostratus Cirrus Cirrocumulus "Hero Cumulus" "Towering Cumulus" "Shelf Cloud" "Storm Anvil" "Fog Bank" "Ground Fog" "Wispy Fog" "Torn Low Cloud" Puff "Soft Cumulus"}}
 l3_type Cirrus
 addUserKnob {7 l3_base l "base height" t "Height of the cloud base above the ground, in metres." R 0 12000}
 l3_base 9000
 addUserKnob {7 l3_thickness l thickness t "Depth of the layer, base to top, in metres." R 50 6000}
 l3_thickness 500
 addUserKnob {7 l3_coverage l coverage t "How much of the sky the layer covers."}
 l3_coverage 0.5
 addUserKnob {7 l3_scale_km l size t "Size of the cloud shapes across the ground, in km." R 0.1 10}
 l3_scale_km 5
 addUserKnob {7 l3_wind_deg l "wind direction" t "Direction the shapes stretch and drift along, in degrees (0 = away from the world -Z axis, 90 = +X)." R -180 180}
 l3_wind_deg 35
 addUserKnob {7 l3_map_amount l "follow map" t "How much this deck follows the coverage map (when 'map' is plugged in)."}
 l3_map_amount 1
 addUserKnob {4 l3_map_channel l "map channel" t "Which channel of the map this deck reads: paint each deck in its own channel to place them separately." -STARTLINE M {luminance red green blue alpha}}
 addUserKnob {26 l3_vol_divider l volume +HIDDEN}
 addUserKnob {4 l3_vol_shape l shape t "The volume's overall shape, before lumps and erosion break it up." +HIDDEN M {Ellipsoid Dome Anvil Box Towers Shelf}}
 l3_vol_shape Dome
 addUserKnob {13 l3_vol_position l position t "Centre of the volume's base, in scene units. Not used while a 3D node is plugged into the layer's box input ('make 3D box')." +HIDDEN}
 addUserKnob {13 l3_vol_rotate l rotate t "Turns the volume, in degrees (Y, then X, then Z)." +HIDDEN}
 addUserKnob {13 l3_vol_size l size t "Width, height and depth of the volume, in metres." +HIDDEN}
 l3_vol_size {3000 1800 3000}
 addUserKnob {22 l3_place l "place in front of camera" t "Puts the volume 'distance' ahead of the camera, on the ground at 'base height'." -STARTLINE +HIDDEN T "n = nuke.thisNode()\nm = n\['cam_world_matrix']\ns = n\['scene_scale'].value() or 1.0\nfx, fz = -m.getValue(2), -m.getValue(10)\nl = (fx * fx + fz * fz) ** 0.5\nif l < 1e-6:\n    fx, fz, l = 0.0, -1.0, 1.0\nd = n\['l3_place_km'].value() * 1000.0 / s\npos = \[m.getValue(3) + fx / l * d, n\['ground_height'].value() + n\['l3_base'].value() / s, m.getValue(11) + fz / l * d]\nbox = n.input(7)\nif box is not None and box.knob('translate') and box.knob('scaling'):\n    # A box plugged in: move the box (its centre is half its height above the base).\n    h = box\['scaling'].value(1) * box\['uniform_scale'].value()\n    box\['translate'].setValue(\[pos\[0], pos\[1] + h / 2.0, pos\[2]])\nelse:\n    n\['l3_vol_position'].setValue(pos)\n"}
 addUserKnob {7 l3_place_km l distance t "How far ahead 'place in front of camera' puts it, km." -STARTLINE +HIDDEN}
 l3_place_km 10
 addUserKnob {22 l3_make_box l "make 3D box" t "Makes a Cube beside this node, placed and sized like the volume, and plugs it into this layer's box input (box3): move, rotate and scale the Cube in the 3D viewer (view it with your camera) and the cloud follows. Any 3D node works in that input (a Cube, an Axis, a TransformGeo, parented or tracked), and the volume fills its box." -STARTLINE +HIDDEN T "n = nuke.thisNode()\np = 'l3_'\nidx = 7\ns = n\['scene_scale'].value() or 1.0\nif n.input(idx) is None:\n    path = n.fullName().split('.')\n    ctx = nuke.toNode('.'.join(path\[:-1])) if len(path) > 1 else nuke.root()\n    ctx.begin()\n    c = nuke.nodes.Cube(name=n.name() + '_L3_Box')\n    ctx.end()\n    c.setXYpos(n.xpos() - 150, n.ypos() - 60 * 2)\n    pos = n\[p + 'vol_position'].value()\n    size = n\[p + 'vol_size'].value()\n    # The kernel turns the volume Y, then X, then Z.\n    c\['rot_order'].setValue('YXZ')\n    c\['translate'].setValue(\[pos\[0], pos\[1] + size\[1] / s / 2.0, pos\[2]])\n    c\['rotate'].setValue(n\[p + 'vol_rotate'].value())\n    c\['scaling'].setValue(\[size\[0] / s, size\[1] / s, size\[2] / s])\n    c\['display'].setValue('wireframe')\n    c\['render_mode'].setValue('off')\n    c\['label'].setValue('cloud volume: ' + n.name() + ' layer 3')\n    c\['tile_color'].setValue(0x8fb3d9ff)\n    n.setInput(idx, c)\n"}
 addUserKnob {22 l3_release_box l "release box" t "Unplugs the box; the volume stays where it is." -STARTLINE +HIDDEN T "n = nuke.thisNode()\np = 'l3_'\nimport math\nif n\[p + 'box_found'].value() > 0.5:\n    s = n\['scene_scale'].value() or 1.0\n    c = n\[p + 'box_center'].value()\n    size = n\[p + 'box_size'].value()\n    ax = n\[p + 'box_axis_x'].value()\n    ay = n\[p + 'box_axis_y'].value()\n    az = n\[p + 'box_axis_z'].value()\n    # The kernel's R = Rz Rx Ry: axis_y = (-sin z cos x, cos z cos x, sin x), and so on.\n    rx = math.degrees(math.asin(max(-1.0, min(1.0, ay\[2]))))\n    rz = math.degrees(math.atan2(-ay\[0], ay\[1]))\n    ry = math.degrees(math.atan2(-ax\[2], az\[2]))\n    n\[p + 'vol_rotate'].setValue(\[rx, ry, rz])\n    n\[p + 'vol_size'].setValue(list(size))\n    n\[p + 'vol_position'].setValue(\[c\[0], c\[1] - size\[1] / s / 2.0, c\[2]])\nn.setInput(7, None)\n"}
