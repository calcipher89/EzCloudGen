  EzCloudGen_vol_center {{parent.l2_vol_position.x} {"parent.l2_vol_position.y + parent.l2_vol_size.y / 2 / max(parent.scene_scale, 1e-6)"} {parent.l2_vol_position.z}}
  EzCloudGen_vol_rotate {{parent.l2_vol_rotate.x} {parent.l2_vol_rotate.y} {parent.l2_vol_rotate.z}}
