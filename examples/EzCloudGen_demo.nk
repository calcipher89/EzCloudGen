 addUserKnob {7 l3_wind_speed l "wind speed" t "Drift along the wind direction, m/s."}
 l3_wind_speed 5
 addUserKnob {7 l3_seed l seed t "Changes this layer's clouds."}
 l3_seed 22
 addUserKnob {20 l3_shape l shape n 2}
 addUserKnob {7 l3_stretch l stretch t "Elongation along the wind (1 = round)." R 1 10}
 l3_stretch 7
 addUserKnob {7 l3_edge l "edge softness" t "Softness of the cloud edges." R 0.01 0.5}
 l3_edge 0.25
 addUserKnob {7 l3_taper l domes t "How much the clouds narrow going up: cumulus domes and towers." R 0 2}
 addUserKnob {7 l3_bottom_round l "base rounding" t "Rounding at the base, as a share of the thickness (small = flat base)."}
 l3_bottom_round 0.4
 addUserKnob {7 l3_top_round l "top rounding" t "Rounding at the top, as a share of the thickness."}
 l3_top_round 0.4
 addUserKnob {7 l3_detail_size l "detail size" t "Size of the billows and wisps on the surface, in metres." R 10 1000}
 l3_detail_size 150
 addUserKnob {7 l3_erosion l "detail amount" t "How much the detail breaks up the surface."}
 l3_erosion 0.6
 addUserKnob {7 l3_sigma l "thickness of cloud" t "Extinction per metre: high is dense and hard edged, low is thin and veil-like." R 0.0005 0.1}
 l3_sigma 0.0012
 addUserKnob {7 l3_cells l cells t "Cellular rows (altocumulus, cirrocumulus)."}
 addUserKnob {7 l3_cell_km l "cell size" t "Size of the cells, in km." R 0.05 2}
 l3_cell_km 0.5
 addUserKnob {7 l3_warp l warp t "How much the shapes swirl." R 0 4}
 l3_warp 2.5
 addUserKnob {7 l3_forward l "forward scatter" t "How much light the clouds throw forward: the silver lining when backlit." R 0 0.95}
 l3_forward 0.85
 addUserKnob {7 l3_ambient l "sky light" t "How much sky light the layer takes." R 0 3}
 l3_ambient 1.2
 addUserKnob {7 l3_octaves l "detail octaves" t "Detail levels (more is finer and slower)." R 0 5}
 l3_octaves 2
 addUserKnob {7 l3_billow l billows t "1: billowy cauliflower detail. 0: soft wisps."}
 addUserKnob {7 l3_streaks l streaks t "1: fibrous streaks (cirrus)."}
 l3_streaks 1
 addUserKnob {7 l3_vary l "height variation" t "How much the base and top move up and down across the deck." R 0 0.5}
 addUserKnob {20 l3_shape_end l "" -STARTLINE n -1}
 addUserKnob {20 about l About}
 addUserKnob {26 version l "" +STARTLINE T "EzCloudGen v0.1.0"}
 addUserKnob {78 cam_world_matrix l "camera matrix" +INVISIBLE n 16}
