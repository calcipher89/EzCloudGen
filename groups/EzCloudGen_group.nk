  KernelDescription "3 \"EzCloudGenStack\" iterate pixelWise 642d3a4eb96ba50d858c220d27e02e90881a06257194b715815f9ec37e3b6628 7 \"c1\" Read Point \"c2\" Read Point \"c3\" Read Point \"z1\" Read Point \"z2\" Read Point \"z3\" Read Point \"dst\" Write Point 0 0 0"
  kernelSource "// EzCloudGenStack: puts up to three cloud layers over each other nearest first, per pixel.\n//\n// c1..c3 are premultiplied images of the layers (colour, sun share, or Planar Z times alpha).\n// z1..z3 are the layers' depth passes (rgb = Planar Z, a = opacity), only used to order them:\n// a layer with no opacity at a pixel counts as furthest. The result is c_near over c_mid over\n// c_far, so placed volumes and decks sort themselves out wherever they are.\n\nkernel EzCloudGenStack : ImageComputationKernel<ePixelWise>\n\{\n  Image<eRead, eAccessPoint, eEdgeClamped> c1;\n  Image<eRead, eAccessPoint, eEdgeClamped> c2;\n  Image<eRead, eAccessPoint, eEdgeClamped> c3;\n  Image<eRead, eAccessPoint, eEdgeClamped> z1;\n  Image<eRead, eAccessPoint, eEdgeClamped> z2;\n  Image<eRead, eAccessPoint, eEdgeClamped> z3;\n  Image<eWrite> dst;\n\n  float key(float4 z)\n  \{\n    return z.w > 1e-6f ? z.x : 1e30f;\n  \}\n\n  float4 over(float4 a, float4 b)\n  \{\n    return a + b * (1.0f - a.w);\n  \}\n\n  void process()\n  \{\n    float4 a = c1();\n    float4 b = c2();\n    float4 c = c3();\n    float ka = key(z1());\n    float kb = key(z2());\n    float kc = key(z3());\n    // Sort three by key, nearest first.\n    if (kb < ka) \{\n      float4 t = a;\n      a = b;\n      b = t;\n      float k = ka;\n      ka = kb;\n      kb = k;\n    \}\n    if (kc < kb) \{\n      float4 t = b;\n      b = c;\n      c = t;\n      float k = kb;\n      kb = kc;\n      kc = k;\n    \}\n    if (kb < ka) \{\n      float4 t = a;\n      a = b;\n      b = t;\n    \}\n    dst() = over(a, over(b, c));\n  \}\n\};\n"
  rebuild ""
  rebuild_finalise ""
  name Depth_Stack
  xpos 180
  ypos 996
 }
