 BlinkScript {
  recompileCount 2
  KernelDescription "3 \"EzCloudGen\" iterate pixelWise 98164f0b3c0722d4d3c6a845dca5fbb76c025e5da0d846b32d21b869a8d9143a 2 \"src\" Read Point \"dst\" Write Point 48 \"output\" Int 1 AAAAAA== \"cam_row0\" Float 3 AACAPwAAAAAAAAAAAAAAAA== \"cam_row1\" Float 3 AAAAAAAAgD8AAAAAAAAAAA== \"cam_row2\" Float 3 AAAAAAAAAAAAAIA/AAAAAA== \"cam_position\" Float 3 AAAAAACAO0UAAAAAAAAAAA== \"focal\" Float 1 AADAQQ== \"haperture\" Float 1 AAAQQg== \"frame_size\" Float 2 AADwRAAAh0Q= \"scene_scale\" Float 1 zczMPQ== \"ground_height\" Float 1 AAAAAA== \"sun_direction\" Float 3 AAAAAAAAAD8AAIC/AAAAAA== \"sun_rotation\" Float 1 AAAAAA== \"sun_color\" Float 3 AACAPzMzcz+amVk/AAAAAA== \"sky_color\" Float 3 mpmZPmZm5j7NzEw/AAAAAA== \"ground_color\" Float 3 j8L1Pa5H4T3sUbg9AAAAAA== \"haze_color\" Float 3 mpkZP3sULj/NzEw/AAAAAA== \"haze_distance\" Float 1 AGBqRw== \"max_distance\" Float 1 AECcRw== \"quality\" Float 1 AACAPw== \"samples\" Int 1 AQAAAA== \"seed\" Float 1 AAAAAA== \"evolve\" Float 1 AAAAAA== \"offset\" Float 2 AAAAAAAAAAA= \"gap_amount\" Float 1 AAAAAA== \"gap_size\" Float 1 AAD6RA== \"base\" Float 1 AACvRA== \"thickness\" Float 1 AICiRA== \"coverage\" Float 1 PQrXPg== \"scale_km\" Float 1 zczMPw== \"stretch\" Float 1 AACAPw== \"wind_deg\" Float 1 AACgQQ== \"edge\" Float 1 j8J1PQ== \"taper\" Float 1 mplZPw== \"bottom_round\" Float 1 CtcjPQ== \"top_round\" Float 1 mpkZPg== \"detail_size\" Float 1 AABcQw== \"erosion\" Float 1 ZmbmPg== \"sigma\" Float 1 j8J1PQ== \"cells\" Float 1 AAAAAA== \"cell_km\" Float 1 AAAAPw== \"warp\" Float 1 mpmZPw== \"forward\" Float 1 zcxMPw== \"ambient\" Float 1 AACAPw== \"octaves\" Float 1 AABgQA== \"billow\" Float 1 AACAPw== \"streaks\" Float 1 AAAAAA== \"vary\" Float 1 AAAAAA== \"density\" Float 1 AACAPw== 48 \"output\" 1 1 Default \"camRow0\" 3 1 Default \"camRow1\" 3 1 Default \"camRow2\" 3 1 Default \"camPosition\" 3 1 Default \"focal\" 1 1 Default \"haperture\" 1 1 Default \"frameSize\" 2 1 Default \"sceneScale\" 1 1 Default \"groundHeight\" 1 1 Default \"sunDirection\" 3 1 Default \"sunRotation\" 1 1 Default \"sunColor\" 3 1 Default \"skyColor\" 3 1 Default \"groundColor\" 3 1 Default \"hazeColor\" 3 1 Default \"hazeDistance\" 1 1 Default \"maxDistance\" 1 1 Default \"quality\" 1 1 Default \"samples\" 1 1 Default \"seed\" 1 1 Default \"evolve\" 1 1 Default \"offset\" 2 1 Default \"gapAmount\" 1 1 Default \"gapSize\" 1 1 Default \"base\" 1 1 Default \"thickness\" 1 1 Default \"coverage\" 1 1 Default \"scaleKm\" 1 1 Default \"stretch\" 1 1 Default \"windDeg\" 1 1 Default \"edge\" 1 1 Default \"taper\" 1 1 Default \"bottomRound\" 1 1 Default \"topRound\" 1 1 Default \"detailSize\" 1 1 Default \"erosion\" 1 1 Default \"sigma\" 1 1 Default \"cells\" 1 1 Default \"cellKm\" 1 1 Default \"warp\" 1 1 Default \"forward\" 1 1 Default \"ambient\" 1 1 Default \"octaves\" 1 1 Default \"billow\" 1 1 Default \"streaks\" 1 1 Default \"vary\" 1 1 Default \"density\" 1 1 Default 8 \"R\" Float 1 1 AAAAAA== \"pi\" Float 1 1 AAAAAA== \"sun\" Float 3 1 AAAAAAAAAAAAAAAAAAAAAA== \"camAlt\" Float 1 1 AAAAAA== \"ca\" Float 1 1 AAAAAA== \"sa\" Float 1 1 AAAAAA== \"gapX\" Float 1 1 AAAAAA== \"gapZ\" Float 1 1 AAAAAA=="
  kernelSource "// EzCloudGen: one procedural, volumetric cloud layer, ray marched through the shot camera.\n// Ported from the prototype in reference/clouds.py.\n//\n// Metres inside, +Y up. The earth is curved: the layer is a shell from `base` to\n// `base + thickness` above the ground, so a deck converges on the horizon. The camera sits at\n// camPosition (scene units, times sceneScale for metres) with its height above the ground at\n// (camPosition.y - groundHeight) * sceneScale.\n//\n// Shape: a 2D weather field (warped fbm, ridged streaks, Worley cells) thresholded by coverage\n// and shrunk with height by a profile (flat base, rounded top, domes with `taper`). Then the\n// surface is displaced by 3D detail noise (inverted Worley billows or value-noise wisps). Detail\n// octaves drop with distance, so far clouds don't sparkle.\n//\n// Light: a short march towards the sun, four multiple-scattering octaves with a dual\n// Henyey-Greenstein phase (silver linings when backlit), a powder term (dark edges), sky light\n// from above and ground bounce from below, energy-conserving integration, and aerial\n// perspective towards hazeColor over hazeDistance.\n//\n// output 0: rgb = cloud colour (premultiplied), a = opacity.\n// output 1: rgb = the direct sun share of output 0's rgb (premultiplied), a = opacity.\n// output 2: rgb = Planar Z of the clouds in scene units (opacity-weighted), a = opacity.\n//           No lighting, so it is cheap.\n//\n// `src` only sets the format: pixel (x, y) maps to the camera frame by frameSize.\n\nkernel EzCloudGen : ImageComputationKernel<ePixelWise>\n\{\n  Image<eRead, eAccessPoint, eEdgeClamped> src;\n  Image<eWrite> dst;\n\nparam:\n  int output;\n  float3 camRow0;\n  float3 camRow1;\n  float3 camRow2;\n  float3 camPosition;\n  float focal;\n  float haperture;\n  float2 frameSize;\n  float sceneScale;\n  float groundHeight;\n  float3 sunDirection;\n  float sunRotation;\n  float3 sunColor;\n  float3 skyColor;\n  float3 groundColor;\n  float3 hazeColor;\n  float hazeDistance;\n  float maxDistance;\n  float quality;\n  int samples;\n  float seed;\n  float evolve;\n  float2 offset;\n  float gapAmount;\n  float gapSize;\n  // The cloud type.\n  float base;\n  float thickness;\n  float coverage;\n  float scaleKm;\n  float stretch;\n  float windDeg;\n  float edge;\n  float taper;\n  float bottomRound;\n  float topRound;\n  float detailSize;\n  float erosion;\n  float sigma;\n  float cells;\n  float cellKm;\n  float warp;\n  float forward;\n  float ambient;\n  float octaves;\n  float billow;\n  float streaks;\n  float vary;\n  float density;\n\nlocal:\n  float R;\n  float pi;\n  float3 sun;\n  float camAlt;\n  float ca;\n  float sa;\n  float gapX;\n  float gapZ;\n\n  void define()\n  \{\n    defineParam(output, \"output\", 0);\n    defineParam(camRow0, \"cam_row0\", float3(1.0f, 0.0f, 0.0f));\n    defineParam(camRow1, \"cam_row1\", float3(0.0f, 1.0f, 0.0f));\n    defineParam(camRow2, \"cam_row2\", float3(0.0f, 0.0f, 1.0f));\n    defineParam(camPosition, \"cam_position\", float3(0.0f, 3000.0f, 0.0f));\n    defineParam(focal, \"focal\", 24.0f);\n    defineParam(haperture, \"haperture\", 36.0f);\n    defineParam(frameSize, \"frame_size\", float2(1920.0f, 1080.0f));\n    defineParam(sceneScale, \"scene_scale\", 0.1f);\n    defineParam(groundHeight, \"ground_height\", 0.0f);\n    defineParam(sunDirection, \"sun_direction\", float3(0.0f, 0.5f, -1.0f));\n    defineParam(sunRotation, \"sun_rotation\", 0.0f);\n    defineParam(sunColor, \"sun_color\", float3(1.0f, 0.95f, 0.85f));\n    defineParam(skyColor, \"sky_color\", float3(0.3f, 0.45f, 0.8f));\n    defineParam(groundColor, \"ground_color\", float3(0.12f, 0.11f, 0.09f));\n    defineParam(hazeColor, \"haze_color\", float3(0.6f, 0.68f, 0.8f));\n    defineParam(hazeDistance, \"haze_distance\", 60000.0f);\n    defineParam(maxDistance, \"max_distance\", 80000.0f);\n    defineParam(quality, \"quality\", 1.0f);\n    defineParam(samples, \"samples\", 1);\n    defineParam(seed, \"seed\", 0.0f);\n    defineParam(evolve, \"evolve\", 0.0f);\n    defineParam(offset, \"offset\", float2(0.0f, 0.0f));\n    defineParam(gapAmount, \"gap_amount\", 0.0f);\n    defineParam(gapSize, \"gap_size\", 2000.0f);\n    defineParam(base, \"base\", 1400.0f);\n    defineParam(thickness, \"thickness\", 1300.0f);\n    defineParam(coverage, \"coverage\", 0.42f);\n    defineParam(scaleKm, \"scale_km\", 1.6f);\n    defineParam(stretch, \"stretch\", 1.0f);\n    defineParam(windDeg, \"wind_deg\", 20.0f);\n    defineParam(edge, \"edge\", 0.06f);\n    defineParam(taper, \"taper\", 0.85f);\n    defineParam(bottomRound, \"bottom_round\", 0.04f);\n    defineParam(topRound, \"top_round\", 0.15f);\n    defineParam(detailSize, \"detail_size\", 220.0f);\n    defineParam(erosion, \"erosion\", 0.45f);\n    defineParam(sigma, \"sigma\", 0.06f);\n    defineParam(cells, \"cells\", 0.0f);\n    defineParam(cellKm, \"cell_km\", 0.5f);\n    defineParam(warp, \"warp\", 1.2f);\n    defineParam(forward, \"forward\", 0.8f);\n    defineParam(ambient, \"ambient\", 1.0f);\n    defineParam(octaves, \"octaves\", 3.5f);\n    defineParam(billow, \"billow\", 1.0f);\n    defineParam(streaks, \"streaks\", 0.0f);\n    defineParam(vary, \"vary\", 0.0f);\n    defineParam(density, \"density\", 1.0f);\n  \}\n\n  void init()\n  \{\n    R = 6371000.0f;\n    pi = 3.14159265358979f;\n    // The sun direction turned by sunRotation about +Y (an EzAtmosScatter's HDRI rotation).\n    float r = -sunRotation * pi / 180.0f;\n    float3 sd = normalize(sunDirection);\n    sun = float3(sd.x * cos(r) + sd.z * sin(r), sd.y, -sd.x * sin(r) + sd.z * cos(r));\n    camAlt = max((camPosition.y - groundHeight) * sceneScale, 1.0f);\n    float a = windDeg * pi / 180.0f;\n    ca = cos(a);\n    sa = sin(a);\n    // Where the line from the camera to the sun crosses the cloud base: the gap opens there.\n    float up = max(sun.y, 0.02f);\n    float rise = base + 0.5f * thickness - camAlt;\n    gapX = sun.x / up * rise;\n    gapZ = sun.z / up * rise;\n  \}\n\n  // ---- Noise (float only) -----------------------------------------------------------------\n\n  float fr(float v)\n  \{\n    return v - floor(v);\n  \}\n\n  // Dave Hoskins' hash13.\n  float hash3(float x, float y, float z)\n  \{\n    float px = fr(x * 0.1031f);\n    float py = fr(y * 0.1031f);\n    float pz = fr(z * 0.1031f);\n    float d = px * (py + 33.33f) + py * (pz + 33.33f) + pz * (px + 33.33f);\n    px += d;\n    py += d;\n    pz += d;\n    return fr((px + py) * pz);\n  \}\n\n  float fade5(float f)\n  \{\n    return f * f * f * (f * (f * 6.0f - 15.0f) + 10.0f);\n  \}\n\n  float vnoise3(float x, float y, float z)\n  \{\n    float ix = floor(x);\n    float iy = floor(y);\n    float iz = floor(z);\n    float ux = fade5(x - ix);\n    float uy = fade5(y - iy);\n    float uz = fade5(z - iz);\n    float a = hash3(ix, iy, iz);\n    float b = hash3(ix + 1.0f, iy, iz);\n    float c = hash3(ix, iy + 1.0f, iz);\n    float d = hash3(ix + 1.0f, iy + 1.0f, iz);\n    float e = hash3(ix, iy, iz + 1.0f);\n    float f = hash3(ix + 1.0f, iy, iz + 1.0f);\n    float g = hash3(ix, iy + 1.0f, iz + 1.0f);\n    float h = hash3(ix + 1.0f, iy + 1.0f, iz + 1.0f);\n    float k0 = a + (b - a) * ux;\n    float k1 = c + (d - c) * ux;\n    float k2 = e + (f - e) * ux;\n    float k3 = g + (h - g) * ux;\n    float l0 = k0 + (k1 - k0) * uy;\n    float l1 = k2 + (k3 - k2) * uy;\n    return l0 + (l1 - l0) * uz;\n  \}\n\n  float vnoise2(float x, float y)\n  \{\n    return vnoise3(x, y, 17.31f + seed * 1.37f);\n  \}\n\n  float fbm2(float x, float y, float oct)\n  \{\n    float s = 0.0f;\n    float amp = 0.5f;\n    float tot = 0.0f;\n    int n = int(floor(oct));\n    for (int i = 0; i <= n; i++) \{\n      float w = i < n ? 1.0f : oct - float(n);\n      if (w <= 0.0f)\n        break;\n      s += amp * w * vnoise2(x, y);\n      tot += amp * w;\n      amp *= 0.5f;\n      float nx = 1.6f * x + 1.2f * y + 13.7f;\n      y = -1.2f * x + 1.6f * y + 7.3f;\n      x = nx;\n    \}\n    return s / max(tot, 1e-6f);\n  \}\n\n  float ridged2(float x, float y, float oct)\n  \{\n    float s = 0.0f;\n    float amp = 0.5f;\n    float tot = 0.0f;\n    int n = int(floor(oct));\n    for (int i = 0; i <= n; i++) \{\n      float w = i < n ? 1.0f : oct - float(n);\n      if (w <= 0.0f)\n        break;\n      float v = 1.0f - fabs(2.0f * vnoise2(x, y) - 1.0f);\n      s += amp * w * v * v;\n      tot += amp * w;\n      amp *= 0.55f;\n      float nx = 1.7f * x + 1.1f * y + 5.1f;\n      y = -1.1f * x + 1.7f * y + 9.2f;\n      x = nx;\n    \}\n    return s / max(tot, 1e-6f);\n  \}\n\n  float worley2(float x, float y)\n  \{\n    float ix = floor(x);\n    float iy = floor(y);\n    float best = 9.0f;\n    for (int j = -1; j <= 1; j++) \{\n      for (int i = -1; i <= 1; i++) \{\n        float cx = ix + float(i);\n        float cy = iy + float(j);\n        float dx = cx + hash3(cx, cy, 3.7f + seed) - x;\n        float dy = cy + hash3(cx, cy, 11.3f + seed) - y;\n        best = min(best, dx * dx + dy * dy);\n      \}\n    \}\n    return sqrt(best);\n  \}\n\n  float worley3(float x, float y, float z)\n  \{\n    float ix = floor(x);\n    float iy = floor(y);\n    float iz = floor(z);\n    float best = 9.0f;\n    for (int k = -1; k <= 1; k++) \{\n      for (int j = -1; j <= 1; j++) \{\n        for (int i = -1; i <= 1; i++) \{\n          float cx = ix + float(i);\n          float cy = iy + float(j);\n          float cz = iz + float(k);\n          float dx = cx + hash3(cx, cy, cz) - x;\n          float dy = cy + hash3(cy, cz, cx + 7.1f) - y;\n          float dz = cz + hash3(cz, cx, cy + 3.3f) - z;\n          best = min(best, dx * dx + dy * dy + dz * dz);\n        \}\n      \}\n    \}\n    return min(sqrt(best), 1.0f);\n  \}\n\n  // Billowy (inverted Worley, cauliflower) mixed with wispy value noise.\n  float detail3(float x, float y, float z, float oct)\n  \{\n    float s = 0.0f;\n    float amp = 0.5f;\n    float tot = 0.0f;\n    int n = int(floor(oct));\n    for (int i = 0; i <= n; i++) \{\n      float w = i < n ? 1.0f : oct - float(n);\n      if (w <= 0.0f)\n        break;\n      float b = billow > 0.0f ? 1.0f - worley3(x, y, z) : 0.0f;\n      float v = billow < 1.0f ? vnoise3(x * 1.3f, y * 1.3f, z * 1.3f) : 0.0f;\n      s += amp * w * (billow * b + (1.0f - billow) * v);\n      tot += amp * w;\n      amp *= 0.5f;\n      x = x * 2.03f + 1.7f;\n      y = y * 2.03f + 3.1f;\n      z = z * 2.03f + 5.3f;\n    \}\n    return s / max(tot, 1e-6f);\n  \}\n\n  float sstep(float a, float b, float x)\n  \{\n    float t = clamp((x - a) / (b - a), 0.0f, 1.0f);\n    return t * t * (3.0f - 2.0f * t);\n  \}\n\n  float lg2(float v)\n  \{\n    return log(v) * 1.44269504f;\n  \}\n\n  // ---- Shape --------------------------------------------------------------------------------\n\n  // Coverage at local ground position X, Z (m, camera at 0, 0): positive inside a cloud.\n  float weather(float X, float Z, float foot)\n  \{\n    float sc = scaleKm * 1000.0f;\n    float gx = X - gapX;\n    float gz = Z - gapZ;\n    // World position plus drift.\n    X += camPosition.x * sceneScale + offset.x;\n    Z += camPosition.z * sceneScale + offset.y;\n    float u = (X * ca + Z * sa) / sc;\n    float v = (-X * sa + Z * ca) / (sc * stretch);\n    float oct = min(6.0f, max(1.0f, lg2(max(sc / max(foot, 1.0f), 1.0f)) - 0.5f));\n    float wx = fbm2(u * 0.5f + 3.1f, v * 0.5f, 3.0f) - 0.5f;\n    float wz = fbm2(u * 0.5f + 9.7f, v * 0.5f + 5.0f, 3.0f) - 0.5f;\n    float u2 = u + wx * warp;\n    float v2 = v + wz * warp;\n    float f;\n    if (streaks > 0.5f)\n      f = ridged2(u2, v2, oct) * (0.55f + 0.9f * fbm2(u * 0.3f + 40.0f, v * 0.3f, 3.0f));\n    else\n      f = fbm2(u2, v2, oct);\n    float c = f - (0.82f - 0.55f * coverage);\n    if (cells > 0.0f) \{\n      float cs = cellKm * 1000.0f;\n      float cu = (X * ca + Z * sa) / cs;\n      float cv = (-X * sa + Z * ca) / (cs * 0.6f);\n      // The cells fade out when they get smaller than a few pixels.\n      float fd = sstep(1.5f, 5.0f, cs / max(foot, 1.0f));\n      float cell = worley2(cu + wx * 0.8f, cv + wz * 0.8f);\n      c -= cells * fd * (cell - 0.45f) * 0.35f;\n    \}\n    if (gapAmount > 0.0f)\n      c -= gapAmount * 0.5f * exp(-(gx * gx + gz * gz) / (gapSize * gapSize));\n    return c;\n  \}\n\n  // How much the coverage shrinks at height hn (0 base, 1 top).\n  float profile(float hn)\n  \{\n    float k = 0.3f * (1.0f - sstep(0.0f, max(bottomRound, 1e-3f), hn));\n    k += 0.3f * sstep(1.0f - max(topRound, 1e-3f), 1.0f, hn);\n    k += taper * 0.32f * hn * sqrt(hn);\n    return k;\n  \}\n\n  // Height above the curved ground of local point p (camera above 0, 0).\n  float altitude(float3 p)\n  \{\n    float h2 = p.x * p.x + p.z * p.z;\n    float y = p.y;\n    // sqrt((R + y)^2 + h2) - R, without losing the metres in R^2.\n    return (2.0f * R * y + y * y + h2) / (sqrt((R + y) * (R + y) + h2) + R);\n  \}\n\n  // Cloud density 0..1. cheap: no detail noise (for the light march).\n  float cloud(float3 p, float foot, bool cheap)\n  \{\n    float alt = altitude(p);\n    float b = base;\n    float c = weather(p.x, p.z, foot);\n    if (c <= -0.12f)\n      return 0.0f;\n    if (vary > 0.0f) \{\n      float sv = scaleKm * 2500.0f;\n      float vx = p.x + camPosition.x * sceneScale + offset.x;\n      float vz = p.z + camPosition.z * sceneScale + offset.y;\n      b += (vnoise2(vx / sv + 70.0f, vz / sv) - 0.5f) * vary * thickness;\n    \}\n    float hn = (alt - b) / thickness;\n    if (hn <= 0.0f || hn >= 1.0f)\n      return 0.0f;\n    c -= profile(hn);\n    float e = max(edge, 1e-3f);\n    if (cheap || erosion <= 0.0f)\n      return clamp(c / e, 0.0f, 1.0f);\n    if (c < -0.12f * erosion)\n      return 0.0f;\n    float oct = min(octaves, max(0.0f, lg2(max(detailSize / max(2.5f * foot, 1.0f), 1.0f))));\n    if (oct > 0.0f) \{\n      float wx = p.x + camPosition.x * sceneScale + offset.x;\n      float wz = p.z + camPosition.z * sceneScale + offset.y;\n      // The detail rises slowly (boil) with evolve.\n      float n = detail3(wx / detailSize, (alt - evolve) / detailSize, wz / detailSize, oct);\n      c += erosion * (n - 0.5f) * 0.24f;\n    \}\n    return clamp(c / e, 0.0f, 1.0f);\n  \}\n\n  // ---- Rays ---------------------------------------------------------------------------------\n\n  // Ray from local o along d vs the sphere of radius R + h around (0, -R, 0).\n  bool sphere(float3 o, float3 d, float h, float &t0, float &t1)\n  \{\n    float oy = o.y + R;\n    float b = o.x * d.x + oy * d.y + o.z * d.z;\n    // |o - centre|^2 - r^2, without losing the metres in R^2.\n    float c = o.x * o.x + o.z * o.z + (o.y - h) * (2.0f * R + o.y + h);\n    float disc = b * b - c;\n    if (disc < 0.0f)\n      return false;\n    float s = sqrt(disc);\n    float q = b > 0.0f ? -b - s : -b + s;\n    float r0 = q;\n    float r1 = fabs(q) > 1e-6f ? c / q : -b;\n    t0 = min(r0, r1);\n    t1 = max(r0, r1);\n    return true;\n  \}\n\n  float hg(float g, float c)\n  \{\n    float gg = g * g;\n    return (1.0f - gg) / (4.0f * pi * pow(1.0f + gg - 2.0f * g * c, 1.5f));\n  \}\n\n  // Optical depth towards the sun from p, inside the layer.\n  float sunDepth(float3 p, float foot)\n  \{\n    float t0 = 0.0f;\n    float t1 = 0.0f;\n    float far = 0.0f;\n    if (sphere(p, sun, base + thickness * (1.0f + vary), t0, t1))\n      far = max(t1, 0.0f);\n    far = min(far, min(6.0f * thickness / max(sun.y, 0.08f), 12000.0f));\n    int steps = max(int(6.0f * quality), 2);\n    float od = 0.0f;\n    float prev = 0.0f;\n    for (int i = 0; i < steps; i++) \{\n      float f = (float(i) + 0.5f) / float(steps);\n      float t = far * f * f;\n      float dt = t - prev;\n      prev = t;\n      od += cloud(p + sun * t, foot + t * 0.02f, i > 1) * dt;\n    \}\n    return od;\n  \}\n\n  void process(int2 pos)\n  \{\n    float3 cam = float3(0.0f, camAlt, 0.0f);\n    float hap = haperture;\n    float vap = haperture * frameSize.y / frameSize.x;\n    float pixAng = hap / focal / frameSize.x;\n    float sig0 = sigma * density;\n    // The layer's shell, with room for `vary`.\n    float hb = base - thickness * vary;\n    float ht = base + thickness * (1.0f + vary);\n\n    float4 acc = float4(0.0f);\n    int ns = max(samples, 1);\n    for (int s = 0; s < ns; s++) \{\n      float jx = ns > 1 ? hash3(pos.x + 0.5f, pos.y + 0.5f, float(s) * 7.0f + seed) : 0.5f;\n      float jy = ns > 1 ? hash3(pos.y + 1.5f, pos.x + 2.5f, float(s) * 3.0f + 5.0f) : 0.5f;\n      float u = (pos.x + jx) / frameSize.x;\n      float v = (pos.y + jy) / frameSize.y;\n      float3 cd = float3((u - 0.5f) * hap / focal, (v - 0.5f) * vap / focal, -1.0f);\n      float3 d = normalize(float3(dot(camRow0, cd), dot(camRow1, cd), dot(camRow2, cd)));\n      // Planar Z per metre along the ray.\n      float zPer = 1.0f / length(cd);\n      float cosT = dot(d, sun);\n\n      // Where the ray is inside the shell: \[a0, a1] (outer) minus (b0, b1) (inner), before\n      // the ground and maxDistance.\n      float tmax = maxDistance;\n      float g0 = 0.0f;\n      float g1 = 0.0f;\n      if (sphere(cam, d, 0.0f, g0, g1) && g0 > 0.0f)\n        tmax = min(tmax, g0);\n      float a0 = 0.0f;\n      float a1 = 0.0f;\n      float b0 = 0.0f;\n      float b1 = 0.0f;\n      float i0s = 0.0f;\n      float i0e = 0.0f;\n      float i1s = 0.0f;\n      float i1e = 0.0f;\n      int n = 0;\n      if (sphere(cam, d, ht, a0, a1) && a1 > 0.0f) \{\n        float s0 = max(a0, 0.0f);\n        float s1 = min(a1, tmax);\n        if (!sphere(cam, d, hb, b0, b1)) \{\n          if (s1 > s0) \{\n            i0s = s0;\n            i0e = s1;\n            n = 1;\n          \}\n        \} else \{\n          if (min(b0, s1) > s0) \{\n            i0s = s0;\n            i0e = min(b0, s1);\n            n = 1;\n          \}\n          if (s1 > max(b1, s0)) \{\n            if (n == 0) \{\n              i0s = max(b1, s0);\n              i0e = s1;\n            \} else \{\n              i1s = max(b1, s0);\n              i1e = s1;\n            \}\n            n += 1;\n          \}\n        \}\n      \}\n\n      float T = 1.0f;\n      float3 col = float3(0.0f);\n      float3 sunPart = float3(0.0f);\n      float dep = 0.0f;\n      float minStep = max(min(thickness / 24.0f, detailSize * 0.35f) / quality, 8.0f);\n      int maxSteps = int(220.0f * quality);\n      for (int k = 0; k < n; k++) \{\n        float t = k == 0 ? i0s : i1s;\n        float tEnd = k == 0 ? i0e : i1e;\n        bool first = true;\n        int steps = 0;\n        while (t < tEnd && T > 0.01f && steps < maxSteps) \{\n          steps++;\n          float foot = max(t * pixAng, 0.5f);\n          float dt = max(minStep, t * 0.012f / quality);\n          if (first) \{\n            // Jitter the first step per pixel, so the steps don't band.\n            dt *= hash3(pos.x * 1.7f, pos.y * 2.3f, float(s + 31 * k) + seed) + 0.02f;\n            first = false;\n          \}\n          dt = min(dt, tEnd - t + 1e-3f);\n          float tm = t + 0.5f * dt;\n          float3 p = cam + d * tm;\n          float dn = cloud(p, foot, false);\n          if (dn > 0.0f) \{\n            float sig = dn * sig0;\n            float ext = exp(-sig * dt);\n            float w = T * (1.0f - ext);\n            dep += w * tm;\n            if (output != 2) \{\n              float od = sunDepth(p, foot) * sig0;\n              // Multiple scattering octaves (Wrenninge).\n              float ms = 0.0f;\n              float oa = 1.0f;\n              float ob = 1.0f;\n              float oc = 1.0f;\n              for (int o = 0; o < 4; o++) \{\n                float ph = 0.75f * hg(forward * oc, cosT) + 0.25f * hg(-0.25f * oc, cosT);\n                ms += ob * exp(-od * oa) * ph;\n                oa *= 0.3f;\n                ob *= 0.6f;\n                oc *= 0.5f;\n              \}\n              // Powder: dark edges facing away from the sun.\n              float powder = 1.0f - 0.6f * exp(-sig * 160.0f);\n              float3 direct = sunColor * (ms * powder);\n              // Sky light from above, ground bounce from below.\n              float hn = clamp((altitude(p) - base) / thickness, 0.0f, 1.0f);\n              float th = min(thickness, 1500.0f) * 0.12f;\n              float up = exp(-sig * (1.0f - hn) * th);\n              float dnl = exp(-sig * hn * th) * 0.35f;\n              float3 amb = (skyColor * up + groundColor * dnl) * ambient;\n              float hz = hazeDistance > 0.0f ? exp(-tm / hazeDistance) : 1.0f;\n              col += w * (hz * (direct + amb) + (1.0f - hz) * hazeColor);\n              sunPart += w * hz * direct;\n            \}\n            T *= ext;\n          \}\n          t += dt;\n        \}\n      \}\n      float alpha = 1.0f - T;\n      if (output == 2) \{\n        float z = alpha > 1e-5f ? dep / alpha * zPer / sceneScale : 0.0f;\n        acc += float4(z, z, z, alpha);\n      \} else if (output == 1) \{\n        acc += float4(sunPart.x, sunPart.y, sunPart.z, alpha);\n      \} else \{\n        acc += float4(col.x, col.y, col.z, alpha);\n      \}\n    \}\n    dst() = acc / float(ns);\n  \}\n\};\n"
  rebuild ""
  EzCloudGen_output 2
  EzCloudGen_cam_row0 {{parent.cam_world_matrix.0} {parent.cam_world_matrix.1} {parent.cam_world_matrix.2}}
  EzCloudGen_cam_row1 {{parent.cam_world_matrix.4} {parent.cam_world_matrix.5} {parent.cam_world_matrix.6}}
