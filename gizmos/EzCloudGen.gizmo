  EzCloudGen_other_vol_center {{"parent.l2_box_found ? parent.l2_box_center_prev.x : parent.l2_vol_position.x(frame + (-1))"} {"parent.l2_box_found ? parent.l2_box_center_prev.y : parent.l2_vol_position.y(frame + (-1)) + parent.l2_vol_size.y / 2 / max(parent.scene_scale, 1e-6)"} {"parent.l2_box_found ? parent.l2_box_center_prev.z : parent.l2_vol_position.z(frame + (-1))"}}
  EzCloudGen_vol_axes {{parent.l2_box_found}}
  EzCloudGen_vol_axis_x {{parent.l2_box_axis_x.x} {parent.l2_box_axis_x.y} {parent.l2_box_axis_x.z}}
  EzCloudGen_vol_axis_y {{parent.l2_box_axis_y.x} {parent.l2_box_axis_y.y} {parent.l2_box_axis_y.z}}
  EzCloudGen_vol_axis_z {{parent.l2_box_axis_z.x} {parent.l2_box_axis_z.y} {parent.l2_box_axis_z.z}}
  EzCloudGen_depth_mode {{parent.depth_mode}}
  EzCloudGen_sky_depth {{"parent.sky_depth * 1000 / max(parent.scene_scale, 1e-6)"}}
  rebuild_finalise ""
  name L2_Bwd
  xpos 2880
  ypos 618
  disable {{"(!parent.l2_enable || (parent.view==4 && parent.variations_of!=1)) || !parent.motion_vectors || parent.preview"}}
 }
